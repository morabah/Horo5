    "trust_ribbon": {
      "type": "custom-liquid",
      "settings": {
        "custom_liquid": "<style>\n.horo-trust-ribbon {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 1.6rem 2.4rem;\n  padding-block: 1.2rem;\n  list-style: none;\n  margin: 0;\n  font-size: 1.3rem;\n  letter-spacing: 0.05rem;\n  text-transform: uppercase;\n  font-weight: 500;\n}\n.horo-trust-ribbon li {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  white-space: nowrap;\n}\n.horo-trust-ribbon svg {\n  inline-size: 1.8rem;\n  block-size: 1.8rem;\n  flex-shrink: 0;\n}\n@media screen and (max-width: 749px) {\n  .horo-trust-ribbon {\n    gap: 0.8rem 1.6rem;\n    font-size: 1.1rem;\n  }\n  .horo-trust-ribbon svg {\n    inline-size: 1.5rem;\n    block-size: 1.5rem;\n  }\n}\n</style>\n<ul class=\"horo-trust-ribbon\">\n  <li>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 19l7-7 3 3-7 7-3-3z\"/><path d=\"M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z\"/><path d=\"M2 2l7.586 7.586\"/><circle cx=\"11\" cy=\"11\" r=\"2\"/></svg>\n    {{ settings.horo_trust_badge_1 }}\n  </li>\n  <li>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect x=\"1\" y=\"3\" width=\"15\" height=\"13\"/><polygon points=\"16 8 20 8 23 11 23 16 16 16 16 8\"/><circle cx=\"5.5\" cy=\"18.5\" r=\"2.5\"/><circle cx=\"18.5\" cy=\"18.5\" r=\"2.5\"/></svg>\n    {{ settings.horo_trust_badge_2 }}\n  </li>\n  <li>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><line x1=\"12\" y1=\"1\" x2=\"12\" y2=\"23\"/><path d=\"M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6\"/></svg>\n    {{ settings.horo_trust_badge_3 }}\n  </li>\n  <li>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><polyline points=\"23 4 23 10 17 10\"/><polyline points=\"1 20 1 14 7 14\"/><path d=\"M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15\"/></svg>\n    {{ settings.horo_trust_badge_4 }}\n  </li>\n  <li>\n    <svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z\"/></svg>\n    {{ settings.horo_trust_badge_5 }}\n  </li>\n</ul>",
        "color_scheme": "scheme-2",
        "padding_top": 12,
