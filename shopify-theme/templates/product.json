{
  "sections": {
    "horo_product_data": {
      "type": "horo-product-data",
      "settings": {}
    },
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product_purchase_context": {
      "type": "product-purchase-context",
      "settings": {
        "show_default_trust_chips": true,
        "color_scheme": "scheme-1",
        "padding_top": 12,
        "padding_bottom": 16
      }
    },
    "product_story": {
      "type": "product-story",
      "settings": {
        "heading": "For the one who…",
        "heading_size": "h1",
        "description_label": "Full story",
        "story_description_open": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "horo_seen_on_you": {
      "type": "horo-seen-on-you",
      "settings": {
        "heading": "Seen on you",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_artist_card": {
      "type": "product-artist-card",
      "settings": {
        "heading": "Illustrated by",
        "heading_size": "h1",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_delivery_payment": {
      "type": "product-delivery-payment",
      "settings": {
        "heading": "Delivery & payment",
        "heading_size": "h1",
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "show_card_1": true,
        "card_1_icon": "cash",
        "card_1_title": "Cash on Delivery",
        "card_1_body": "Available when shown at checkout",
        "show_card_2": true,
        "card_2_icon": "bank",
        "card_2_title": "Bank Transfer / Instapay",
        "card_2_body": "Manual confirmation may be required",
        "show_card_3": true,
        "card_3_icon": "exchange",
        "card_3_title": "14-day exchange",
        "card_3_body": "See policy for details",
        "show_card_4": true,
        "card_4_icon": "delivery",
        "card_4_title": "Delivery",
        "card_4_body": "Depends on your area — confirm at checkout",
        "show_card_5": true,
        "card_5_icon": "support",
        "card_5_title": "WhatsApp support",
        "card_5_body": "Contact us for questions",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_size_guide": {
      "type": "product-size-guide",
      "settings": {
        "heading": "Size guide",
        "heading_size": "h2",
        "disclaimer": "Measurements may vary slightly depending on fabric and printing.",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_trust_strip": {
      "type": "product-trust-strip",
      "settings": {
        "color_scheme": "scheme-1",
        "show_badge_1": true,
        "badge_1_icon": "cotton",
        "badge_1_label": "Artist-made design",
        "show_badge_2": true,
        "badge_2_icon": "print",
        "badge_2_label": "Printed in Egypt",
        "show_badge_3": true,
        "badge_3_icon": "cash",
        "badge_3_label": "COD available",
        "show_badge_4": true,
        "badge_4_icon": "exchange",
        "badge_4_label": "14-day exchange",
        "show_badge_5": true,
        "badge_5_icon": "chat",
        "badge_5_label": "WhatsApp support",
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "product_proof_strip": {
      "type": "product-proof-strip",
      "settings": {
        "heading": "The details",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 28,
        "padding_bottom": 28
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More from this feeling",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "adapt",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "product_pair_with": {
      "type": "product-pair-with",
      "settings": {
        "heading": "Pairing",
        "include_current_product": false,
        "preselect_items": true,
        "redirect_to_cart": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "horo_cross_sell": {
      "type": "horo-cross-sell",
      "settings": {
        "heading": "You might also like",
        "subheading": "Pieces that pair well with this one",
        "heading_size": "h1",
        "intent": "related",
        "products_to_show": 4,
        "image_ratio": "adapt",
        "image_shape": "default",
        "show_secondary_image": false,
        "show_vendor": false,
        "show_rating": false,
        "enable_quick_add": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_details_accordions": {
      "type": "product-details-accordions",
      "settings": {
        "heading": "Product Details & Fit",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "horo_recently_viewed": {
      "type": "horo-recently-viewed",
      "settings": {
        "heading": "Recently viewed",
        "heading_size": "h2",
        "empty_text": "Products you view will appear here.",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "horo_breadcrumb": {
      "type": "horo-breadcrumb",
      "settings": {}
    },
    "horo_launch_countdown": {
      "type": "horo-launch-countdown",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "horo_trust_ribbon": {
      "type": "horo-trust-ribbon",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      },
      "blocks": {
        "badge_1": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "artist",
            "label": "Artist-made",
            "subtext": ""
          }
        },
        "badge_2": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "print",
            "label": "Printed in Egypt",
            "subtext": ""
          }
        },
        "badge_3": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "exchange",
            "label": "14-day exchange",
            "subtext": ""
          }
        }
      },
      "block_order": [
        "badge_1",
        "badge_2",
        "badge_3"
      ]
    },
    "horo_share_your_fit": {
      "type": "horo-share-your-fit",
      "settings": {
        "heading": "Share your fit",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "horo_breadcrumb",
    "horo_launch_countdown",
    "horo_product_data",
    "main",
    "product_purchase_context",
    "product_trust_strip",
    "product_proof_strip",
    "product_story",
    "product_details_accordions",
    "product_size_guide",
    "product_artist_card",
    "horo_seen_on_you",
    "product_delivery_payment",
    "product_pair_with",
    "horo_cross_sell",
    "horo_recently_viewed",
    "horo_share_your_fit"
  ]
}
