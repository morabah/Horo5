{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title"
        },
        "caption": {
          "type": "text",
          "settings": {
            "text": "{{ product.metafields.descriptors.subtitle.value }}",
            "text_style": "subtitle"
          }
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "collapsible-row-0": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Materials",
            "icon": "leather",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-1": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Returns",
            "icon": "truck",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-2": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Dimensions",
            "icon": "ruler",
            "content": "",
            "page": ""
          }
        },
        "collapsible-row-3": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care Instructions",
            "icon": "heart",
            "content": "",
            "page": ""
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "caption",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "collapsible-row-0",
        "collapsible-row-1",
        "collapsible-row-2",
        "collapsible-row-3",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "stacked",
        "media_size": "large",
        "constrain_to_viewport": true,
        "mobile_thumbnails": "hide",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "product_story": {
      "type": "product-story",
      "settings": {
        "heading": "The story behind this piece",
        "heading_size": "h1",
        "description_label": "Full story",
        "story_description_open": false,
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_artist_card": {
      "type": "product-artist-card",
      "settings": {
        "heading": "About the artist",
        "heading_size": "h1",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_delivery_payment": {
      "type": "product-delivery-payment",
      "settings": {
        "heading": "Delivery & payment",
        "heading_size": "h1",
        "columns_desktop": 3,
        "color_scheme": "scheme-1",
        "show_card_1": true,
        "card_1_icon": "cash",
        "card_1_title": "Cash on Delivery",
        "card_1_body": "Available at checkout",
        "show_card_2": true,
        "card_2_icon": "bank",
        "card_2_title": "Bank Transfer / Instapay",
        "card_2_body": "Manual confirmation may be required",
        "show_card_3": true,
        "card_3_icon": "exchange",
        "card_3_title": "14-Day Exchange",
        "card_3_body": "See policy for details",
        "show_card_4": true,
        "card_4_icon": "delivery",
        "card_4_title": "Delivery",
        "card_4_body": "Delivery window depends on your area",
        "show_card_5": false,
        "card_5_icon": "support",
        "card_5_title": "WhatsApp Support",
        "card_5_body": "Contact us for questions",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "horo_delivery_estimate": {
      "type": "horo-delivery-estimate",
      "settings": {
        "show_delivery_estimate": true,
        "heading": "Estimated delivery",
        "standard_min_days": 3,
        "standard_max_days": 7,
        "express_min_days": 2,
        "express_max_days": 4,
        "text": "Delivery time depends on your area. You will confirm available options at checkout.",
        "show_exact_date_range": false,
        "color_scheme": "scheme-1",
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "product_size_guide": {
      "type": "product-size-guide",
      "settings": {
        "heading": "Size guide",
        "heading_size": "h1",
        "disclaimer": "Measurements may vary slightly depending on fabric and printing.",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_gift_wrap_upsell": {
      "type": "product-gift-wrap-upsell",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "product_trust_strip": {
      "type": "product-trust-strip",
      "settings": {
        "color_scheme": "scheme-1",
        "show_badge_1": true,
        "badge_1_icon": "cotton",
        "badge_1_label": "Premium cotton",
        "show_badge_2": true,
        "badge_2_icon": "print",
        "badge_2_label": "Printed in Egypt",
        "show_badge_3": true,
        "badge_3_icon": "cash",
        "badge_3_label": "Cash on Delivery available at checkout",
        "show_badge_4": true,
        "badge_4_icon": "exchange",
        "badge_4_label": "14-day exchange \u2014 see policy",
        "show_badge_5": true,
        "badge_5_icon": "chat",
        "badge_5_label": "WhatsApp support",
        "padding_top": 24,
        "padding_bottom": 24
      }
    },
    "image-with-text": {
      "type": "image-with-text",
      "blocks": {
        "image-with-text-0": {
          "type": "heading",
          "settings": {
            "heading": "Made to say something",
            "heading_size": "h1"
          }
        },
        "image-with-text-1": {
          "type": "text",
          "settings": {
            "text": "<p>HORO pieces begin with a feeling, then become artwork you can wear.</p>",
            "text_style": "body"
          }
        }
      },
      "block_order": [
        "image-with-text-0",
        "image-with-text-1"
      ],
      "settings": {
        "height": "small",
        "desktop_image_width": "medium",
        "layout": "text_first",
        "desktop_content_position": "top",
        "desktop_content_alignment": "left",
        "content_layout": "no-overlap",
        "color_scheme": "scheme-2",
        "mobile_content_alignment": "left",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "multicolumn": {
      "type": "multicolumn",
      "blocks": {
        "column-0": {
          "type": "column",
          "settings": {
            "title": "Printed locally",
            "text": "<p>Produced in Egypt with careful print handling.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column-1": {
          "type": "column",
          "settings": {
            "title": "Size support",
            "text": "<p>Check the size guide before ordering; exchange terms apply.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
        "column-0",
        "column-1"
      ],
      "settings": {
        "title": "",
        "heading_size": "h1",
        "image_width": "full",
        "image_ratio": "adapt",
        "columns_desktop": 2,
        "column_alignment": "left",
        "background_style": "none",
        "button_label": "",
        "button_link": "",
        "swipe_on_mobile": false,
        "color_scheme": "scheme-1",
        "columns_mobile": "1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "More pieces that fit",
        "heading_size": "h2",
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    },
    "product_purchase_context": {
      "type": "product-purchase-context",
      "settings": {
        "color_scheme": "scheme-1",
        "show_default_trust_chips": true,
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
    "product_details_accordions": {
      "type": "product-details-accordions",
      "settings": {
        "heading": "Product details",
        "heading_size": "h2",
        "color_scheme": "scheme-1",
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
  },
  "order": [
    "main",
    "product_purchase_context",
    "product_story",
    "product_artist_card",
    "product_details_accordions",
    "product_delivery_payment",
    "horo_delivery_estimate",
    "product_size_guide",
    "product_gift_wrap_upsell",
    "product_trust_strip",
    "image-with-text",
    "multicolumn",
    "related-products"
  ]
}
