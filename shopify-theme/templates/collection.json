{
  "sections": {
    "horo_header": {
      "type": "collection-horo-header",
      "settings": {
        "show_collection_description": true,
        "color_scheme": "scheme-1"
      }
    },
    "subfeeling_nav": {
      "type": "collection-subfeeling-nav",
      "settings": {
        "color_scheme": "scheme-1",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "editorial_proof": {
      "type": "collection-editorial-proof",
      "settings": {
        "heading": "Designed around this feeling",
        "text": "This collection gathers pieces connected by the same mood, sign, or attitude.",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 20
      }
    },
    "product-grid": {
      "type": "main-collection-product-grid",
      "settings": {
        "products_per_page": 16,
        "columns_desktop": 4,
        "image_ratio": "adapt",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "enable_filtering": true,
        "enable_sorting": true,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 36
      }
    },
    "related_routes": {
      "type": "collection-related-routes",
      "blocks": {
        "route_1": {
          "type": "route",
          "settings": {
            "title": "Shop all feelings",
            "text": "Browse every mood and sign",
            "link": "/pages/feelings"
          }
        },
        "route_2": {
          "type": "route",
          "settings": {
            "title": "Shop by occasion",
            "text": "Find the moment you need",
            "link": "/pages/occasions"
          }
        },
        "route_3": {
          "type": "route",
          "settings": {
            "title": "Shop all products",
            "text": "See every design",
            "link": "/collections/all"
          }
        }
      },
      "block_order": [
        "route_1",
        "route_2",
        "route_3"
      ],
      "settings": {
        "heading": "More ways to shop",
        "color_scheme": "scheme-1",
        "padding_top": 20,
        "padding_bottom": 20
      }
    }
  },
  "order": [
    "horo_header",
    "subfeeling_nav",
    "editorial_proof",
    "product-grid",
    "related_routes"
  ]
}
