{{ 'component-product-details-accordions.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign materials = product.metafields.custom.materials.value
  assign design_story = product.metafields.custom.story_description.value | default: product.metafields.custom.story.value | default: product.metafields.custom.design_story.value
  assign care_instructions = product.metafields.custom.care_instructions.value
  assign dimensions_note = product.metafields.custom.dimensions_note.value
  assign shipping_returns_note = product.metafields.custom.shipping_returns_note.value
  assign fit_note = product.metafields.custom.fit_note.value | default: product.metafields.custom.fit_label.value | default: product.metafields.custom.size_fit_note.value

  assign has_materials = false
  if materials != blank
    assign has_materials = true
  endif

  assign has_design_story = false
  if design_story != blank
    assign has_design_story = true
  endif

  assign has_care = false
  if care_instructions != blank
    assign has_care = true
  endif

  assign has_dimensions = false
  if dimensions_note != blank
    assign has_dimensions = true
  endif

  assign has_shipping = false
  if shipping_returns_note != blank
    assign has_shipping = true
  endif

  assign has_fit = false
  if fit_note != blank
    assign has_fit = true
  endif

  assign accordion_count = 0
  if has_materials or has_design_story or has_care or has_dimensions or has_shipping or has_fit
    assign accordion_count = accordion_count | plus: 1
  endif

  assign has_content = false
  if has_materials or has_design_story or has_care or has_dimensions or has_shipping or has_fit
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="DetailsAccordions-{{ section.id }}"
    class="horo-section product-details-accordions color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if has_content -%}
        <div class="product-details-accordions__wrapper">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-details-accordions__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          <div class="product-details-accordions__list">
            {%- if has_fit -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>{{ 'horo.pdp.accordionProductDetails' | t }}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ fit_note }}
                </div>
              </details>
            {%- endif -%}

            {%- if has_design_story -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>{{ 'horo.pdp.accordionDesignStory' | t }}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ design_story }}
                </div>
              </details>
            {%- endif -%}

            {%- if has_materials -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>{{ 'horo.pdp.accordion_materials' | t | default: 'Materials & print' }}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ materials }}
                </div>
              </details>
            {%- endif -%}

            {%- if has_care -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>{{ 'horo.pdp.accordion_care' | t | default: 'Care instructions' }}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ care_instructions }}
                </div>
              </details>
            {%- endif -%}

            {%- if has_shipping -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>{{ 'horo.pdp.accordionShipping' | t }}</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ shipping_returns_note }}
                </div>
              </details>
            {%- endif -%}

            {%- if has_dimensions -%}
              <details class="product-details-accordions__item">
                <summary class="product-details-accordions__summary">
                  <span>Dimensions & weight</span>
                  <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </summary>
                <div class="product-details-accordions__content rte">
                  {{ dimensions_note }}
                </div>
              </details>
            {%- endif -%}
          </div>
        </div>
      {%- elsif request.design_mode -%}
        <div class="product-details-accordions__placeholder">
          <p>
            Add product metafields to populate accordions:<br>
            <code>custom.materials</code>, <code>custom.design_story</code>, <code>custom.care_instructions</code>,
            <code>custom.dimensions_note</code>, <code>custom.shipping_returns_note</code>, <code>custom.fit_note</code>,
            <code>custom.fit_label</code>, <code>custom.size_fit_note</code>
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO PDP Accordions",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Product details",
      "info": "Optional heading above the accordion list."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Product Details Accordions"
    }
  ]
}
{% endschema %}
