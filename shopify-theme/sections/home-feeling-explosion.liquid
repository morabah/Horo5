{{ 'component-home-feeling-explosion.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FeelingExplosion-{{ section.id }}"
  class="horo-section home-feeling-explosion color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  aria-labelledby="home-feeling-explosion-title"
>
  <div class="page-width">
    <div class="home-feeling-explosion__content">
      {%- if section.settings.show_accent_line -%}
        <div class="home-feeling-explosion__accent-line" aria-hidden="true" data-reveal></div>
      {%- endif -%}

      {%- if section.settings.eyebrow != blank -%}
        <p class="home-feeling-explosion__eyebrow" data-reveal="stagger-1">
          {{ section.settings.eyebrow | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2
          id="home-feeling-explosion-title"
          class="home-feeling-explosion__heading {{ section.settings.heading_size }}"
          data-reveal="stagger-2"
        >
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <p class="home-feeling-explosion__body" data-reveal="stagger-3">
          {{ section.settings.body | escape }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="home-feeling-explosion__actions" data-reveal="stagger-4">
          <a
            {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
            class="home-feeling-explosion__cta button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
            {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
          >
            {{ section.settings.button_label | escape }}
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HORO Feeling Explosion",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_accent_line",
      "label": "Show decorative accent line",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The feeling"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "You know that feeling when nothing says what you're thinking?"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "HORO is for when you're ready to wear the thought out loud."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore Feelings"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Use secondary button style",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 128
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 128
    }
  ],
  "presets": [
    {
      "name": "HORO Feeling Explosion"
    }
  ]
}
{% endschema %}
