{{ 'component-product-trust-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for i in (1..5)
    assign show_key = 'show_badge_' | append: i
    if section.settings[show_key] == true
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="TrustStrip-{{ section.id }}"
    class="horo-section trust-strip color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if visible_count > 0 -%}
        <ul class="trust-strip__list" role="list">
          {%- for i in (1..5) -%}
            {%- liquid
              assign show_key = 'show_badge_' | append: i
              assign label_key = 'badge_' | append: i | append: '_label'
              assign icon_key = 'badge_' | append: i | append: '_icon'
            -%}
            {%- if section.settings[show_key] == true -%}
              <li class="trust-strip__item" role="listitem">
                <span class="trust-strip__icon" aria-hidden="true">
                  {%- case section.settings[icon_key] -%}
                    {%- when 'cotton' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 22h20"/><path d="M6 22V8l6-4 6 4v14"/><path d="M10 22v-6h4v6"/><path d="M14 8a2 2 0 0 1-4 0"/></svg>
                    {%- when 'print' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                    {%- when 'cash' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    {%- when 'exchange' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M7 23l-4-4 4-4"/><path d="M21 5H10a4 4 0 0 0-4 4v1"/><path d="M3 19h11a4 4 0 0 0 4-4v-1"/></svg>
                    {%- when 'chat' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  {%- endcase -%}
                </span>
                <span class="trust-strip__label">{{ section.settings[label_key] | escape }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <div class="trust-strip__placeholder">
          <p>Enable at least one trust badge to display the product trust strip.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Product Trust Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
