    {
      "type": "header",
      "content": "Badge 1"
    },
    {
      "type": "checkbox",
      "id": "show_badge_1",
      "default": true,
      "label": "Show badge 1"
    },
    {
      "type": "select",
      "id": "badge_1_icon",
      "options": [
        { "value": "cotton", "label": "Cotton" },
        { "value": "print", "label": "Print" },
        { "value": "cash", "label": "Cash" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "chat", "label": "Chat" }
      ],
      "default": "cotton",
      "label": "Badge 1 icon"
    },
    {
      "type": "text",
      "id": "badge_1_label",
      "default": "Premium cotton",
      "label": "Badge 1 label"
    },
    {
      "type": "header",
