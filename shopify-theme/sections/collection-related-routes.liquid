{{ 'component-collection-related-routes.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.title != blank and block.settings.link != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if visible_count > 0 or request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="collection-related-routes">
        {%- if section.settings.heading != blank -%}
          <h2 class="collection-related-routes__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        {%- if visible_count > 0 -%}
          <ul class="collection-related-routes__grid" role="list">
            {%- for block in section.blocks -%}
              {%- if block.settings.title != blank and block.settings.link != blank -%}
                <li class="collection-related-routes__card" role="listitem" {{ block.shopify_attributes }}>
                  <a href="{{ block.settings.link }}" class="collection-related-routes__link">
                    {%- if block.settings.title != blank -%}
                      <span class="collection-related-routes__title">{{ block.settings.title | escape }}</span>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <span class="collection-related-routes__text">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                    <span class="collection-related-routes__arrow" aria-hidden="true">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path d="M6 3L11 8L6 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </span>
                  </a>
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- elsif request.design_mode -%}
          <div class="collection-related-routes__placeholder">
            <p>Add at least one route block with a title and link to display navigation cards.</p>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection related routes",
  "tag": "section",
  "class": "section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "More ways to shop",
      "label": "Heading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "blocks": [
    {
      "type": "route",
      "name": "Route",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "default": "Shop all feelings",
          "label": "Title"
        },
        {
          "type": "text",
          "id": "text",
          "default": "",
          "label": "Short description"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection related routes",
      "blocks": {
        "route_1": {
          "type": "route",
          "settings": {
            "title": "Shop all feelings",
            "text": "Browse every mood and sign",
            "link": "/pages/feelings"
          }
        },
        "route_2": {
          "type": "route",
          "settings": {
            "title": "Shop gifts",
            "text": "Meaningful gift ideas",
            "link": "/pages/gifts"
          }
        },
        "route_3": {
          "type": "route",
          "settings": {
            "title": "Shop all products",
            "text": "See every design",
            "link": "/collections/all"
          }
        }
      },
      "block_order": [
        "route_1",
        "route_2",
        "route_3"
      ]
    }
  ]
}
{% endschema %}
