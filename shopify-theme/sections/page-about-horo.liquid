{{ 'component-horo-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.show == true and block.settings.text != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    <h1 class="main-page-title page-title {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ section.settings.heading | escape }}
    </h1>

    {%- if visible_count > 0 -%}
      <div class="horo-page__content">
        {%- for block in section.blocks -%}
          {%- if block.settings.show == true and block.settings.text != blank -%}
            <div class="horo-page__block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="horo-page__block-title">{{ block.settings.title | escape }}</h2>
              {%- endif -%}
              <div class="rte">
                {{ block.settings.text }}
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="horo-page__placeholder">
        <p>Enable at least one content block to display the About page section.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORO About Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "About HORO",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "content_block",
      "name": "Content block",
      "settings": [
        {
          "type": "checkbox",
          "id": "show",
          "default": true,
          "label": "Show block"
        },
        {
          "type": "text",
          "id": "title",
          "default": "",
          "label": "Block title"
        },
        {
          "type": "richtext",
          "id": "text",
          "default": "<p>HORO creates wearable art based on feelings, moods, moments, gifts, and self-expression. Every piece is designed to mean something — to the person wearing it and the person receiving it. We work with artists to turn emotional territory into something tangible. Based in Egypt, printed locally, shipped with care.</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO About Page",
      "blocks": {
        "content-0": {
          "type": "content_block",
          "settings": {
            "show": true,
            "title": "",
            "text": "<p>HORO creates wearable art based on feelings, moods, moments, gifts, and self-expression. Every piece is designed to mean something — to the person wearing it and the person receiving it. We work with artists to turn emotional territory into something tangible. Based in Egypt, printed locally, shipped with care.</p>"
          }
        }
      },
      "block_order": [
        "content-0"
      ]
    }
  ]
}
{% endschema %}
