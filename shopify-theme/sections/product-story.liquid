{{ 'component-product-story.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign story = product.metafields.custom.story.value
  assign story_description = product.metafields.custom.story_description.value
  assign has_story = false

  if story != blank and story != empty
    assign has_story = true
  endif

  if story_description != blank and story_description != empty
    assign has_story = true
  endif
-%}

{%- if has_story or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="ProductStory-{{ section.id }}"
    class="horo-section product-story color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if has_story -%}
        <div class="product-story__wrapper">
          {%- if section.settings.heading != blank -%}
            <h2 class="product-story__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          {%- if story != blank and story != empty -%}
            <div class="product-story__body rte">
              {{ story }}
            </div>
          {%- endif -%}

          {%- if story_description != blank and story_description != empty -%}
            <details class="product-story__details{% if section.settings.story_description_open %} product-story__details--open{% endif %}">
              <summary class="product-story__summary">
                <span class="product-story__summary-label">
                  {%- if section.settings.description_label != blank -%}
                    {{ section.settings.description_label | escape }}
                  {%- else -%}
                    Full story
                  {%- endif -%}
                </span>
                <svg aria-hidden="true" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M1.5 4.5L6 9L10.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </summary>
              <div class="product-story__description rte">
                {{ story_description }}
              </div>
            </details>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="product-story__placeholder">
          <p>Add <code>custom.story</code> and/or <code>custom.story_description</code> product metafields to populate this section.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Product Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The story behind this piece"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "description_label",
      "label": "Description toggle label",
      "default": "Full story",
      "info": "Label shown on the collapsible toggle for the longer story description"
    },
    {
      "type": "checkbox",
      "id": "story_description_open",
      "default": false,
      "label": "Open description by default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Product Story"
    }
  ]
}
{% endschema %}
