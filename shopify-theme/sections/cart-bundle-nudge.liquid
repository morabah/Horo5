{{ 'component-cart-bundle-nudge.css' | asset_url | stylesheet_tag }}
{%- if section.settings.use_incentives_api -%}
  <script src="{{ 'horo-incentives.js' | asset_url }}" defer></script>
{%- endif -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign gift_wrap_product = settings.horo_gift_wrap_product
  assign eligible_quantity = 0
  assign gift_wrap_in_cart = false
  for item in cart.items
    assign is_gift_wrap = false
    if gift_wrap_product != blank and item.product.handle == gift_wrap_product.handle
      assign is_gift_wrap = true
      assign gift_wrap_in_cart = true
    endif
    unless is_gift_wrap
      if section.settings.eligible_collection != blank
        if item.product.collections contains section.settings.eligible_collection
          assign eligible_quantity = eligible_quantity | plus: item.quantity
        endif
      else
        assign eligible_quantity = eligible_quantity | plus: item.quantity
      endif
    endunless
  endfor
  assign remaining_items = section.settings.required_quantity | minus: eligible_quantity
  assign show_bundle_nudge = false
  if section.settings.enable_bundle_message and eligible_quantity >= 2 and remaining_items > 0 and gift_wrap_in_cart == false
    assign show_bundle_nudge = true
  endif
-%}

{%- if show_bundle_nudge -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div
        class="cart-bundle-nudge"
        {%- if section.settings.use_incentives_api -%}
          data-horo-bundle-progress
          data-use-incentives-api="true"
          data-incentives-api-url="{{ section.settings.incentives_api_url | default: '/apps/horo-incentives' }}"
          data-api-timeout-ms="{{ section.settings.api_timeout_ms | default: 2500 }}"
          data-eligible-count="{{ eligible_quantity }}"
          data-heading-before="{{ section.settings.heading_before | escape }}"
          data-heading-after="{{ section.settings.heading_after | escape }}"
        {%- endif -%}
      >
        {%- if remaining_items > 0 -%}
          {%- if section.settings.heading_before != blank -%}
            <h2 class="cart-bundle-nudge__heading" data-bundle-heading>{{ section.settings.heading_before | replace: '[count]', remaining_items | escape }}</h2>
          {%- endif -%}
        {%- else -%}
          {%- if section.settings.heading_after != blank -%}
            <h2 class="cart-bundle-nudge__heading" data-bundle-heading>{{ section.settings.heading_after | escape }}</h2>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.note != blank -%}
          <p class="cart-bundle-nudge__text" data-bundle-note>{{ section.settings.note | escape }}</p>
        {%- endif -%}

        {%- if section.settings.discount_code_text != blank -%}
          <p class="cart-bundle-nudge__code" data-bundle-code>
            <span class="cart-bundle-nudge__code-label">{{ 'horo.incentives.use_code' | t | escape }}</span>
            <span class="cart-bundle-nudge__code-value" data-bundle-code-value>{{ section.settings.discount_code_text | escape }}</span>
          </p>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="cart-bundle-nudge cart-bundle-nudge--placeholder">
        <p>Enable the bundle message in section settings to display this nudge.</p>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Cart bundle nudge",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_bundle_message",
      "default": false,
      "label": "Enable bundle message",
      "info": "Only enable when a real Shopify discount is configured in Admin."
    },
    {
      "type": "header",
      "content": "Bundle settings"
    },
    {
      "type": "range",
      "id": "required_quantity",
      "min": 2,
      "max": 10,
      "step": 1,
      "label": "Required quantity",
      "default": 3,
      "info": "Number of eligible items to reach the bundle offer."
    },
    {
      "type": "range",
      "id": "discount_egp",
      "min": 0,
      "max": 1000,
      "step": 50,
      "unit": "EGP",
      "label": "Discount amount (EGP)",
      "default": 100,
      "info": "Display only. Must match a real Shopify discount."
    },
    {
      "type": "collection",
      "id": "eligible_collection",
      "label": "Eligible collection",
      "info": "Leave blank to count all non-gift-wrap cart items."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_before",
      "default": "Add [count] more to unlock the bundle offer",
      "label": "Heading before threshold",
      "info": "Use [count] as placeholder for remaining items."
    },
    {
      "type": "text",
      "id": "heading_after",
      "default": "Your cart may qualify for the bundle offer",
      "label": "Heading at/after threshold"
    },
    {
      "type": "textarea",
      "id": "note",
      "default": "Final discount is confirmed at checkout.",
      "label": "Note text"
    },
    {
      "type": "text",
      "id": "discount_code_text",
      "label": "Discount code text",
      "info": "Leave blank to hide. Only fill if a discount code exists in Shopify Admin."
    },
    {
      "type": "header",
      "content": "API sync (optional)"
    },
    {
      "type": "checkbox",
      "id": "use_incentives_api",
      "default": false,
      "label": "Use incentives API",
      "info": "Fetch bundle config from a public app proxy. Falls back to manual settings if API fails."
    },
    {
      "type": "text",
      "id": "incentives_api_url",
      "default": "/apps/horo-incentives",
      "label": "Incentives API URL"
    },
    {
      "type": "range",
      "id": "api_timeout_ms",
      "min": 1000,
      "max": 5000,
      "step": 500,
      "unit": "ms",
      "label": "API timeout",
      "default": 2500
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Cart bundle nudge"
    }
  ]
}
{% endschema %}
