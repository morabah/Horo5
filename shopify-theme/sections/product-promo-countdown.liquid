{{ 'component-product-promo-countdown.css' | asset_url | stylesheet_tag }}
<script src="{{ 'horo-promo-countdown.js' | asset_url }}" defer></script>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign promo_active = product.metafields.custom.promo_active.value
  assign promo_starts_at = product.metafields.custom.promo_starts_at.value
  assign promo_ends_at = product.metafields.custom.promo_ends_at.value
  assign promo_label = product.metafields.custom.promo_label.value
  assign promo_label_ar = product.metafields.custom.promo_label_ar.value
  assign promo_savings_egp = product.metafields.custom.promo_savings_egp.value
  assign promo_show_countdown = true
  if product.metafields.custom.promo_show_countdown != blank
    assign promo_show_countdown = product.metafields.custom.promo_show_countdown.value
  endif

  assign now_ts = 'now' | date: '%s' | plus: 0
  assign starts_ts = promo_starts_at | date: '%s' | plus: 0
  assign ends_ts = promo_ends_at | date: '%s' | plus: 0
  assign has_started = true
  if promo_starts_at != blank and starts_ts > now_ts
    assign has_started = false
  endif
  assign is_future = false
  if ends_ts > now_ts
    assign is_future = true
  endif
-%}

{%- if promo_active and promo_show_countdown and has_started and promo_ends_at != blank and is_future -%}
  {%- assign fallback_promo_label = 'horo.incentives.limited_offer' | t -%}
  {%- assign promo_display_label = promo_label | default: fallback_promo_label -%}
  {%- if request.locale.iso_code == 'ar' and promo_label_ar != blank -%}
    {%- assign promo_display_label = promo_label_ar -%}
  {%- endif -%}
  {%- assign promo_savings_money = promo_savings_egp | times: 100 | money -%}

  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div
        class="product-promo-countdown"
        data-promo-countdown
        data-promo-ends-at="{{ promo_ends_at | date: '%Y-%m-%dT%H:%M:%S' }}"
        data-locale="{{ request.locale.iso_code }}"
        aria-live="polite"
      >
        <span class="product-promo-countdown__badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{- promo_display_label | escape -}}
        </span>
        <div class="product-promo-countdown__body">
          <p class="product-promo-countdown__label">
            {{- 'horo.incentives.ends_in' | t -}}
          </p>
          <p class="product-promo-countdown__display" data-promo-display>
            --:--
          </p>
          {%- if promo_savings_egp and promo_savings_egp > 0 -%}
            <p class="product-promo-countdown__savings">
              {{- 'horo.incentives.save_amount' | t: amount: promo_savings_money -}}
            </p>
          {%- endif -%}
        </div>
        <p class="product-promo-countdown__ended" data-promo-ended hidden>
          {{- 'horo.incentives.offer_ended' | t -}}
        </p>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <div class="product-promo-countdown" style="opacity:0.6;">
        <span class="product-promo-countdown__badge">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{ 'horo.incentives.limited_offer' | t }}
        </span>
        <div class="product-promo-countdown__body">
          <p class="product-promo-countdown__label">{{ 'horo.incentives.ends_in' | t }}</p>
          <p class="product-promo-countdown__display">2d 14:30</p>
        </div>
      </div>
      <p style="font-size:1.2rem;opacity:0.55;margin-top:0.6rem;">Set <code>custom.promo_active</code> and <code>custom.promo_ends_at</code> product metafields to display this countdown.</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Product promo countdown",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Displays a countdown when the product has custom.promo_active=true and a future custom.promo_ends_at metafield. Hide this section if you do not use timed promos."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "Product promo countdown"
    }
  ]
}
{% endschema %}
