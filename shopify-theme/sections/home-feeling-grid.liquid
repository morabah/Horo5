{%- comment -%}
Legacy full taxonomy kept for future restoration:
Lifestyle / Zodiac / Mood / Dream / Art.

Current launch taxonomy is intentionally shallow:
Founding Drop / Zodiac / Mood / Lifestyle.
User should reach product in 1–2 clicks.
{%- endcomment -%}
{%- liquid
  assign all_feelings = shop.metaobjects.feeling.values
  assign feeling_count = 0
  assign feeling_limit = section.settings.feeling_limit | default: 5

  for feeling in all_feelings
    if feeling.active != false
      assign feeling_count = feeling_count | plus: 1
    endif
  endfor
-%}

<section
  id="shop-by-meaning"
  class="home-section home-section--bordered home-section--panel section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  aria-labelledby="home-feeling-title-{{ section.id }}"
>
  <div class="home-page__inner">
    <div class="home-section-header home-section-header--feelings">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-feeling-title-{{ section.id }}" class="home-section-title home-section-title--lg">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="home-section-subheading">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>
      {%- if section.settings.feelings_link_label != blank -%}
        <a href="{{ section.settings.feelings_link | default: '/pages/feelings' }}" class="home-section-link home-feeling-grid__all-link">
          {{ section.settings.feelings_link_label | escape }}
          <span aria-hidden="true"> →</span>
        </a>
      {%- endif -%}
    </div>

    {%- if feeling_count > 0 and section.settings.layout_style == 'pastel' -%}
      {% render 'horo-home-feeling-tiles', feeling_limit: feeling_limit %}
      {%- if section.settings.feelings_link_label != blank -%}
        <p class="home-feeling-mobile-cta">
          <a href="{{ section.settings.feelings_link | default: '/pages/feelings' }}" class="home-section-link">
            {{ section.settings.feelings_link_label | escape }}
            <span aria-hidden="true"> →</span>
          </a>
        </p>
      {%- endif -%}
    {%- elsif feeling_count > 0 -%}
      {{ 'component-home-feeling-grid.css' | asset_url | stylesheet_tag }}
      <ul class="home-feeling-grid__list home-feeling-grid__list--{{ section.settings.columns_desktop }}-col-desktop" role="list">
        {%- for feeling in all_feelings -%}
          {%- if feeling.active != false -%}
            {%- render 'feeling-card', card: feeling -%}
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- else -%}
      {% render 'horo-home-feeling-tiles-fallback', feeling_limit: feeling_limit %}
      {%- if section.settings.feelings_link_label != blank -%}
        <p class="home-feeling-mobile-cta">
          <a href="{{ section.settings.feelings_link | default: '/pages/feelings' }}" class="home-section-link">
            {{ section.settings.feelings_link_label | escape }}
            <span aria-hidden="true"> →</span>
          </a>
        </p>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "HORO Feeling Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout",
      "options": [
        { "value": "pastel", "label": "Pastel tiles (web homepage)" },
        { "value": "photo", "label": "Photo cards" }
      ],
      "default": "pastel"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "START WITH YOUR RHYTHM"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by meaning"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Choose the story first. Then pick the design."
    },
    {
      "type": "text",
      "id": "feelings_link_label",
      "label": "See all link label",
      "default": "See all feelings"
    },
    {
      "type": "url",
      "id": "feelings_link",
      "label": "See all link URL"
    },
    {
      "type": "range",
      "id": "feeling_limit",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "Maximum feelings (pastel)"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Desktop columns (photo layout)"
    }
  ],
  "presets": [
    {
      "name": "HORO Feeling Grid"
    }
  ]
}
{% endschema %}
