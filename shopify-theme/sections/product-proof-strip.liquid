{{ 'component-product-proof-strip.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign proof_tags = 'proof_fabric,proof_print,proof_wash,lifestyle,flat_lay' | split: ','
  assign proof_images = ''
  assign proof_count = 0

  for media in product.media
    assign alt_lower = media.alt | downcase
    for tag in proof_tags
      if alt_lower contains tag
        assign proof_count = proof_count | plus: 1
        assign tag_label = tag | replace: '_', ' ' | capitalize
        assign proof_images = proof_images | append: media.id | append: ':' | append: tag_label | append: ','
        break
      endif
    endfor
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if proof_count > 0 -%}
  <div
    id="ProofStrip-{{ section.id }}"
    class="horo-section product-proof-strip color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="product-proof-strip__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      <ul class="product-proof-strip__list" role="list">
        {%- assign proof_list = proof_images | split: ',' -%}
        {%- for proof_item in proof_list -%}
          {%- assign parts = proof_item | split: ':' -%}
          {%- assign media_id = parts[0] | plus: 0 -%}
          {%- assign label = parts[1] -%}
          {%- for media in product.media -%}
            {%- if media.id == media_id -%}
              <li class="product-proof-strip__item" role="listitem">
                <div class="product-proof-strip__media">
                  {{
                    media
                    | image_url: width: 600
                    | image_tag:
                      loading: 'lazy',
                      widths: '200, 400, 600',
                      sizes: '(min-width: 750px) 200px, 33vw',
                      class: 'product-proof-strip__image'
                  }}
                </div>
                {%- if label != blank -%}
                  <span class="product-proof-strip__label">{{ label | escape }}</span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </ul>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="product-proof-strip__placeholder page-width section-{{ section.id }}-padding">
    <p>
      No proof-tagged images found. Add alt text containing one of these tags to product media:
      <code>proof_fabric</code>, <code>proof_print</code>, <code>proof_wash</code>, <code>lifestyle</code>, <code>flat_lay</code>.
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Product Proof Strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The details"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Product Proof Strip"
    }
  ]
}
{% endschema %}
