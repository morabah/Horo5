{{ 'component-page-drop.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign drop = page.metafields.custom.drop.value
  if drop == blank and section.settings.fallback_drop != blank
    assign drop = section.settings.fallback_drop
  endif

  assign has_drop = false
  if drop != blank and drop.name != blank
    assign has_drop = true
  endif

  assign hero_image = drop.hero_image
  assign status = drop.status | default: 'coming_soon'
  assign launch_at = drop.launch_at
  assign end_at = drop.end_at
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if has_drop or request.design_mode -%}
  <div
    id="PageDrop-{{ section.id }}"
    class="horo-section page-drop color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="page-width">
      {%- if has_drop -%}
        {%- if hero_image != blank -%}
          <div class="page-drop__media">
            {{
              hero_image
              | image_url: width: 1920
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '375, 550, 750, 1100, 1500, 1920',
                sizes: '100vw',
                alt: drop.name,
                class: 'page-drop__image'
            }}
          </div>
        {%- endif -%}

        <div class="page-drop__content">
          <div class="page-drop__badge">
            {%- case status -%}
              {%- when 'live' -%}
                <span class="page-drop__status page-drop__status--live">Live now</span>
              {%- when 'ended' -%}
                <span class="page-drop__status page-drop__status--ended">Ended</span>
              {%- else -%}
                <span class="page-drop__status page-drop__status--soon">Coming soon</span>
            {%- endcase -%}
          </div>

          <h1 class="page-drop__name {{ section.settings.heading_size }}">
            {{ drop.name | escape }}
          </h1>

          {%- if drop.teaser != blank -%}
            <p class="page-drop__teaser">{{ drop.teaser | escape }}</p>
          {%- endif -%}

          {%- if drop.body != blank -%}
            <div class="page-drop__body rte">
              {{ drop.body }}
            </div>
          {%- endif -%}

          {%- if launch_at != blank -%}
            <p class="page-drop__date">
              <span class="page-drop__label">Launch:</span>
              {{ launch_at | date: format: 'date_at_time' }}
            </p>
          {%- endif -%}

          {%- if end_at != blank -%}
            <p class="page-drop__date">
              <span class="page-drop__label">Ends:</span>
              {{ end_at | date: format: 'date_at_time' }}
            </p>
          {%- endif -%}
        </div>

        {%- if section.settings.show_products -%}
          {%- assign drop_products = drop.products.value -%}
          {%- if drop_products != blank and drop_products.size > 0 -%}
            <div class="page-drop__products">
              <h2 class="page-drop__products-heading">Pieces in this drop</h2>
              <ul class="page-drop__product-grid" role="list">
                {%- for prod in drop_products limit: section.settings.products_limit -%}
                  <li class="page-drop__product-item" role="listitem">
                    {% render 'card-product',
                      card_product: prod,
                      media_aspect_ratio: section.settings.image_ratio,
                      show_secondary_image: section.settings.show_secondary_image,
                      show_vendor: section.settings.show_vendor,
                      show_rating: section.settings.show_rating,
                      show_quick_add: section.settings.enable_quick_add,
                      section_id: section.id
                    %}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <div class="page-drop__placeholder">
          <p>
            This page needs a <code>custom.drop</code> page metafield referencing a drop metaobject,
            or select a fallback drop in section settings.
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Drop Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Reads the page's custom.drop metafield to display drop details and products."
    },
    {
      "type": "metaobject",
      "id": "fallback_drop",
      "label": "Fallback drop (for design mode preview)",
      "metaobject_type": "drop"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "show_products",
      "label": "Show drop products",
      "default": true
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 1,
      "max": 12,
      "step": 1,
      "label": "Products to show",
      "default": 8
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "label": "Show secondary image on hover",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "label": "Enable quick add",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Drop Page"
    }
  ]
}
{% endschema %}
