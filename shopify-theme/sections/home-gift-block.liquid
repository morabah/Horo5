{%- if section.settings.show_section or request.design_mode -%}
  {{ 'component-home-gift-block.css' | asset_url | stylesheet_tag }}

  {%- liquid
    assign gift_fallback_product = nil
    assign gift_collection = collections['gift-ready']
    if gift_collection != blank and gift_collection.products_count > 0
      assign gift_fallback_product = gift_collection.products.first
    endif
    if gift_fallback_product == nil
      assign founding_collection = collections['founding-drop']
      if founding_collection != blank and founding_collection.products_count > 0
        assign gift_fallback_product = founding_collection.products.first
      endif
    endif
    assign gift_campaign_image = section.settings.image
    assign gift_campaign_image_url = nil
    if gift_campaign_image == blank
      assign gift_campaign_image_url = 'horo-gift-box.png' | asset_url
    endif
    assign show_banner_image = false
    if gift_campaign_image != blank or gift_campaign_image_url != blank
      assign show_banner_image = true
    elsif gift_fallback_product != blank
      assign show_banner_image = true
    endif
  -%}

  <section
    id="gift-by-meaning"
    class="home-section home-section--breath section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    aria-labelledby="home-gift-title-{{ section.id }}"
  >
    <div class="home-page__inner">
      {%- liquid
        assign layout_style = section.settings.layout_style | default: 'image_overlay'
        assign gift_heading = section.settings.heading
        if section.settings.heading_line_2 != blank
          assign gift_heading = section.settings.heading | append: ' ' | append: section.settings.heading_line_2
        endif
        assign show_body = section.settings.show_body
        if show_body == nil
          assign show_body = true
        endif
      -%}

      {%- liquid
        assign show_gift_campaign = false
        if layout_style == 'image_overlay' and show_banner_image
          if gift_campaign_image != blank or gift_campaign_image_url != blank
            assign show_gift_campaign = true
          endif
        endif
      -%}
      {%- if show_gift_campaign -%}
        {% render 'horo-home-campaign-overlay',
          campaign_image: gift_campaign_image,
          campaign_image_url: gift_campaign_image_url,
          eyebrow: section.settings.eyebrow,
          heading: gift_heading,
          body: section.settings.body,
          button_primary_label: section.settings.button_label,
          button_primary_link: section.settings.button_link,
          overlay_opacity: section.settings.overlay_opacity,
          show_body: show_body,
          show_eyebrow: section.settings.show_eyebrow,
          text_position: section.settings.text_position,
          mobile_text_mode: section.settings.mobile_text_mode,
          block_id: section.id
        %}
      {%- else -%}
      <div class="home-gift-banner{% unless show_banner_image %} home-gift-banner--copy-only{% endunless %}">
        <div class="home-gift-banner__copy">
          {%- if section.settings.eyebrow != blank -%}
            <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="home-gift-title-{{ section.id }}" class="home-gift-banner__title">
            {{ section.settings.heading | escape }}
            {%- if section.settings.heading_line_2 != blank -%}
              <br>
              {{ section.settings.heading_line_2 | escape }}
            {%- endif -%}
          </h2>
          {%- if section.settings.body != blank -%}
            <p class="home-gift-banner__body">{{ section.settings.body | escape }}</p>
          {%- endif -%}
          {%- if section.settings.show_occasion_chips -%}
            <ul class="home-gift-banner__chips" role="list">
              <li>Birthdays</li>
              <li>Graduation</li>
              <li>Just because</li>
            </ul>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <div class="home-gift-banner__cta-wrap">
              <a
                {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
                class="home-btn home-btn--primary"
                data-horo-home-event="gift_block_cta_click"
                data-horo-home-props='{"cta":"shop_gift_ready"}'
              >
                {{ section.settings.button_label | escape }}
              </a>
            </div>
          {%- endif -%}
        </div>
        {%- if show_banner_image -%}
          <div class="home-gift-banner__media">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 800, 1200',
                  sizes: '(max-width: 768px) 100vw, 64vw',
                  alt: section.settings.image.alt | default: section.settings.heading
              }}
            {%- elsif gift_fallback_product != blank -%}
              {% render 'horo-home-card-image',
                card_product: gift_fallback_product,
                loading: 'lazy',
                sizes: '(max-width: 768px) 100vw, 64vw',
                image_class: 'home-gift-banner__product-image',
                placeholder_class: 'placeholder-svg'
              %}
            {%- else -%}
              <img
                src="{{ 'home-gift-banner.png' | asset_url }}"
                alt="{{ section.settings.heading | escape }}"
                width="1200"
                height="800"
                loading="lazy"
                class="home-gift-banner__asset-image"
              >
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HORO Gift by Meaning",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_section",
      "label": "Show section",
      "default": false,
      "info": "Keep off for launch. Enable when the gifts hub is ready to promote on the homepage."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "GIFT READY"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        { "value": "image_overlay", "label": "Image overlay" },
        { "value": "split", "label": "Split banner (legacy)" }
      ],
      "default": "image_overlay"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading line 1",
      "default": "More than a gift."
    },
    {
      "type": "text",
      "id": "heading_line_2",
      "label": "Heading line 2 (overlay: use body instead)"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "A feeling they'll wear."
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "show_body",
      "label": "Show body on overlay",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "mobile_text_mode",
      "label": "Mobile text",
      "options": [
        { "value": "overlay", "label": "On image" },
        { "value": "below", "label": "Below image" }
      ],
      "default": "below"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Gifts"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "show_occasion_chips",
      "label": "Show occasion chips",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner image"
    }
  ],
  "presets": [
    {
      "name": "HORO Gift by Meaning",
      "settings": {
        "show_section": false
      }
    }
  ]
}
{% endschema %}
