{{ 'component-horo-seen-on-you.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign proof_assets = 'back-fit-card.svg,macro-detail-card.svg,fabric-tag-card.svg,weight-scale-card.svg' | split: ','
-%}

<div
  class="horo-section seen-on-you color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="seen-on-you__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <ul class="seen-on-you__grid" role="list">
      {%- for asset_name in proof_assets -%}
        {%- assign caption_key = 'caption_' | append: forloop.index -%}
        {%- assign caption = section.settings[caption_key] -%}
        <li class="seen-on-you__item" role="listitem">
          <div class="seen-on-you__media">
            <img
              src="{{ asset_name | asset_url }}"
              alt="{{ caption | default: 'HORO customer wearing a graphic tee' | escape }}"
              width="400"
              height="500"
              loading="lazy"
              class="seen-on-you__image"
            >
          </div>
          {%- if caption != blank -%}
            <p class="seen-on-you__caption">{{ caption | escape }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "HORO Home Seen on You",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "default": "Seen on you",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "caption_1",
      "label": "Caption 1",
      "default": "Quiet confidence — Calm Inside"
    },
    {
      "type": "text",
      "id": "caption_2",
      "label": "Caption 2",
      "default": "Print detail up close"
    },
    {
      "type": "text",
      "id": "caption_3",
      "label": "Caption 3",
      "default": "Fabric and tag proof"
    },
    {
      "type": "text",
      "id": "caption_4",
      "label": "Caption 4",
      "default": "Weight and quality check"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Home Seen on You"
    }
  ]
}
{% endschema %}
