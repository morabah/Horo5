{{ 'component-home-first-drop.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="FirstDrop-{{ section.id }}"
  class="horo-section home-first-drop color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
>
  <div class="page-width">
    <div class="home-first-drop__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="home-first-drop__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      <h2 class="home-first-drop__heading {{ section.settings.heading_size }}">
        {{ 'horo.home.first_drop_title' | t }}
      </h2>

      <p class="home-first-drop__body">
        {{ 'horo.home.first_drop_body' | t }}
      </p>

      {%- if section.settings.show_form -%}
        <form
          class="home-first-drop__form"
          action="{{ section.settings.form_action | default: '#' }}"
          method="post"
          target="_blank"
          rel="noopener"
        >
          <label for="FirstDropEmail-{{ section.id }}" class="visually-hidden">
            {{ 'horo.home.first_drop_placeholder' | t }}
          </label>
          <input
            id="FirstDropEmail-{{ section.id }}"
            type="email"
            name="email"
            class="home-first-drop__input field__input"
            placeholder="{{ 'horo.home.first_drop_placeholder' | t }}"
            required
          >
          <button type="submit" class="home-first-drop__submit button button--primary">
            {{ 'horo.home.first_drop_cta' | t }}
          </button>
        </form>
        <p class="home-first-drop__disclaimer">
          {{ 'horo.home.first_drop_disclaimer' | t }}
        </p>
      {%- else -%}
        <p class="home-first-drop__unavailable">
          {{ 'horo.home.first_drop_unavailable_message' | t }}
        </p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "HORO First Drop Circle",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Early access"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Show signup form",
      "default": true
    },
    {
      "type": "url",
      "id": "form_action",
      "label": "Form action URL (e.g., Mailchimp, Klaviyo)",
      "info": "Leave blank to show the unavailable message instead."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO First Drop Circle"
    }
  ]
}
{% endschema %}
