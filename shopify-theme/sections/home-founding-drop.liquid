{{ 'component-home-founding-drop.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign collection = section.settings.collection
  assign product_limit = section.settings.product_limit
  assign product_count = 0
  if collection != blank
    assign product_count = collection.products_count
  endif
  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and collection != blank
    assign view_all_url = collection.url
  endif
-%}

{%- if product_count > 0 or request.design_mode -%}
  <section
    id="founding-drop"
    class="home-section home-section--bordered home-section--white section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    aria-labelledby="home-start-here-title-{{ section.id }}"
  >
    <div class="home-page__inner">
      <div class="home-section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 id="home-start-here-title-{{ section.id }}" class="home-founding-drop__title">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
        </div>
        {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
          <a href="{{ view_all_url }}" class="home-section-link">
            {{ section.settings.view_all_label | escape }}
            <span aria-hidden="true"> →</span>
          </a>
        {%- endif -%}
      </div>

      {%- if product_count > 0 -%}
        <div class="home-founding-grid">
          {%- for product in collection.products limit: product_limit -%}
            {% render 'horo-founding-product-card',
              card_product: product,
              lazy_load: forloop.index > 3,
              section_id: section.id
            %}
          {%- endfor -%}
        </div>
      {%- elsif request.design_mode -%}
        <p>Select the founding-drop collection in section settings.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HORO Founding Drop",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FOUNDING DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our first 5 pieces. Limited quantities."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link URL",
      "info": "Defaults to the collection URL when empty."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5,
      "label": "Maximum products"
    }
  ],
  "presets": [
    {
      "name": "HORO Founding Drop"
    }
  ]
}
{% endschema %}
