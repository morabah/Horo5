{%- comment -%}
Legacy full taxonomy kept for future restoration:
Lifestyle / Zodiac / Mood / Dream / Art.

Current launch taxonomy is intentionally shallow:
Founding Drop / Sign Capsule / Mood / Lifestyle.
{%- endcomment -%}
{{ 'component-home-founding-drop.css' | asset_url | stylesheet_tag }}
{{ 'component-home-mockup.css' | asset_url | stylesheet_tag }}
<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign product_limit = section.settings.product_limit | default: 11
  if product_limit < 1
    assign product_limit = 11
  endif

  assign collection_handle = 'founding-drop'
  if section.settings.collection != blank
    if section.settings.collection.handle != blank
      assign collection_handle = section.settings.collection.handle
    else
      assign collection_handle = section.settings.collection
    endif
  endif

  assign primary_collection = collections[collection_handle]
  if primary_collection == blank and section.settings.collection != blank and section.settings.collection.products != blank
    assign primary_collection = section.settings.collection
  endif

  assign view_all_url = section.settings.view_all_link
  if view_all_url == blank and primary_collection != blank
    assign view_all_url = primary_collection.url
  endif
-%}

{%- if primary_collection != blank or request.design_mode -%}
  <section
    id="founding-drop"
    class="home-section home-section--white section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
    aria-labelledby="home-start-here-title-{{ section.id }}"
  >
    <div class="home-page__inner home-founding-drop__inner">
      <div class="home-section-header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 id="home-start-here-title-{{ section.id }}" class="home-founding-drop__title">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}
          {%- if section.settings.subheading != blank -%}
            <p class="home-section-subheading">{{ section.settings.subheading | escape }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if primary_collection != blank and primary_collection.products_count > 0 -%}
        <div class="home-founding-grid">
          {%- assign cards_rendered = 0 -%}
          {%- comment -%}
            Variant pick mirrors horo-founding-product-card: prefer available M, else first available, else selected_or_first_available.
          {%- endcomment -%}
          {%- for product in primary_collection.products -%}
            {%- if cards_rendered >= product_limit -%}
              {%- break -%}
            {%- endif -%}
            {%- liquid
              assign display_variant = nil
              assign first_available = nil
              for variant in product.variants
                if variant.available
                  if first_available == nil
                    assign first_available = variant
                  endif
                  if variant.option1 == 'M' or variant.option2 == 'M' or variant.option3 == 'M'
                    assign display_variant = variant
                    break
                  endif
                endif
              endfor
              if display_variant == nil
                assign display_variant = first_available | default: product.selected_or_first_available_variant
              endif
              assign price_check = display_variant.price | default: product.price | default: 0
            -%}
            {%- if price_check > 0 -%}
              {%- assign cards_rendered = cards_rendered | plus: 1 -%}
              {% render 'horo-founding-product-card',
                card_product: product,
                card_variant: display_variant,
                lazy_load: cards_rendered > 2,
                section_id: section.id,
                choose_size_label: section.settings.choose_size_label
              %}
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.view_all_label != blank and view_all_url != blank -%}
          <p class="home-founding-drop__footer-cta">
            <a href="{{ view_all_url }}" class="home-section-link">
              {{ section.settings.view_all_label | escape }}
              <span aria-hidden="true"> →</span>
            </a>
          </p>
        {%- endif -%}
      {%- elsif request.design_mode -%}
        <p>Add products to the {{ collection_handle | escape }} collection to populate this grid.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HORO Founding Drop",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FOUNDING DROP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wearable artwork for signs, moods, and personal stories."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Our first collection of artist-made T-shirts, printed in Egypt and made to be worn, gifted, and remembered."
    },
    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all link label",
      "default": "See all launch designs"
    },
    {
      "type": "url",
      "id": "view_all_link",
      "label": "View all link URL",
      "info": "Defaults to the collection URL when empty."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Homepage shows every product in this collection (up to the limit below)."
    },
    {
      "type": "text",
      "id": "choose_size_label",
      "label": "Choose size button label",
      "default": "Choose size"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 11,
      "label": "Maximum products"
    }
  ],
  "presets": [
    {
      "name": "HORO Founding Drop"
    }
  ]
}
{% endschema %}
