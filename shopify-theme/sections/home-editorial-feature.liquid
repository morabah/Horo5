{{ 'component-home-mockup.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section.settings.anchor_id | default: 'editorial-feature' }}"
  class="home-section home-section--white section-padding-zero"
  aria-labelledby="home-editorial-title-{{ section.id }}"
>
  <div class="home-page__inner">
    <div class="home-editorial-feature">
      {%- if section.settings.image != blank -%}
        <div class="home-editorial-feature__media">
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag: loading: 'lazy', class: 'home-editorial-feature__img', sizes: '(max-width: 768px) 100vw, 50vw'
          }}
        </div>
      {%- endif -%}
      <div class="home-editorial-feature__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-editorial-title-{{ section.id }}" class="home-section-title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="home-section-subheading">{{ section.settings.body | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="home-btn home-btn--primary">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .home-editorial-feature {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .home-editorial-feature {
      grid-template-columns: 1fr 1fr;
    }
  }
  .home-editorial-feature__media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 4px;
    background: #faf7f6;
  }
  .home-editorial-feature__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .home-editorial-feature__copy .home-btn {
    margin-top: 1.5rem;
  }
</style>

{% schema %}
{
  "name": "HORO Editorial Feature",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "editorial-feature" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A Closer Look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Calm Inside" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "button_label", "label": "CTA label", "default": "Shop the Piece" },
    { "type": "url", "id": "button_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "HORO Editorial Feature" }]
}
{% endschema %}
