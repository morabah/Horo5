{{ 'component-home-mockup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign anchor_id = section.settings.anchor_id | default: 'editorial-feature'
  assign fallback_product = section.settings.fallback_product
  assign show_media = false
  assign editorial_media = nil

  if section.settings.image != blank
    assign show_media = true
    assign editorial_media = section.settings.image
  elsif fallback_product != blank
    assign show_media = true
  endif
-%}

<section
  id="{{ anchor_id }}"
  class="home-section home-section--white section-padding-zero"
  aria-labelledby="home-editorial-title-{{ section.id }}"
>
  <div class="home-page__inner">
    <div class="home-editorial-feature{% unless show_media %} home-editorial-feature--copy-only{% endunless %}">
      {%- if show_media -%}
        <div class="home-editorial-feature__media home-editorial-feature__media--visual">
          {%- if editorial_media != blank -%}
            {{
              editorial_media
              | image_url: width: 1200
              | image_tag: loading: 'lazy', class: 'home-editorial-feature__img', sizes: '(max-width: 768px) 100vw, 50vw'
            }}
          {%- else -%}
            {% render 'horo-home-card-image',
              card_product: fallback_product,
              loading: 'lazy',
              sizes: '(max-width: 768px) 100vw, 50vw',
              image_class: 'home-editorial-feature__img',
              placeholder_class: 'placeholder-svg home-editorial-feature__img'
            %}
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="home-editorial-feature__copy home-editorial-feature__copy--primary">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-editorial-title-{{ section.id }}" class="home-section-title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.body != blank -%}
          <p class="home-section-subheading">{{ section.settings.body | escape }}</p>
        {%- endif -%}
        {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="home-btn home-btn--primary">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  .home-editorial-feature {
    display: grid;
    gap: 2rem;
    align-items: center;
  }
  .home-editorial-feature--copy-only {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }
  .home-editorial-feature__copy--primary {
    order: 1;
  }
  .home-editorial-feature__media--visual {
    order: 2;
  }
  @media (min-width: 768px) {
    .home-editorial-feature {
      grid-template-columns: 1fr 1fr;
    }
    .home-editorial-feature__copy--primary {
      order: 2;
    }
    .home-editorial-feature__media--visual {
      order: 1;
    }
  }
  .home-editorial-feature__media {
    position: relative;
    aspect-ratio: 4 / 5;
    max-height: 520px;
    overflow: hidden;
    border-radius: 4px;
    background: #faf7f6;
  }
  .home-editorial-feature__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }
  .home-editorial-feature__copy .home-btn {
    margin-top: 1.5rem;
  }
  .home-editorial-feature--copy-only .home-btn {
    margin-inline: auto;
  }
</style>

{% schema %}
{
  "name": "HORO Editorial Feature",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "anchor_id", "label": "Section anchor ID", "default": "editorial-feature" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A Closer Look" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Calm Inside" },
    { "type": "textarea", "id": "body", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Image (theme editor)" },
    {
      "type": "product",
      "id": "fallback_product",
      "label": "Fallback product image",
      "info": "Used when no section image is set. Pick front artwork on the product in Admin."
    },
    { "type": "text", "id": "button_label", "label": "CTA label", "default": "Shop the Piece" },
    { "type": "url", "id": "button_link", "label": "CTA link" }
  ],
  "presets": [{ "name": "HORO Editorial Feature" }]
}
{% endschema %}
