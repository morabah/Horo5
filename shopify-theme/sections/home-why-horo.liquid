{{ 'component-home-why-horo.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="WhyHoro-{{ section.id }}"
  class="horo-section home-why-horo color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="home-why-horo__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="home-why-horo__subheading">{{ section.settings.subheading | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="home-why-horo__grid">
        {%- for block in section.blocks -%}
          <div
            class="home-why-horo__block{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            data-reveal="stagger-{{ forloop.index }}"
          >
            <div class="home-why-horo__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'pen' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l5 5"/><path d="M9.5 14.5L16 8"/></svg>
                {%- when 'map-pin' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {%- when 'heart' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                {%- when 'box' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                {%- when 'refresh' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="23 4 23 10 17 10"/><path d="M20.49 15a9 9 0 11-2.12-9.36L23 10"/></svg>
                {%- when 'shield' -%}
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
              {%- endcase -%}
            </div>
            {%- if block.settings.title != blank -%}
              <h3 class="home-why-horo__block-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="home-why-horo__block-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="home-why-horo__placeholder">
        <p>Add blocks to display the Why HORO section.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <p class="home-why-horo__cta">
        <a href="{{ section.settings.cta_link }}" class="button button--secondary">
          {{ section.settings.cta_label | escape }}
        </a>
      </p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORO Why HORO",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why HORO"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Not cheap print, not upload-anything custom, not generic gift-shop merch."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Why HORO vs other options"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link",
      "default": "/pages/comparison-faq"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Reason block",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "pen", "label": "Pen (local artists)" },
            { "value": "map-pin", "label": "Map pin (printed in Egypt)" },
            { "value": "heart", "label": "Heart (made to feel personal)" },
            { "value": "box", "label": "Box (clear fit details)" },
            { "value": "refresh", "label": "Refresh (COD and exchange)" },
            { "value": "shield", "label": "Shield (real proof only)" }
          ],
          "default": "pen",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Local artists"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Every design is created by artists from the region, not stock art."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "HORO Why HORO",
      "blocks": [
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" }
      ]
    }
  ]
}
{% endschema %}
