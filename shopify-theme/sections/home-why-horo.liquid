{{ 'component-home-our-story.css' | asset_url | stylesheet_tag }}

<section
  id="our-story"
  class="home-section home-our-story home-section--bordered home-section--soft section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  aria-labelledby="home-our-story-title-{{ section.id }}"
>
  <div class="home-page__inner">
    <div class="home-our-story__layout">
      <div class="home-our-story__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-our-story-title-{{ section.id }}" class="home-our-story__title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="home-our-story__body">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="home-our-story__side">
          <div class="home-our-story__emblem" aria-hidden="true">
            <div class="home-our-story__rings">
              <span class="home-our-story__ring home-our-story__ring--1"></span>
              <span class="home-our-story__ring home-our-story__ring--2"></span>
              <span class="home-our-story__ring home-our-story__ring--3"></span>
              <span class="home-our-story__dot home-our-story__dot--1"></span>
              <span class="home-our-story__dot home-our-story__dot--2"></span>
            </div>
          </div>

          <ul class="home-our-story__pillars" role="list">
            {%- for block in section.blocks -%}
              <li class="home-our-story__pillar" {{ block.shopify_attributes }}>
                <span class="home-our-story__pillar-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'pen' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
                    {%- when 'heart' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    {%- when 'shield' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
                  {%- endcase -%}
                </span>
                <div class="home-our-story__pillar-copy">
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <p>{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif request.design_mode -%}
        <p>Add three story pillar blocks.</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HORO Our Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ritual. Rhythm. Connection."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Body",
      "default": "HORO is a wearable-art brand born in Egypt. We turn emotions into art and art into pieces you live in. Every design is a ritual. Every wear is a reminder. We are the canvas. You are the story."
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Story pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "pen", "label": "Art / pen" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Proof / compass" }
          ],
          "default": "pen",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Art that speaks feelings"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Original illustrations for real emotions."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "HORO Our Story",
      "blocks": [
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" }
      ]
    }
  ]
}
{% endschema %}
