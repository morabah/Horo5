{{ 'component-home-our-story.css' | asset_url | stylesheet_tag }}

<section
  id="our-story"
  class="home-section home-our-story home-our-story--immersive section-padding-zero{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  aria-labelledby="home-our-story-title-{{ section.id }}"
>
  <div class="home-page__inner">
    {%- liquid
      assign layout_style = section.settings.layout_style | default: 'image_overlay'
      assign show_pillars = section.settings.show_pillars
      if show_pillars == nil
        assign show_pillars = false
      endif
      assign story_button_link = section.settings.button_link
      if story_button_link == blank
        assign story_button_link = '/pages/about'
      endif
      assign story_campaign_image = section.settings.image
      assign story_campaign_image_url = nil
      if story_campaign_image == blank
        assign story_campaign_image_url = 'horo-our-story-artist.png' | asset_url
      endif
    -%}

    {%- liquid
      assign show_story_campaign = false
      if layout_style == 'image_overlay'
        if story_campaign_image != blank or story_campaign_image_url != blank
          assign show_story_campaign = true
        endif
      endif
    -%}
    {%- if show_story_campaign -%}
      <div class="home-our-story__intro-mobile">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-our-story-title-{{ section.id }}" class="home-our-story__title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <p class="home-our-story__mobile-cta">
            <a href="{{ story_button_link }}" class="home-section-link">
              {{ section.settings.button_label | escape }}
              <span aria-hidden="true"> →</span>
            </a>
          </p>
        {%- endif -%}
      </div>
      <div id="our-story-campaign" class="home-our-story__campaign-desktop">
        {% render 'horo-home-campaign-overlay',
          campaign_image: story_campaign_image,
          campaign_image_url: story_campaign_image_url,
          eyebrow: section.settings.eyebrow,
          heading: section.settings.heading,
          body: section.settings.subheading,
          button_primary_label: section.settings.button_label,
          button_primary_link: story_button_link,
          overlay_opacity: section.settings.overlay_opacity,
          show_body: section.settings.show_body,
          show_eyebrow: section.settings.show_eyebrow,
          text_position: section.settings.text_position,
          mobile_text_mode: section.settings.mobile_text_mode,
          block_id: section.id
        %}
      </div>
    {%- else -%}
    <div class="home-our-story__layout">
      <div class="home-our-story__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="home-section-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="home-our-story-title-{{ section.id }}" class="home-our-story__title">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="home-our-story__body">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if show_pillars and section.blocks.size > 0 -%}
        <div class="home-our-story__side">
          {%- if section.settings.image != blank -%}
            <div class="home-our-story__photo">
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  class: 'home-our-story__photo-img',
                  sizes: '(max-width: 768px) 100vw, 40vw',
                  alt: section.settings.image.alt | default: section.settings.heading
              }}
            </div>
          {%- else -%}
          <div class="home-our-story__emblem" aria-hidden="true">
            <div class="home-our-story__rings">
              <span class="home-our-story__ring home-our-story__ring--1"></span>
              <span class="home-our-story__ring home-our-story__ring--2"></span>
              <span class="home-our-story__ring home-our-story__ring--3"></span>
              <span class="home-our-story__dot home-our-story__dot--1"></span>
              <span class="home-our-story__dot home-our-story__dot--2"></span>
            </div>
          </div>
          {%- endif -%}

          <ul class="home-our-story__pillars" role="list">
            {%- for block in section.blocks -%}
              <li class="home-our-story__pillar" {{ block.shopify_attributes }}>
                <span class="home-our-story__pillar-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'pen' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/></svg>
                    {%- when 'heart' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
                    {%- when 'shield' -%}
                      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2"/></svg>
                  {%- endcase -%}
                </span>
                <div class="home-our-story__pillar-copy">
                  {%- if block.settings.title != blank -%}
                    <h3>{{ block.settings.title | escape }}</h3>
                  {%- endif -%}
                  {%- if block.settings.body != blank -%}
                    <p>{{ block.settings.body | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- elsif request.design_mode -%}
        <p>Add three story pillar blocks.</p>
      {%- endif -%}
    </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const campaign = document.getElementById('our-story-campaign');
    if (!campaign) return;
    const media = campaign.querySelector('.horo-campaign__media');
    if (!media) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const onScroll = () => {
      const rect = media.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (window.innerHeight - rect.top) / (window.innerHeight + rect.height)));
      const offset = (progress - 0.5) * 36;
      media.style.transform = `translate3d(0, ${offset}px, 0) scale(1.04)`;
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  })();
</script>

{% schema %}
{
  "name": "HORO Our Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "We are the canvas. You are the story."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Body (optional on overlay)"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        { "value": "image_overlay", "label": "Image overlay" },
        { "value": "split", "label": "Split with pillars (legacy)" }
      ],
      "default": "image_overlay"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "CTA label",
      "default": "Read our story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "CTA link"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 50
    },
    {
      "type": "checkbox",
      "id": "show_pillars",
      "label": "Show pillar blocks on homepage",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_body",
      "label": "Show body on overlay",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "label": "Show eyebrow",
      "default": true
    },
    {
      "type": "select",
      "id": "text_position",
      "label": "Text position",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left"
    },
    {
      "type": "select",
      "id": "mobile_text_mode",
      "label": "Mobile text",
      "options": [
        { "value": "overlay", "label": "On image" },
        { "value": "below", "label": "Below image" }
      ],
      "default": "below"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story photo",
      "info": "Replaces the symbolic rings when set. Upload a human or product-led photo."
    }
  ],
  "blocks": [
    {
      "type": "reason",
      "name": "Story pillar",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "pen", "label": "Art / pen" },
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Proof / compass" }
          ],
          "default": "pen",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Art that speaks feelings"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Original illustrations for real emotions."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "HORO Our Story",
      "blocks": [
        { "type": "reason" },
        { "type": "reason" },
        { "type": "reason" }
      ]
    }
  ]
}
{% endschema %}
