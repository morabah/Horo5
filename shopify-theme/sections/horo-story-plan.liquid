{{ 'component-horo-story-plan.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.type == 'step'
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="StoryPlan-{{ section.id }}"
    class="horo-section horo-story-plan color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if section.settings.eyebrow != blank -%}
        <p class="horo-story-plan__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="horo-story-plan__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="horo-story-plan__subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}

      {%- if visible_count > 0 -%}
        <ul class="horo-story-plan__grid" role="list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'step' -%}
              <li class="horo-story-plan__card" role="listitem" {{ block.shopify_attributes }}>
                <span class="horo-story-plan__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'search' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                    {%- when 'heart' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                    {%- when 'package' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    {%- when 'sparkles' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l1.5 4.5L18 8l-4.5 1.5L12 14l-1.5-4.5L6 8l4.5-1.5z"/><path d="M5 16l1 3 3 1-3 1-1 3-1-3-3-1 3-1z"/></svg>
                    {%- when 'user' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    {%- when 'shirt' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10c0 1.1.9 2 2 2h8a2 2 0 0 0 2-2V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                  {%- endcase -%}
                </span>
                {%- if block.settings.title != blank -%}
                  <h3 class="horo-story-plan__title">{{ block.settings.title | escape }}</h3>
                {%- endif -%}
                {%- if block.settings.body != blank -%}
                  <p class="horo-story-plan__body">{{ block.settings.body | escape }}</p>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <div class="horo-story-plan__placeholder">
          <p>Add at least one step block to display the plan.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Story Plan",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "How it works",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Your HORO piece in three steps",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "search", "label": "Search" },
            { "value": "heart", "label": "Heart" },
            { "value": "package", "label": "Package" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "user", "label": "User" },
            { "value": "shirt", "label": "Shirt" }
          ],
          "default": "search",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "default": "Find your feeling",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "body",
          "default": "Start with a mood, sign, attitude, or moment.",
          "label": "Body"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO Story Plan",
      "blocks": {
        "step_1": {
          "type": "step",
          "settings": {
            "icon": "search",
            "title": "Find your feeling",
            "body": "Start with a mood, sign, attitude, or moment."
          }
        },
        "step_2": {
          "type": "step",
          "settings": {
            "icon": "heart",
            "title": "Pick your design",
            "body": "Choose artwork that says it without explaining."
          }
        },
        "step_3": {
          "type": "step",
          "settings": {
            "icon": "package",
            "title": "Wear it",
            "body": "Your piece arrives ready to join your everyday rotation."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ]
    }
  ]
}
{% endschema %}
