{%- comment -%}
  HORO Product Data — injects current product handle + analytics payload for JS modules.
{%- endcomment -%}

{%- if product -%}
  <script>
    {% render 'horo-product-analytics-json', product: product %}
  </script>

  {% render 'horo-jsonld-product', product: product %}
{%- endif -%}

{% schema %}
{
  "name": "HORO Product Data",
  "tag": "section",
  "class": "section",
  "settings": [],
  "presets": [
    {
      "name": "HORO Product Data"
    }
  ]
}
{% endschema %}
