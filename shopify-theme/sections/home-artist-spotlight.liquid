{{ 'component-home-artist-spotlight.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign all_artists = shop.metaobjects.artist.values
  assign active_artists = ''
  assign artist_count = 0

  for artist in all_artists
    if artist.active != false and artist.avatar != blank
      assign active_artists = active_artists | append: artist.id | append: ','
      assign artist_count = artist_count | plus: 1
    endif
  endfor

  assign featured_artist = nil
  if section.settings.artist != blank
    assign featured_artist = section.settings.artist
  elsif artist_count > 0
    assign artist_ids = active_artists | split: ','
    assign first_id = artist_ids[0] | plus: 0
    for artist in all_artists
      if artist.id == first_id
        assign featured_artist = artist
        break
      endif
    endfor
  endif

  assign has_artist = false
  if featured_artist != blank and featured_artist.name != blank
    assign has_artist = true
  endif

  assign avatar = featured_artist.avatar
  assign artist_name = featured_artist.name
  assign style = featured_artist.style | default: featured_artist.bio | default: ''
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if has_artist or request.design_mode -%}
  <div
    id="ArtistSpotlight-{{ section.id }}"
    class="horo-section home-artist-spotlight color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="page-width">
      {%- if has_artist -%}
        <div class="home-artist-spotlight__grid">
          {%- if avatar != blank -%}
            <div class="home-artist-spotlight__media" data-reveal>
              {{
                avatar
                | image_url: width: 1000
                | image_tag:
                  loading: 'lazy',
                  widths: '400, 600, 800, 1000',
                  sizes: '(min-width: 750px) 45vw, 100vw',
                  class: 'home-artist-spotlight__image'
              }}
            </div>
          {%- endif -%}

          <div class="home-artist-spotlight__content" data-reveal="stagger-1">
            <p class="home-artist-spotlight__eyebrow">{{ 'horo.home.artist_spotlight_title' | t }}</p>
            <h2 class="home-artist-spotlight__heading {{ section.settings.heading_size }}">
              {{ artist_name | escape }}
            </h2>
            {%- if style != blank -%}
              <p class="home-artist-spotlight__body">{{ style | escape }}</p>
            {%- endif -%}
            <div class="home-artist-spotlight__actions">
              <a href="{{ section.settings.artists_page_url | default: '/pages/artists' }}" class="home-artist-spotlight__cta">
                {{ 'horo.home.artist_spotlight_cta' | t }}
              </a>
            </div>
          </div>
        </div>
      {%- elsif request.design_mode -%}
        <div class="home-artist-spotlight__placeholder">
          <p>Add an active artist with an avatar to display the artist spotlight, or select one in section settings.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Artist Spotlight",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "metaobject",
      "id": "artist",
      "label": "Featured artist",
      "metaobject_type": "artist"
    },
    {
      "type": "url",
      "id": "artists_page_url",
      "label": "Artists page URL"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Artist Spotlight"
    }
  ]
}
{% endschema %}
