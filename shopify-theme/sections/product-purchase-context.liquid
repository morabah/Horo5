{{ 'component-product-purchase-context.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign feeling_metaobject = product.metafields.custom.feeling.value
  assign subfeeling_metaobject = product.metafields.custom.subfeeling.value
  assign fit_note = product.metafields.custom.fit_note.value | default: product.metafields.custom.fit_label.value | default: product.metafields.custom.size_fit_note.value
  assign low_stock_message = product.metafields.custom.low_stock_message.value
  assign whatsapp_base_url = product.metafields.custom.whatsapp_help_url.value | default: settings.horo_whatsapp_support_url
  assign giftable = product.metafields.custom.giftable.value
  assign gift_occasion_tags = product.metafields.custom.gift_occasion_tags.value
  assign trust_chips = product.metafields.custom.trust_chips.value
  assign features = product.metafields.custom.features.value

  assign has_feeling = false
  if feeling_metaobject != blank
    assign has_feeling = true
  endif

  assign has_subfeeling = false
  if subfeeling_metaobject != blank
    assign has_subfeeling = true
  endif

  assign has_fit_note = false
  if fit_note != blank
    assign has_fit_note = true
  endif

  assign has_low_stock = false
  if low_stock_message != blank
    assign has_low_stock = true
  endif

  assign has_whatsapp = false
  if whatsapp_base_url != blank
    assign has_whatsapp = true
    assign whatsapp_message = 'Hi HORO team, I need help choosing a size for ' | append: product.title
    assign whatsapp_message_encoded = whatsapp_message | url_encode
    if whatsapp_base_url contains 'text='
      assign whatsapp_url = whatsapp_base_url
    elsif whatsapp_base_url contains '?'
      assign whatsapp_url = whatsapp_base_url | append: '&text=' | append: whatsapp_message_encoded
    else
      assign whatsapp_url = whatsapp_base_url | append: '?text=' | append: whatsapp_message_encoded
    endif
  endif

  assign is_giftable = false
  if giftable == true or giftable == 'true' or gift_occasion_tags != blank
    assign is_giftable = true
  endif

  assign trust_chips_count = 0
  if trust_chips != blank
    for chip in trust_chips
      if chip != blank
        assign trust_chips_count = trust_chips_count | plus: 1
      endif
    endfor
  endif

  assign features_count = 0
  if features != blank
    for feature in features
      if feature != blank
        assign features_count = features_count | plus: 1
      endif
    endfor
  endif

  assign has_content = false
  if has_feeling or has_subfeeling or has_fit_note or has_low_stock or has_whatsapp or is_giftable or trust_chips_count > 0 or features_count > 0
    assign has_content = true
  endif
-%}

{%- if has_content or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="PurchaseContext-{{ section.id }}"
    class="horo-section product-purchase-context color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if has_content -%}
        <div class="product-purchase-context__wrapper">
          {%- if has_feeling or has_subfeeling -%}
            <div class="product-purchase-context__pills" role="group" aria-label="Product feeling">
              {%- if has_feeling -%}
                <span class="product-purchase-context__pill product-purchase-context__pill--feeling">
                  {{ feeling_metaobject.title | default: feeling_metaobject.name | default: feeling_metaobject.display_name | escape }}
                </span>
              {%- endif -%}
              {%- if has_subfeeling -%}
                <span class="product-purchase-context__pill product-purchase-context__pill--subfeeling">
                  {{ subfeeling_metaobject.title | default: subfeeling_metaobject.name | default: subfeeling_metaobject.display_name | escape }}
                </span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if has_fit_note -%}
            <p class="product-purchase-context__fit-note">
              <span class="product-purchase-context__fit-note-label" aria-hidden="true">Fit:</span>
              <span class="product-purchase-context__fit-note-value">{{ fit_note | escape }}</span>
            </p>
          {%- endif -%}

          {%- if features_count > 0 -%}
            <div class="product-purchase-context__chips" role="list" aria-label="Features">
              {%- for feature in features -%}
                {%- if feature != blank -%}
                  <span class="product-purchase-context__chip product-purchase-context__chip--feature" role="listitem">{{- feature | escape -}}</span>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}

          {%- if trust_chips_count > 0 or section.settings.show_default_trust_chips -%}
            <div class="product-purchase-context__chips product-purchase-context__chips--trust" role="list" aria-label="Trust signals">
              {%- if trust_chips_count > 0 -%}
                {%- for chip in trust_chips -%}
                  {%- if chip != blank -%}
                    <span class="product-purchase-context__chip product-purchase-context__chip--trust" role="listitem">{{- chip | escape -}}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- elsif section.settings.show_default_trust_chips -%}
                <span class="product-purchase-context__chip product-purchase-context__chip--trust" role="listitem">Cotton T-shirt</span>
                <span class="product-purchase-context__chip product-purchase-context__chip--trust" role="listitem">Printed in Egypt</span>
                <span class="product-purchase-context__chip product-purchase-context__chip--trust" role="listitem">COD available</span>
                <span class="product-purchase-context__chip product-purchase-context__chip--trust" role="listitem">14-day easy exchange</span>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if has_low_stock -%}
            <p class="product-purchase-context__urgency">{{- low_stock_message | escape -}}</p>
          {%- endif -%}

          {%- if has_whatsapp -%}
            <div class="product-purchase-context__support">
              <a
                href="{{- whatsapp_url | escape -}}"
                class="product-purchase-context__whatsapp button button--secondary"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="Get help on WhatsApp"
              >
                <span class="product-purchase-context__whatsapp-icon" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/></svg>
                </span>
                <span>Need help with size? Ask us on WhatsApp</span>
              </a>
            </div>
          {%- endif -%}

          {%- if is_giftable -%}
            <p class="product-purchase-context__gift-note">
              Buying it as a gift? Ask us for size help before ordering.
            </p>
          {%- endif -%}
        </div>
      {%- elsif request.design_mode -%}
        <div class="product-purchase-context__placeholder">
          <p>
            Add product metafields to populate this section:<br>
            <code>custom.feeling</code>, <code>custom.subfeeling</code>, <code>custom.fit_note</code>,
            <code>custom.fit_label</code>, <code>custom.size_fit_note</code>,
            <code>custom.low_stock_message</code>, <code>custom.whatsapp_help_url</code>,
            <code>custom.trust_chips</code>, <code>custom.features</code>
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Purchase Context",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "show_default_trust_chips",
      "default": true,
      "label": "Show default trust chips",
      "info": "Displays fallback trust chips when no product metafield trust chips are set."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "HORO Purchase Context"
    }
  ]
}
{% endschema %}
