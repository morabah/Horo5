{{ 'component-subfeeling-nav.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign feeling = collection.metafields.custom.feeling.value
  if feeling == blank
    assign feeling = nil
  endif
  assign feeling_handle = feeling.handle | default: feeling.slug | default: ''
-%}

{%- if feeling != blank -%}
  {%- assign all_subfeelings = shop.metaobjects.subfeeling.values -%}
  {%- assign subfeeling_count = 0 -%}

  {%- for subfeeling in all_subfeelings -%}
    {%- liquid
      assign subfeeling_parent_handle = ''
      if subfeeling.parent_feeling != blank
        assign subfeeling_parent_handle = subfeeling.parent_feeling.handle | default: subfeeling.parent_feeling.slug | default: ''
      elsif subfeeling.feeling_slug != blank
        assign subfeeling_parent_handle = subfeeling.feeling_slug
      endif
      assign subfeeling_handle = subfeeling.handle | default: subfeeling.slug | default: ''
    -%}
    {%- if subfeeling_parent_handle == feeling_handle and subfeeling.active != false -%}
      {%- assign subfeeling_count = subfeeling_count | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if subfeeling_count > 0 -%}
    <nav
      id="SubfeelingNav-{{ section.id }}"
      class="horo-section subfeeling-nav color-{{ section.settings.color_scheme }} gradient{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
      aria-label="Filter by subfeeling"
    >
      {%- liquid
        assign parent_collection_url = feeling.collection_url | default: feeling.collection.value.url
        if parent_collection_url == blank and feeling_handle != blank
          assign parent_collection_url = routes.collections_url | append: '/feeling-' | append: feeling_handle
        endif
        assign parent_feeling_label = feeling.title | default: feeling.name | default: feeling.display_name
        assign expected_parent_handle = 'feeling-' | append: feeling_handle
        assign is_parent_collection = false
        if collection.handle == expected_parent_handle
          assign is_parent_collection = true
        endif
      -%}
      <ul class="subfeeling-nav__list" role="list">
        {%- if parent_collection_url != blank -%}
          <li class="subfeeling-nav__item" role="listitem">
            <a
              href="{{ parent_collection_url }}"
              class="subfeeling-nav__pill{% if is_parent_collection %} subfeeling-nav__pill--active{% endif %}"
              {% if is_parent_collection %}aria-current="page"{% endif %}
            >
              {{ 'horo.collection.all_feeling' | t: feeling: parent_feeling_label }}
            </a>
          </li>
        {%- endif -%}
        {%- for subfeeling in all_subfeelings -%}
          {%- liquid
            assign subfeeling_parent_handle = ''
            if subfeeling.parent_feeling != blank
              assign subfeeling_parent_handle = subfeeling.parent_feeling.handle | default: subfeeling.parent_feeling.slug | default: ''
            elsif subfeeling.feeling_slug != blank
              assign subfeeling_parent_handle = subfeeling.feeling_slug
            endif
            assign subfeeling_handle = subfeeling.handle | default: subfeeling.slug | default: ''
            assign subfeeling_title = subfeeling.title | default: subfeeling.name | default: subfeeling.display_name | default: ''
          -%}
          {%- if subfeeling_parent_handle == feeling_handle and subfeeling.active != false -%}
            <li class="subfeeling-nav__item" role="listitem">
              {%- if subfeeling.filter_url != blank -%}
                <a
                  href="{{ subfeeling.filter_url }}"
                  class="subfeeling-nav__pill"
                >
                  {{ subfeeling_title | escape }}
                </a>
              {%- elsif subfeeling.collection_url != blank -%}
                <a
                  href="{{ subfeeling.collection_url }}"
                  class="subfeeling-nav__pill"
                >
                  {{ subfeeling_title | escape }}
                </a>
              {%- elsif subfeeling_handle != blank -%}
                {%- assign sub_collection_handle = 'feeling-' | append: feeling_handle | append: '-' | append: subfeeling_handle -%}
                <a
                  href="{{ routes.collections_url }}/feeling-{{ feeling_handle }}-{{ subfeeling_handle }}"
                  class="subfeeling-nav__pill{% if collection.handle == sub_collection_handle %} subfeeling-nav__pill--active{% endif %}"
                  {% if collection.handle == sub_collection_handle %}aria-current="page"{% endif %}
                >
                  {{ subfeeling_title | escape }}
                </a>
              {%- else -%}
                <span class="subfeeling-nav__pill subfeeling-nav__pill--inactive">
                  {{ subfeeling_title | escape }}
                </span>
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </nav>
  {%- elsif request.design_mode -%}
    <div class="subfeeling-nav__placeholder">
      <p>No active subfeeling entries found for this feeling, or subfeeling data is not yet configured. Add subfeeling metaobjects linked to feeling "{{ feeling.title | default: feeling.name | escape }}" to populate these filter pills.</p>
    </div>
  {%- endif -%}
{%- endif -%}

{% schema %}
{
  "name": "HORO Subfeeling Nav",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "This section reads the collection's custom.feeling metaobject reference and renders filter pills for its linked subfeeling entries. Pills link to filter_url or collection_url fields if available; otherwise render as inactive text. Hidden when no feeling reference or no subfeelings exist."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HORO Subfeeling Nav"
    }
  ]
}
{% endschema %}
