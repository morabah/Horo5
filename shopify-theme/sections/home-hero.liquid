{{ 'component-home-hero.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign fetch_priority = 'auto'
  if section.index == 0
    assign fetch_priority = 'high'
  endif
  assign full_width = '100vw'
  assign widths = '375, 550, 750, 1100, 1500, 1780, 2000, 3000, 3840'
-%}

{%- style -%}
  #HomeHero-{{ section.id }}::after {
    opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
  }
{%- endstyle -%}

<div
  id="HomeHero-{{ section.id }}"
  class="horo-section home-hero{% if section.settings.enable_cinematic_mode %} home-hero--cinematic{% endif %}{% if section.settings.show_grain_overlay == false %} home-hero--no-grain{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  data-desktop-position="{{ section.settings.hero_cta_position_desktop }}"
  data-mobile-position="{{ section.settings.hero_cta_position_mobile }}"
>
  {%- if section.settings.image != blank -%}
    <div class="home-hero__media">
      {%- liquid
        assign image_height = section.settings.image.width | divided_by: section.settings.image.aspect_ratio
      -%}
      {{
        section.settings.image
        | image_url: width: 3840
        | image_tag:
          width: section.settings.image.width,
          height: image_height,
          sizes: full_width,
          widths: widths,
          fetchpriority: fetch_priority,
          class: 'home-hero__image',
          loading: 'eager'
      }}
    </div>
  {%- else -%}
    <div class="home-hero__media home-hero__media--placeholder">
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    </div>
  {%- endif -%}

  {%- if section.settings.show_split_typography -%}
    <div
      class="home-hero__split-typography"
      aria-hidden="true"
    >
      {%- if section.settings.split_word_1 != blank -%}
        <span class="home-hero__split-line">{{ section.settings.split_word_1 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.split_word_2 != blank -%}
        <span class="home-hero__split-line">{{ section.settings.split_word_2 | escape }}</span>
      {%- endif -%}
      {%- if section.settings.split_word_3 != blank -%}
        <span class="home-hero__split-line">{{ section.settings.split_word_3 | escape }}</span>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if section.settings.show_editorial_word_layer -%}
    <div
      class="home-hero__editorial-layer home-hero__editorial-layer--{{ section.settings.editorial_word_position }}"
      aria-hidden="true"
      style="opacity: {{ section.settings.editorial_word_opacity | divided_by: 100.0 }};"
    >
      <span class="home-hero__editorial-line">{{ section.settings.editorial_word_line_1 | escape }}</span>
      <span class="home-hero__editorial-line">{{ section.settings.editorial_word_line_2 | escape }}</span>
    </div>
  {%- endif -%}

  <div class="home-hero__content page-width">
    <div class="home-hero__text-wrapper">
      {%- if section.settings.heading != blank -%}
        <h1 class="home-hero__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <p class="home-hero__subheading">
          {{ section.settings.subheading }}
        </p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% endif %}
          class="home-hero__cta button{% if section.settings.button_style_secondary %} button--secondary{% else %} button--primary{% endif %}"
          {% if section.settings.button_link == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_secondary != blank -%}
        <a
          {% if section.settings.button_link_secondary != blank %}href="{{ section.settings.button_link_secondary }}"{% endif %}
          class="home-hero__cta button button--secondary"
          {% if section.settings.button_link_secondary == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label_secondary | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.button_label_tertiary != blank -%}
        <a
          {% if section.settings.button_link_tertiary != blank %}href="{{ section.settings.button_link_tertiary }}"{% endif %}
          class="home-hero__cta button button--tertiary"
          {% if section.settings.button_link_tertiary == blank %}aria-disabled="true"{% endif %}
        >
          {{ section.settings.button_label_tertiary | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_hero_ribbon and section.settings.hero_ribbon_text != blank -%}
    <div class="home-hero__ribbon" aria-hidden="true">
      <span class="home-hero__ribbon-text">{{ section.settings.hero_ribbon_text | escape }}</span>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "HORO Home Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear What You Mean"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h1", "label": "Small" },
        { "value": "h0", "label": "Medium" },
        { "value": "h-xl", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Artist-made T-shirts for moods, moments, and meaningful gifts."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop by Feeling",
      "info": "Primary CTA — keep to two hero buttons (feeling + gift)."
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "button_style_secondary",
      "label": "Use secondary button style",
      "default": false
    },
    {
      "type": "text",
      "id": "button_label_secondary",
      "label": "Secondary button label",
      "default": "Find a Gift"
    },
    {
      "type": "url",
      "id": "button_link_secondary",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "button_label_tertiary",
      "label": "Tertiary button label (optional)",
      "info": "Leave blank for two-button hero. Use for promos like a drop collection.",
      "default": "Shop Gifts"
    },
    {
      "type": "url",
      "id": "button_link_tertiary",
      "label": "Tertiary button link"
    },
    {
      "type": "select",
      "id": "desktop_content_position",
      "options": [
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-center", "label": "Bottom center" },
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "bottom-right", "label": "Bottom right" }
      ],
      "default": "center-center",
      "label": "Desktop content position"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "start", "label": "Left" }
      ],
      "default": "center",
      "label": "Mobile content alignment"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Cinematic mode"
    },
    {
      "type": "checkbox",
      "id": "enable_cinematic_mode",
      "default": false,
      "label": "Enable cinematic mode",
      "info": "Uses full viewport height and stronger dark treatment."
    },
    {
      "type": "checkbox",
      "id": "show_grain_overlay",
      "default": true,
      "label": "Show grain overlay"
    },
    {
      "type": "checkbox",
      "id": "show_split_typography",
      "default": false,
      "label": "Show split typography",
      "info": "Large decorative split text. Marked aria-hidden."
    },
    {
      "type": "text",
      "id": "split_word_1",
      "default": "Wear",
      "label": "Split word 1"
    },
    {
      "type": "text",
      "id": "split_word_2",
      "default": "What",
      "label": "Split word 2"
    },
    {
      "type": "text",
      "id": "split_word_3",
      "default": "You Mean",
      "label": "Split word 3"
    },
    {
      "type": "checkbox",
      "id": "show_hero_ribbon",
      "default": true,
      "label": "Show hero ribbon"
    },
    {
      "type": "text",
      "id": "hero_ribbon_text",
      "default": "Cash on delivery (COD) available · 14-day exchange — see policy · Printed in Egypt",
      "label": "Hero ribbon text"
    },
    {
      "type": "select",
      "id": "hero_cta_position_mobile",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "bottom-left", "label": "Bottom left" }
      ],
      "default": "center",
      "label": "Mobile CTA position"
    },
    {
      "type": "select",
      "id": "hero_cta_position_desktop",
      "options": [
        { "value": "bottom-left", "label": "Bottom left" },
        { "value": "center-center", "label": "Center" },
        { "value": "bottom-center", "label": "Bottom center" }
      ],
      "default": "bottom-left",
      "label": "Desktop CTA position"
    },
    {
      "type": "header",
      "content": "Editorial word layer (legacy)"
    },
    {
      "type": "checkbox",
      "id": "show_editorial_word_layer",
      "default": false,
      "label": "Show editorial word layer",
      "info": "Large background text behind hero content. Enable only after testing readability."
    },
    {
      "type": "text",
      "id": "editorial_word_line_1",
      "default": "WEAR",
      "label": "Line 1"
    },
    {
      "type": "text",
      "id": "editorial_word_line_2",
      "default": "WHAT YOU FEEL",
      "label": "Line 2"
    },
    {
      "type": "range",
      "id": "editorial_word_opacity",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "label": "Opacity",
      "default": 18
    },
    {
      "type": "select",
      "id": "editorial_word_position",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center",
      "label": "Position"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "HORO Home Hero"
    }
  ]
}
{% endschema %}
