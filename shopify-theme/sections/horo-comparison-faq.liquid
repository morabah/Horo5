{{ 'component-horo-comparison-faq.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="ComparisonFaq-{{ section.id }}"
  class="horo-section horo-comparison-faq color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="page-width">
    <h1 class="h0">{{ section.settings.heading | default: page.title | escape }}</h1>

    {%- if section.settings.intro != blank -%}
      <p class="horo-comparison-faq__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="horo-comparison-faq__table-wrap">
        <table class="horo-comparison-faq__table">
          <thead>
            <tr>
              <th scope="col">{{ section.settings.col_buyer | default: 'You might think' | escape }}</th>
              <th scope="col">{{ section.settings.col_horo | default: 'Why HORO is different' | escape }}</th>
              <th scope="col">{{ section.settings.col_proof | default: 'Proof' | escape }}</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'comparison_row' -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.buyer_comparison | escape }}</th>
                  <td>{{ block.settings.horo_answer | escape }}</td>
                  <td class="horo-comparison-faq__proof">{{ block.settings.proof | escape }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- elsif request.design_mode -%}
      <p>Add comparison rows in the theme editor.</p>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
      <div class="horo-comparison-faq__cta">
        <a href="{{ section.settings.cta_link }}" class="button">
          {{ section.settings.cta_label | escape }}
        </a>
        {%- if section.settings.secondary_label != blank and section.settings.secondary_link != blank -%}
          <a href="{{ section.settings.secondary_link }}" class="button button--secondary">
            {{ section.settings.secondary_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORO Comparison FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why HORO, not a normal printed T-shirt?"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "HORO is artist-made wearable art — not cheap print, not upload-anything custom, and not generic gift-shop merch. Here is how we compare."
    },
    {
      "type": "text",
      "id": "col_buyer",
      "label": "Column 1 header",
      "default": "You might think"
    },
    {
      "type": "text",
      "id": "col_horo",
      "label": "Column 2 header",
      "default": "Why HORO is different"
    },
    {
      "type": "text",
      "id": "col_proof",
      "label": "Column 3 header",
      "default": "Proof on site"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Primary CTA label",
      "default": "Shop the founding drop"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA label",
      "default": "Shop gifts"
    },
    {
      "type": "url",
      "id": "secondary_link",
      "label": "Secondary CTA link",
      "default": "/pages/gifts-hub"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "comparison_row",
      "name": "Comparison row",
      "settings": [
        {
          "type": "text",
          "id": "buyer_comparison",
          "label": "Buyer comparison",
          "default": "Cheap printed tee"
        },
        {
          "type": "textarea",
          "id": "horo_answer",
          "label": "HORO answer",
          "default": "Artist-made, story-led, and more meaningful to wear or gift."
        },
        {
          "type": "text",
          "id": "proof",
          "label": "Proof",
          "default": "Artist card, print close-up, story on PDP"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO Comparison FAQ",
      "blocks": [
        {
          "type": "comparison_row",
          "settings": {
            "buyer_comparison": "Cheap printed tee",
            "horo_answer": "Artist-made, story-led, and more meaningful to wear or gift.",
            "proof": "Artist process, print close-up, story on PDP"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "buyer_comparison": "Custom print shop",
            "horo_answer": "Curated art with a consistent HORO world — not upload-anything printing.",
            "proof": "Artist brief, licensed artwork, cohesive collections"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "buyer_comparison": "Fashion / hype brand",
            "horo_answer": "Less hype, more meaning — built for gifting and everyday wear.",
            "proof": "Gift route, size help, exchange policy, clean PDP proof"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "buyer_comparison": "Generic gift shop",
            "horo_answer": "Useful like clothing, personal like a message — recipient wears the feeling.",
            "proof": "Gift hub, occasion tags, delivery + COD clarity"
          }
        },
        {
          "type": "comparison_row",
          "settings": {
            "buyer_comparison": "Marketplace seller",
            "horo_answer": "Proof, service, and trust you can verify before you buy.",
            "proof": "Reviews/UGC, WhatsApp help, COD when shown at checkout"
          }
        }
      ]
    }
  ]
}
{% endschema %}
