{{ 'component-home-mockup.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<section
  id="size-help"
  class="home-section home-info-strip horo-section section-{{ section.id }}-padding"
  aria-label="{{ section.settings.aria_label | default: 'Service reassurance' | escape }}"
>
  <div class="home-info-strip__wrap">
    <div class="home-info-strip__grid">
      {%- for block in section.blocks -%}
        {%- if block.settings.title != blank -%}
          {%- liquid
            assign item_link = block.settings.link
            if item_link == blank and block.settings.icon == 'whatsapp'
              assign item_link = settings.horo_whatsapp_support_url
            endif
          -%}
          {%- if item_link != blank -%}
            <a
              href="{{ item_link }}"
              class="home-info-strip__item"
              {{ block.shopify_attributes }}
              {% if block.settings.icon == 'whatsapp' %}
                data-horo-home-event="whatsapp_click"
                data-horo-home-props='{"surface":"home_reassurance"}'
              {% endif %}
            >
          {%- else -%}
            <div class="home-info-strip__item" {{ block.shopify_attributes }}>
          {%- endif -%}
            <span class="home-info-strip__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'fit' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2 12 3.5 8 2 3.62 3.46 2 7.5l1.5 4.5L2 16.5l3.62 1.04L8 19.5l4-1.5 4 1.5 2.38-1.96L22 16.5l-1.5-4.5L22 7.5z"/></svg>
                {%- when 'delivery' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'exchange' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 0115-6.7L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 01-15 6.7L3 16"/><path d="M3 21v-5h5"/></svg>
                {%- when 'whatsapp' -%}
                  <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              {%- endcase -%}
            </span>
            <span>
              <h3>{{ block.settings.title | escape }}</h3>
              {%- if block.settings.body != blank -%}
                <p>{{ block.settings.body | escape }}</p>
              {%- endif -%}
            </span>
          {%- if item_link != blank -%}
            </a>
          {%- else -%}
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HORO Service Trust",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "aria_label",
      "label": "Accessible name",
      "default": "Service reassurance"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 60,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "fit", "label": "Fit guide" },
            { "value": "delivery", "label": "Delivery" },
            { "value": "exchange", "label": "Exchange" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ],
          "default": "fit"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Find your fit with confidence"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Clear size guide and model references on every product page."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO Service Trust",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "fit",
            "title": "Find your fit with confidence",
            "body": "Clear size guide and model references on every product page."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "delivery",
            "title": "Delivery across Egypt",
            "body": "Reliable delivery. Track your order from our studio to your door."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "exchange",
            "title": "Easy exchanges",
            "body": "Not the right fit? We've got you. Hassle-free size exchanges."
          }
        }
      ]
    }
  ]
}
{% endschema %}
