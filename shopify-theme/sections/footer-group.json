{
  "name": "HORO Footer Group",
  "type": "footer",
  "sections": {
    "horo-trust-ribbon": {
      "type": "horo-trust-ribbon",
      "settings": {
        "color_scheme": "scheme-2",
        "padding_top": 12,
        "padding_bottom": 12
      },
      "blocks": {
        "badge_1": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "artist",
            "label": "Original artist-made designs",
            "subtext": ""
          }
        },
        "badge_2": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "print",
            "label": "Printed locally in Egypt",
            "subtext": ""
          }
        },
        "badge_3": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "cash",
            "label": "Cash on delivery available",
            "subtext": ""
          }
        },
        "badge_4": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "exchange",
            "label": "14-day easy exchange",
            "subtext": ""
          }
        },
        "badge_5": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "whatsapp",
            "label": "WhatsApp support",
            "subtext": ""
          }
        }
