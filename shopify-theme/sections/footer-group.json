      "block_order": [
        "badge_1",
        "badge_2",
        "badge_3",
        "badge_4",
        "badge_5"
      ]
    },
    "horo-footer-mantra": {
      "type": "horo-footer-mantra",
      "settings": {
        "color_scheme": "scheme-3",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "footer": {
      "type": "footer",
      "blocks": {
        "footer-brand": {
          "type": "text",
          "settings": {
            "heading": "",
            "subtext": "<p>Artist-made clothing for feelings, moments, and meaningful giving in Egypt, backed by quality print, visible proof, and clear service.</p>"
          }
        },
        "footer-shop": {
          "type": "link_list",
          "settings": {
            "heading": "Shop",
            "menu": "horo-footer-shop"
          }
        },
        "footer-help": {
          "type": "link_list",
          "settings": {
            "heading": "Help",
            "menu": "horo-footer-help"
          }
        },
        "footer-contact": {
          "type": "link_list",
          "settings": {
            "heading": "Contact",
            "menu": "horo-footer-contact"
          }
        }
      },
      "block_order": [
        "footer-brand",
        "footer-shop",
        "footer-help",
        "footer-contact"
      ],
      "settings": {
        "color_scheme": "scheme-3",
        "newsletter_enable": true,
        "newsletter_heading": "Join the First Drop Circle",
        "show_social": true,
        "enable_country_selector": false,
        "enable_language_selector": false,
        "payment_enable": true,
        "show_policy": true,
        "margin_top": 0,
        "padding_top": 36,
        "padding_bottom": 36
      }
    }
