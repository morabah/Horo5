{{ 'component-product-artist-card.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign artist = product.metafields.custom.artist.value
  assign artist_display_text = product.metafields.custom.artist_display.value
  assign artist_name = ''
  if artist != blank
    assign artist_name = artist.name | default: artist.display_name
  endif
  if artist_name == blank
    assign artist_name = artist_display_text
  endif
  assign show_artist_section = false
  if artist != blank or artist_display_text != blank
    assign show_artist_section = true
  endif
-%}

{%- if show_artist_section or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="ArtistCard-{{ section.id }}"
    class="horo-section artist-card color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if artist_name != blank -%}
        {%- liquid
          assign initials = artist_name | truncate: 2, '' | upcase
        -%}

        <div class="artist-card__wrapper">
          {%- if section.settings.heading != blank -%}
            <h2 class="artist-card__heading {{ section.settings.heading_size }}">
              {{ section.settings.heading | escape }}
            </h2>
          {%- endif -%}

          <div class="artist-card__card">
            <div class="artist-card__media">
              {%- if artist != blank -%}
                {%- if artist.avatar != blank or artist.avatar_image != blank -%}
                {{
                  artist.avatar | default: artist.avatar_image
                  | image_url: width: 500
                  | image_tag:
                    loading: 'lazy',
                    widths: '150, 300, 500',
                    sizes: '(min-width: 750px) 220px, 120px',
                    alt: artist_name,
                    class: 'artist-card__image'
                }}
                {%- else -%}
                  <div class="artist-card__fallback" aria-hidden="true">
                    <span>{{ initials }}</span>
                  </div>
                {%- endif -%}
              {%- else -%}
                <div class="artist-card__fallback" aria-hidden="true">
                  <span>{{ initials }}</span>
                </div>
              {%- endif -%}
            </div>

            <div class="artist-card__content">
              <h3 class="artist-card__name h4">{{ artist_name | escape }}</h3>

              {%- if artist != blank -%}
                {%- if artist.style != blank -%}
                  <p class="artist-card__style">{{ artist.style | escape }}</p>
                {%- endif -%}

                {%- if artist.bio != blank -%}
                  <p class="artist-card__bio">{{ artist.bio | escape }}</p>
                {%- elsif artist.short_bio != blank -%}
                  <p class="artist-card__bio">{{ artist.short_bio | escape }}</p>
                {%- endif -%}

                {%- if artist.portfolio_url != blank or artist.profile_url != blank -%}
                  <a
                    href="{{ artist.portfolio_url | default: artist.profile_url }}"
                    class="artist-card__link link"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    View profile
                    <span aria-hidden="true"> &rarr;</span>
                  </a>
                {%- endif -%}
              {%- endif -%}
            </div>
          </div>
        </div>

      {%- elsif request.design_mode -%}
        <div class="artist-card__placeholder">
          <p>
            Add <code>custom.artist</code> and/or <code>custom.artist_display</code> to populate this artist card.
          </p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Artist Card",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "About the artist"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "HORO Artist Card"
    }
  ]
}
{% endschema %}
