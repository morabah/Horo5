{{ 'component-home-behind-the-piece.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div
  id="BehindThePiece-{{ section.id }}"
  class="horo-section home-behind-the-piece color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
>
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="home-behind-the-piece__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="home-behind-the-piece__heading {{ section.settings.heading_size }}">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <p class="home-behind-the-piece__body">{{ section.settings.body | escape }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="home-behind-the-piece__grid">
        {%- for block in section.blocks -%}
          <div
            class="home-behind-the-piece__card{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            {{ block.shopify_attributes }}
            data-reveal="stagger-1"
          >
            {%- if block.settings.title != blank -%}
              <h3 class="home-behind-the-piece__card-title">{{ block.settings.title | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.body != blank -%}
              <p class="home-behind-the-piece__card-body">{{ block.settings.body | escape }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- elsif request.design_mode -%}
      <div class="home-behind-the-piece__placeholder">
        <p>Add blocks to display the Behind the Piece section.</p>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORO Behind the Piece",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Process"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Behind the piece"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body text",
      "default": "Every HORO piece starts with a feeling, becomes artwork, and ends up on fabric you can actually wear."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Process card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Artwork direction"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Each design is developed from an emotion, not a trend board."
        }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "HORO Behind the Piece",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
