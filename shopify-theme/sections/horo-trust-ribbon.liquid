{{ 'component-horo-trust-ribbon.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.show_badge == true
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- if visible_count > 0 or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <div
    id="TrustRibbon-{{ section.id }}"
    class="horo-section horo-trust-ribbon color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
  >
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="horo-trust-ribbon__heading {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if visible_count > 0 -%}
        <ul class="horo-trust-ribbon__list" role="list">
          {%- for block in section.blocks -%}
            {%- if block.settings.show_badge == true -%}
              <li class="horo-trust-ribbon__item" role="listitem" {{ block.shopify_attributes }}>
                <span class="horo-trust-ribbon__icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'artist' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
                    {%- when 'print' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
                    {%- when 'cash' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    {%- when 'exchange' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M7 23l-4-4 4-4"/><path d="M21 5H10a4 4 0 0 0-4 4v1"/><path d="M3 19h11a4 4 0 0 0 4-4v-1"/></svg>
                    {%- when 'whatsapp' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    {%- when 'cotton' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 22h20"/><path d="M6 22V8l6-4 6 4v14"/><path d="M10 22v-6h4v6"/><path d="M14 8a2 2 0 0 1-4 0"/></svg>
                    {%- when 'delivery' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                  {%- endcase -%}
                </span>
                <span class="horo-trust-ribbon__text">
                  <span class="horo-trust-ribbon__label">{{ block.settings.label | escape }}</span>
                  {%- if block.settings.subtext != blank -%}
                    <span class="horo-trust-ribbon__subtext">{{ block.settings.subtext | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <div class="horo-trust-ribbon__placeholder">
          <p>Enable at least one trust badge block to display the ribbon.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Trust Ribbon",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. Leave blank for a clean minimal ribbon."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h2",
      "label": "Heading size"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 12
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_badge",
          "default": true,
          "label": "Show badge"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "artist", "label": "Artist" },
            { "value": "print", "label": "Print" },
            { "value": "cash", "label": "Cash" },
            { "value": "exchange", "label": "Exchange" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "cotton", "label": "Cotton" },
            { "value": "delivery", "label": "Delivery" }
          ],
          "default": "artist",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Original artist-made designs",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Short subtext",
          "info": "Optional. Appears below the label in muted text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO Trust Ribbon",
      "blocks": {
        "badge_1": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "artist",
            "label": "Original artist-made designs",
            "subtext": ""
          }
        },
        "badge_2": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "print",
            "label": "Printed locally in Egypt",
            "subtext": ""
          }
        },
        "badge_3": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "cash",
            "label": "Cash on delivery available",
            "subtext": ""
          }
        },
        "badge_4": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "exchange",
            "label": "14-day size exchange — terms apply",
            "subtext": ""
          }
        },
        "badge_5": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "whatsapp",
            "label": "WhatsApp support",
            "subtext": ""
          }
        }
      },
      "block_order": [
        "badge_1",
        "badge_2",
        "badge_3",
        "badge_4",
        "badge_5"
      ]
    }
  ]
}
{% endschema %}
