{{ 'component-home-mockup.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.show_badge == true
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  assign use_mockup = section.settings.use_home_mockup
-%}

{%- if visible_count > 0 or request.design_mode -%}
  <section
    id="TrustRibbon-{{ section.id }}"
    class="home-trust-bar section-padding-zero{% if use_mockup %} home-trust-bar--mockup{% else %} horo-trust-ribbon color-{{ section.settings.color_scheme }} gradient{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}"
    aria-label="Service promises"
  >
    <div class="home-trust-bar__inner{% if use_mockup %} home-page__inner{% endif %}">
      {%- if visible_count > 0 -%}
        <ul class="home-trust-bar__grid" role="list" style="--home-trust-columns: {{ visible_count }};">
          {%- for block in section.blocks -%}
            {%- if block.settings.show_badge == true -%}
              <li
                class="home-trust-bar__cell home-trust-bar__cell--{{ block.settings.icon }}"
                role="listitem"
                {{ block.shopify_attributes }}
              >
                <span class="home-trust-bar__icon" aria-hidden="true">
                  {% render 'horo-trust-icon', icon: block.settings.icon %}
                </span>
                <p class="home-trust-bar__label">{{ block.settings.label | escape }}</p>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- elsif request.design_mode -%}
        <p>Enable trust badge blocks.</p>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HORO Trust Ribbon",
  "tag": "section",
  "class": "section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "checkbox",
      "id": "use_home_mockup",
      "label": "Use homepage mockup bar",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme (legacy layout only)",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "checkbox",
          "id": "show_badge",
          "default": true,
          "label": "Show badge"
        },
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "artist", "label": "Artist-made" },
            { "value": "print", "label": "Printed in Egypt" },
            { "value": "clearFitDetails", "label": "Clear fit details" },
            { "value": "cash", "label": "Payment at checkout" },
            { "value": "exchange", "label": "Return policy" },
            { "value": "whatsapp", "label": "WhatsApp size help" }
          ],
          "default": "artist",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "label",
          "default": "Artist-made designs",
          "label": "Label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO Trust Ribbon",
      "blocks": {
        "badge_1": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "artist",
            "label": "Artist-made designs"
          }
        },
        "badge_2": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "print",
            "label": "Printed in Egypt"
          }
        },
        "badge_3": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "cash",
            "label": "Payment at checkout"
          }
        },
        "badge_4": {
          "type": "trust_badge",
          "settings": {
            "show_badge": false,
            "icon": "exchange",
            "label": ""
          }
        },
        "badge_5": {
          "type": "trust_badge",
          "settings": {
            "show_badge": true,
            "icon": "whatsapp",
            "label": "WhatsApp size help"
          }
        }
      },
      "block_order": ["badge_1", "badge_2", "badge_3", "badge_4", "badge_5"]
    }
  ]
}
{% endschema %}
