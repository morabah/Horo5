{{ 'component-product-delivery-payment.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for i in (1..5)
    assign show_key = 'show_card_' | append: i
    if section.settings[show_key] == true
      assign visible_count = visible_count | plus: 1
    endif
  endfor
  assign delivery_note = product.metafields.custom.delivery_note.value
  assign exchange_note = product.metafields.custom.exchange_note.value
  assign has_product_notes = false
  if delivery_note != blank or exchange_note != blank
    assign has_product_notes = true
  endif
-%}

{%- if visible_count > 0 or has_product_notes or request.design_mode -%}
  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .DeliveryPayment-{{ section.id }} {
      --delivery-payment-columns: {{ section.settings.columns_desktop }};
    }
  {%- endstyle -%}

  <div
    id="DeliveryPayment-{{ section.id }}"
    class="horo-section delivery-payment color-{{ section.settings.color_scheme }} gradient DeliveryPayment-{{ section.id }} section-{{ section.id }}-padding{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
  >
    <div class="page-width">
      {%- if visible_count > 0 or has_product_notes -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="delivery-payment__heading {{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </h2>
        {%- endif -%}

        {%- if visible_count > 0 -%}
        <ul class="delivery-payment__grid" role="list">
          {%- for i in (1..5) -%}
            {%- liquid
              assign show_key = 'show_card_' | append: i
              assign title_key = 'card_' | append: i | append: '_title'
              assign body_key = 'card_' | append: i | append: '_body'
              assign icon_key = 'card_' | append: i | append: '_icon'
            -%}
            {%- if section.settings[show_key] == true -%}
              <li class="delivery-payment__card" role="listitem">
                <div class="delivery-payment__icon" aria-hidden="true">
                  {%- case section.settings[icon_key] -%}
                    {%- when 'cash' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
                    {%- when 'bank' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18"/><path d="M5 21V7l8-5 8 5v14"/><path d="M9 21v-6h6v6"/></svg>
                    {%- when 'exchange' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 1l4 4-4 4"/><path d="M7 23l-4-4 4-4"/><path d="M21 5H10a4 4 0 0 0-4 4v1"/><path d="M3 19h11a4 4 0 0 0 4-4v-1"/></svg>
                    {%- when 'delivery' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                    {%- when 'support' -%}
                      <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                  {%- endcase -%}
                </div>
                <div class="delivery-payment__content">
                  {%- if section.settings[title_key] != blank -%}
                    <p class="delivery-payment__title">{{ section.settings[title_key] | escape }}</p>
                  {%- endif -%}
                  {%- if section.settings[body_key] != blank -%}
                    <p class="delivery-payment__body">{{ section.settings[body_key] | escape }}</p>
                  {%- endif -%}
                </div>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- endif -%}

        {%- if has_product_notes -%}
          <div class="delivery-payment__product-notes">
            {%- if delivery_note != blank -%}
              <p class="delivery-payment__product-note">{{ delivery_note | escape }}</p>
            {%- endif -%}
            {%- if exchange_note != blank -%}
              <p class="delivery-payment__product-note">{{ exchange_note | escape }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- elsif request.design_mode -%}
        <div class="delivery-payment__placeholder">
          <p>Enable at least one card in this section's settings to display delivery and payment information.</p>
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "HORO Delivery Payment",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Delivery & payment"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3,
      "label": "Columns on desktop"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Card 1"
    },
    {
      "type": "checkbox",
      "id": "show_card_1",
      "default": true,
      "label": "Show card 1"
    },
    {
      "type": "select",
      "id": "card_1_icon",
      "options": [
        { "value": "cash", "label": "Cash" },
        { "value": "bank", "label": "Bank" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "support", "label": "Support" }
      ],
      "default": "cash",
      "label": "Card 1 icon"
    },
    {
      "type": "text",
      "id": "card_1_title",
      "default": "Payment options shown at checkout",
      "label": "Card 1 title"
    },
    {
      "type": "text",
      "id": "card_1_body",
      "default": "Available at checkout",
      "label": "Card 1 body"
    },
    {
      "type": "header",
      "content": "Card 2"
    },
    {
      "type": "checkbox",
      "id": "show_card_2",
      "default": true,
      "label": "Show card 2"
    },
    {
      "type": "select",
      "id": "card_2_icon",
      "options": [
        { "value": "cash", "label": "Cash" },
        { "value": "bank", "label": "Bank" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "support", "label": "Support" }
      ],
      "default": "bank",
      "label": "Card 2 icon"
    },
    {
      "type": "text",
      "id": "card_2_title",
      "default": "Bank Transfer / Instapay",
      "label": "Card 2 title"
    },
    {
      "type": "text",
      "id": "card_2_body",
      "default": "Manual confirmation may be required",
      "label": "Card 2 body"
    },
    {
      "type": "header",
      "content": "Card 3"
    },
    {
      "type": "checkbox",
      "id": "show_card_3",
      "default": true,
      "label": "Show card 3"
    },
    {
      "type": "select",
      "id": "card_3_icon",
      "options": [
        { "value": "cash", "label": "Cash" },
        { "value": "bank", "label": "Bank" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "support", "label": "Support" }
      ],
      "default": "exchange",
      "label": "Card 3 icon"
    },
    {
      "type": "text",
      "id": "card_3_title",
      "default": "Exchange applies according to policy",
      "label": "Card 3 title"
    },
    {
      "type": "text",
      "id": "card_3_body",
      "default": "See policy for details",
      "label": "Card 3 body"
    },
    {
      "type": "header",
      "content": "Card 4"
    },
    {
      "type": "checkbox",
      "id": "show_card_4",
      "default": true,
      "label": "Show card 4"
    },
    {
      "type": "select",
      "id": "card_4_icon",
      "options": [
        { "value": "cash", "label": "Cash" },
        { "value": "bank", "label": "Bank" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "support", "label": "Support" }
      ],
      "default": "delivery",
      "label": "Card 4 icon"
    },
    {
      "type": "text",
      "id": "card_4_title",
      "default": "Delivery",
      "label": "Card 4 title"
    },
    {
      "type": "text",
      "id": "card_4_body",
