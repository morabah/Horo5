      "content": "Card 5"
    },
    {
      "type": "checkbox",
      "id": "show_card_5",
      "default": false,
      "label": "Show card 5"
    },
    {
      "type": "select",
      "id": "card_5_icon",
      "options": [
        { "value": "cash", "label": "Cash" },
        { "value": "bank", "label": "Bank" },
        { "value": "exchange", "label": "Exchange" },
        { "value": "delivery", "label": "Delivery" },
        { "value": "support", "label": "Support" }
      ],
      "default": "support",
      "label": "Card 5 icon"
    },
