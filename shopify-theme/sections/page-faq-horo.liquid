{{ 'component-horo-pages.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign visible_count = 0
  for block in section.blocks
    if block.settings.show == true and block.settings.question != blank
      assign visible_count = visible_count | plus: 1
    endif
  endfor
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width page-width--narrow section-{{ section.id }}-padding">
    {%- if section.settings.eyebrow != blank -%}
      <p class="horo-page__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}

    <h1 class="main-page-title page-title {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {{ section.settings.heading | escape }}
    </h1>

    {%- if section.settings.intro != blank -%}
      <p class="horo-page__intro">{{ section.settings.intro | escape }}</p>
    {%- endif -%}

    {%- if visible_count > 0 -%}
      <ul class="horo-faq__list" role="list">
        {%- for block in section.blocks -%}
          {%- if block.settings.show == true and block.settings.question != blank -%}
            <li role="listitem" {{ block.shopify_attributes }}>
              <details
                class="horo-faq__item"
                {% if section.settings.open_first_collapsible_row and forloop.first %}
                  open
                {% endif %}
              >
                <summary class="horo-faq__summary">
                  <h3 class="horo-faq__question">{{ block.settings.question | escape }}</h3>
                  <span class="horo-faq__icon" aria-hidden="true">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
                  </span>
                </summary>
                <div class="horo-faq__answer rte">
                  {{ block.settings.answer }}
                </div>
              </details>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- elsif request.design_mode -%}
      <div class="horo-page__placeholder">
        <p>Enable at least one FAQ item to display the FAQ section.</p>
      </div>
    {%- endif -%}

    {%- if section.settings.show_support_cta -%}
      <div class="horo-faq__support">
        {%- if section.settings.support_heading != blank -%}
          <h2 class="horo-faq__support-heading">{{ section.settings.support_heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.support_text != blank -%}
          <p class="horo-faq__support-text">{{ section.settings.support_text | escape }}</p>
        {%- endif -%}
        {%- if section.settings.support_button_link != blank and section.settings.support_button_label != blank -%}
          <a
            href="{{ section.settings.support_button_link }}"
            class="button button--secondary"
          >
            {{ section.settings.support_button_label | escape }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "HORO FAQ Page",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Help",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "FAQ",
      "label": "Heading"
    },
    {
      "type": "textarea",
      "id": "intro",
      "default": "Quick answers for first orders, delivery, payment, exchanges, and support.",
      "label": "Intro text"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h0",
      "label": "Heading size"
    },
    {
      "type": "checkbox",
      "id": "open_first_collapsible_row",
      "default": false,
      "label": "Open first FAQ by default"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Support CTA"
    },
    {
      "type": "checkbox",
      "id": "show_support_cta",
      "default": true,
      "label": "Show support CTA"
    },
    {
      "type": "text",
      "id": "support_heading",
      "default": "Still need help?",
      "label": "Support heading"
    },
    {
      "type": "textarea",
      "id": "support_text",
      "default": "Message us on WhatsApp and include your order number if your question is about an existing order.",
      "label": "Support text"
    },
    {
      "type": "text",
      "id": "support_button_label",
      "default": "Contact us",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "support_button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "FAQ item",
      "settings": [
        {
          "type": "checkbox",
          "id": "show",
          "default": true,
          "label": "Show item"
        },
        {
          "type": "text",
          "id": "question",
          "default": "What is HORO?",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "<p>HORO is a wearable art brand based in Egypt. We create designs around feelings, identity, moments, and meaningful gifts — turning emotional territory into clothing you can wear and share.</p>",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HORO FAQ Page",
      "blocks": {
        "faq-0": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "What is HORO?",
            "answer": "<p>HORO is a wearable art brand based in Egypt. We create designs around feelings, identity, moments, and meaningful gifts — turning emotional territory into clothing you can wear and share.</p>"
          }
        },
        "faq-1": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "How do I choose my size?",
            "answer": "<p>Each product page includes a size guide with measurements in centimeters. Compare the measurements to a shirt you already own. If you are between sizes, we recommend sizing up.</p>"
          }
        },
        "faq-2": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "Can I pay cash on delivery?",
            "answer": "<p>COD when shown at checkout — you will see it as a payment option only if your address and order qualify. Other payment methods may also appear when enabled.</p>"
          }
        },
        "faq-3": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "Can I exchange a product?",
            "answer": "<p>We accept exchanges within 14 days of delivery, provided the item is unworn, unwashed, and in original packaging. See our exchange policy page for full details.</p>"
          }
        },
        "faq-4": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "How long does delivery take?",
            "answer": "<p>Delivery timing depends on your governorate and is confirmed at checkout. Cairo/Giza orders usually show the fastest estimate when local delivery is available. You will receive tracking information once your order ships.</p>"
          }
        },
        "faq-5": {
          "type": "faq_item",
          "settings": {
            "show": true,
            "question": "How does gift wrapping work?",
            "answer": "<p>You can add gift wrapping to eligible products from the product page. The gift wrap option appears near the add-to-cart button. Gift wrap is added as a separate item in your cart and can be removed at any time.</p>"
          }
        }
      },
      "block_order": [
        "faq-0",
        "faq-1",
        "faq-2",
        "faq-3",
        "faq-4",
        "faq-5"
      ]
    }
  ]
}
{% endschema %}
