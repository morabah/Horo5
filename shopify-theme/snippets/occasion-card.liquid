<!-- HORO: Occasion card for metaobject entries -->
{%- liquid
  assign occasion = card
  assign occasion_handle = occasion.handle | default: occasion.slug | default: ''
  assign occasion_label = occasion.title | default: occasion.name | default: occasion.display_name | default: 'Occasion'
  assign card_url = routes.collections_url | append: '/occasion-' | append: occasion_handle
  assign image_width = 1100
-%}

<li class="home-occasion-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem">
  <a href="{{ card_url }}" class="home-occasion-grid__card" aria-label="{{ occasion_label | escape }}">
    <div class="home-occasion-grid__media media media--transparent">
      {%- if occasion.card_image != blank -%}
        {{
          occasion.card_image
          | image_url: width: image_width
          | image_tag:
            loading: 'lazy',
            widths: '275, 550, 750, 1100',
            sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)',
            alt: occasion_label,
            class: 'home-occasion-grid__image'
        }}
      {%- else -%}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="home-occasion-grid__content">
      <h3 class="home-occasion-grid__name h4">{{ occasion.title | default: occasion.name | default: occasion.display_name }}</h3>
      {%- if occasion.description != blank or occasion.blurb != blank -%}
        <p class="home-occasion-grid__blurb">{{ occasion.description | default: occasion.blurb }}</p>
      {%- endif -%}
      {%- if occasion.price_hint != blank -%}
        <p class="home-occasion-grid__price-hint">{{ occasion.price_hint }}</p>
      {%- endif -%}
    </div>
  </a>
</li>
