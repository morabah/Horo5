{%- comment -%}
  Homepage / PLP card image — parity with web-next pickHomeCardImageSrc.
  Params:
    card_product (required)
    loading — lazy | eager (default lazy)
    sizes — responsive sizes attribute
    image_class — class on img
    placeholder_class — class on placeholder svg
{%- endcomment -%}
{%- liquid
  assign loading_value = loading | default: 'lazy'
  assign sizes_value = sizes | default: '(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 240px'
  assign image_class = image_class | default: 'home-founding-card__image'
  assign placeholder_class = placeholder_class | default: 'placeholder-svg home-founding-card__placeholder'

  assign card_image = nil
  assign preferred_image = nil
  assign fallback_image = nil

  for image in card_product.images
    assign alt_lower = image.alt | default: '' | downcase
    assign src_probe = image | image_url: width: 80 | downcase
    assign is_unsafe = false

    if alt_lower contains 'back' or alt_lower contains 'rear' or alt_lower contains 'flat_lay' or alt_lower contains 'flat-lay'
      assign is_unsafe = true
    endif
    if src_probe contains '/back' or src_probe contains '-back' or src_probe contains '_back' or src_probe contains 'flat_lay' or src_probe contains 'flat-lay'
      assign is_unsafe = true
    endif

    unless is_unsafe
      if alt_lower contains 'front' or alt_lower contains 'design' or alt_lower contains 'graphic' or alt_lower contains 'print' or alt_lower contains 'artwork'
        assign preferred_image = image
        break
      endif

      if fallback_image == nil
        assign fallback_image = image
      endif
    endunless
  endfor

  if preferred_image != nil
    assign card_image = preferred_image
  elsif fallback_image != nil
    assign card_image = fallback_image
  endif

  if card_image == nil and card_product.featured_media
    if card_product.featured_media.media_type == 'image'
      assign featured_probe = card_product.featured_media | image_url: width: 80 | downcase
      assign featured_alt = card_product.featured_media.alt | default: '' | downcase
      assign featured_unsafe = false
      if featured_alt contains 'back' or featured_alt contains 'rear' or featured_alt contains 'flat_lay' or featured_alt contains 'flat-lay'
        assign featured_unsafe = true
      endif
      if featured_probe contains '/back' or featured_probe contains '-back' or featured_probe contains '_back' or featured_probe contains 'flat_lay' or featured_probe contains 'flat-lay'
        assign featured_unsafe = true
      endif
      unless featured_unsafe
        assign card_image = card_product.featured_media
      endunless
    endif
  endif

  if card_image == nil and card_product.featured_image
    assign card_image = card_product.featured_image
  endif
-%}

{%- if card_image -%}
  {{
    card_image
    | image_url: width: 1200
    | image_tag:
      loading: loading_value,
      widths: '200, 400, 600, 800, 1200',
      sizes: sizes_value,
      alt: card_image.alt | default: card_product.title,
      class: image_class
  }}
{%- else -%}
  {{ 'product-apparel-1' | placeholder_svg_tag: placeholder_class }}
{%- endif -%}
