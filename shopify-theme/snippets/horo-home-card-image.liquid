{%- comment -%}
  Homepage / PLP card image — parity with web-next pickHomeCardImageSrc + preferHomeCardDisplaySrc.
  Front artwork first; lifestyle second; never back / flat_lay on cards.
  Fallback: metafield custom.homepage_reference_image → theme asset by handle → placeholder.
{%- endcomment -%}
{%- liquid
  assign loading_value = loading | default: 'lazy'
  assign sizes_value = sizes | default: '(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 240px'
  assign image_class = image_class | default: 'home-founding-card__image'
  assign placeholder_class = placeholder_class | default: 'placeholder-svg home-founding-card__placeholder'

  assign card_image = nil
  assign best_score = -1

  for image in card_product.images
    assign alt_lower = image.alt | default: '' | downcase
    assign src_probe = image | image_url: width: 80 | downcase
    assign is_unsafe = false

    if alt_lower contains 'back' or alt_lower contains 'rear' or alt_lower contains 'flat_lay' or alt_lower contains 'flat-lay' or alt_lower contains 'flat lay'
      assign is_unsafe = true
    endif
    if src_probe contains '/back' or src_probe contains '-back' or src_probe contains '_back' or src_probe contains 'backview' or src_probe contains 'back-view' or src_probe contains 'flat_lay' or src_probe contains 'flat-lay'
      assign is_unsafe = true
    endif

    unless is_unsafe
      assign score = 10

      if alt_lower contains 'front' or alt_lower contains 'design' or alt_lower contains 'graphic' or alt_lower contains 'print' or alt_lower contains 'artwork'
        assign score = 100
      elsif alt_lower contains 'lifestyle' or alt_lower contains 'fit' or alt_lower contains 'model' or alt_lower contains 'worn'
        assign score = 80
      elsif alt_lower contains 'detail' or alt_lower contains 'close'
        assign score = 60
      endif

      if score > best_score
        assign card_image = image
        assign best_score = score
      endif
    endunless
  endfor

  if card_image == nil and card_product.featured_media
    if card_product.featured_media.media_type == 'image'
      assign featured_probe = card_product.featured_media | image_url: width: 80 | downcase
      assign featured_alt = card_product.featured_media.alt | default: '' | downcase
      assign featured_unsafe = false
      if featured_alt contains 'back' or featured_alt contains 'rear' or featured_alt contains 'flat_lay' or featured_alt contains 'flat-lay'
        assign featured_unsafe = true
      endif
      if featured_probe contains '/back' or featured_probe contains '-back' or featured_probe contains '_back' or featured_probe contains 'flat_lay' or featured_probe contains 'flat-lay' or featured_probe contains 'backview' or featured_probe contains 'back-view'
        assign featured_unsafe = true
      endif
      unless featured_unsafe
        if featured_alt contains 'front' or featured_alt contains 'design' or featured_alt contains 'graphic' or featured_alt contains 'artwork'
          assign card_image = card_product.featured_media
        endif
      endunless
    endif
  endif

  if card_image == nil
    assign ref_metafield = card_product.metafields.custom.homepage_reference_image
    if ref_metafield != blank and ref_metafield.value != blank
      assign card_image = ref_metafield.value
    endif
  endif

  if card_image == nil
    case card_product.handle
      when 'i-care'
        assign reference_asset = 'homepage-reference-i-care.png'
      when 'i-dont-care'
        assign reference_asset = 'homepage-reference-i-dont-care.png'
      when 'walk-alone'
        assign reference_asset = 'homepage-reference-walk-alone.png'
      when 'find-your-rhythm'
        assign reference_asset = 'homepage-reference-find-your-rhythm.png'
      when 'rest-your-mind'
        assign reference_asset = 'homepage-reference-rest-your-mind.png'
    endcase
    if reference_asset != blank
      assign reference_url = reference_asset | asset_url
      if reference_url != blank
        assign card_image = reference_url
      endif
    endif
  endif
-%}

{%- if card_image -%}
  {%- if card_image.media_type -%}
    {{
      card_image
      | image_url: width: 1200
      | image_tag:
        loading: loading_value,
        widths: '200, 400, 600, 800, 1200',
        sizes: sizes_value,
        alt: card_image.alt | default: card_product.title,
        class: image_class
    }}
  {%- else -%}
    <img
      src="{{ card_image }}"
      alt="{{ card_product.title | escape }}"
      loading="{{ loading_value }}"
      class="{{ image_class }}"
      width="600"
      height="750"
    >
  {%- endif -%}
{%- else -%}
  {{ 'product-apparel-1' | placeholder_svg_tag: placeholder_class }}
{%- endif -%}
