{%- comment -%}
  HORO Header Wishlist Icon
  Shows a heart icon with a badge count from localStorage.
  Uses the same storage key as horo-wishlist.js for parity.
{%- endcomment -%}

<a
  href="{{ routes.root_url }}pages/wishlist"
  class="header__icon header__icon--wishlist link focus-inset"
  aria-label="{{ 'horo.wishlist.title' | t | default: 'Wishlist' }}"
>
  <span class="svg-wrapper">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path>
    </svg>
  </span>
  <span class="visually-hidden">{{ 'horo.wishlist.title' | t | default: 'Wishlist' }}</span>
  <span
    class="wishlist-count-bubble"
    data-horo-wishlist-badge
  ></span>
</a>
