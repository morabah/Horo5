{%- comment -%}
  Renders proof strip list items for a product (HORO data contract).
  1. custom.proof_gallery metaobject list
  2. Else media alt-tag scan
  3. Else branded SVG fallbacks (web-next pdpProof parity)
  Accepts: product (required)
{%- endcomment -%}
{%- liquid
  assign proof_tags = 'proof_fabric,proof_print,proof_wash,lifestyle,flat_lay' | split: ','
  assign proof_gallery = product.metafields.custom.proof_gallery.value
  assign rendered_any = false
  assign is_ar = false
  if request.locale.iso_code == 'ar'
    assign is_ar = true
  endif
-%}

{%- if proof_gallery != blank -%}
  {%- for proof_item in proof_gallery -%}
    {%- assign proof_image = proof_item.image -%}
    {%- assign proof_label = proof_item.label | default: proof_item.tag | replace: '_', ' ' | capitalize -%}
    {%- assign proof_caption = proof_item.caption -%}
    {%- if proof_image != blank -%}
      {%- assign rendered_any = true -%}
      {%- assign proof_alt = proof_label | default: 'Product detail' | append: ' for ' | append: product.title -%}
      <li class="product-proof-strip__item" role="listitem">
        <div class="product-proof-strip__media">
          {{
            proof_image
            | image_url: width: 600
            | image_tag:
              loading: 'lazy',
              widths: '200, 400, 600',
              sizes: '(min-width: 750px) 200px, 33vw',
              alt: proof_alt,
              class: 'product-proof-strip__image'
          }}
        </div>
        {%- if proof_label != blank -%}
          <span class="product-proof-strip__label">{{ proof_label | escape }}</span>
        {%- endif -%}
        {%- if proof_caption != blank -%}
          <span class="product-proof-strip__caption">{{ proof_caption | escape }}</span>
        {%- endif -%}
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- else -%}
  {%- for media in product.media -%}
    {%- assign alt_lower = media.alt | downcase -%}
    {%- for tag in proof_tags -%}
      {%- if alt_lower contains tag -%}
        {%- assign rendered_any = true -%}
        {%- assign tag_label = tag | replace: '_', ' ' | capitalize -%}
        {%- assign proof_alt = tag_label | append: ' detail for ' | append: product.title -%}
        <li class="product-proof-strip__item" role="listitem">
          <div class="product-proof-strip__media">
            {{
              media
              | image_url: width: 600
              | image_tag:
                loading: 'lazy',
                widths: '200, 400, 600',
                sizes: '(min-width: 750px) 200px, 33vw',
                alt: proof_alt,
                class: 'product-proof-strip__image'
            }}
          </div>
          <span class="product-proof-strip__label">{{ tag_label | escape }}</span>
        </li>
        {%- break -%}
      {%- endif -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endif -%}

{%- unless rendered_any -%}
  {%- liquid
    if is_ar
      assign fallback_items = 'proof_print:تفاصيل الطباعة|proof_fabric:تفاصيل القماش|proof_wash:اختبار الغسيل' | split: '|'
    else
      assign fallback_items = 'proof_print:Print detail|proof_fabric:Fabric close-up|proof_wash:Wash proof' | split: '|'
    endif
  -%}
  {%- for item in fallback_items -%}
    {%- assign parts = item | split: ':' -%}
    {%- assign fallback_tag = parts[0] -%}
    {%- assign fallback_label = parts[1] -%}
    {%- assign fallback_asset = 'macro-detail-card.svg' -%}
    {%- if fallback_tag == 'proof_fabric' -%}
      {%- assign fallback_asset = 'fabric-tag-card.svg' -%}
    {%- elsif fallback_tag == 'proof_wash' -%}
      {%- assign fallback_asset = 'wash-test-card.svg' -%}
    {%- endif -%}
    <li class="product-proof-strip__item product-proof-strip__item--fallback" role="listitem">
      <div class="product-proof-strip__media">
        <img
          src="{{ fallback_asset | asset_url }}"
          alt="{{ fallback_label | escape }} — {{ product.title | escape }}"
          width="600"
          height="450"
          loading="lazy"
          class="product-proof-strip__image product-proof-strip__image--fallback"
        >
      </div>
      <span class="product-proof-strip__label">{{ fallback_label | escape }}</span>
    </li>
  {%- endfor -%}
{%- endunless -%}
