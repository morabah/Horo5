{%- comment -%}
  HORO Customer Account Brand Surface
  Wraps customer account pages (login, register, account, order) with
  brand-consistent typography, colors, and layout.
  Usage: place at the top of customer-related templates.
{%- endcomment -%}

<div class="horo-account-surface page-width">
  <div class="horo-account-surface__header">
    <a href="{{ routes.root_url }}" class="horo-account-surface__logo" aria-label="{{ shop.name }}">
      {% render 'horo-brand-logo', variant: 'dark', show_arabic: false, size: 'footer' %}
    </a>
    <p class="horo-account-surface__mantra font-wordmark">{{ 'horo.brand.mantra' | t }}</p>
  </div>

  <div class="horo-account-surface__content">
    {{ content }}
  </div>
</div>
