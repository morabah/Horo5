{%- comment -%}
  Default homepage feeling tiles when metaobjects or collections are not seeded yet.
  Launch taxonomy: Zodiac / Mood / Lifestyle / Gift Ready.
{%- endcomment -%}
{%- liquid
  assign limit = feeling_limit | default: 4
  assign fallback_slugs = 'zodiac,mood,lifestyle,gift' | split: ','
  assign fallback_labels = 'Zodiac Signs,Mood,Lifestyle,For Someone' | split: ','
  assign fallback_subtitles = '12 designs,Feelings you wear,Daily pieces,Gifting' | split: ','
  assign surfaces = '#f8eaea,#f4ede5,#edf1ea,#f5eef3' | split: ','
-%}

<ul class="home-feeling-pastel-grid home-feeling-pastel-grid--meaning" role="list">
  {%- for slug in fallback_slugs -%}
    {%- if forloop.index0 >= limit -%}
      {%- break -%}
    {%- endif -%}
    {%- assign label = fallback_labels[forloop.index0] -%}
    {%- assign subtitle = fallback_subtitles[forloop.index0] -%}
    {%- assign surface_index = forloop.index0 | modulo: 4 -%}
    {%- assign surface_color = surfaces[surface_index] -%}
    {%- assign card_url = '/collections/founding-drop' -%}
    {%- if slug == 'zodiac' -%}
      {%- assign zodiac_collection = collections['zodiac'] -%}
      {%- if zodiac_collection != blank -%}
        {%- assign card_url = zodiac_collection.url -%}
      {%- else -%}
        {%- assign feeling_zodiac = collections['feeling-zodiac'] -%}
        {%- if feeling_zodiac != blank -%}
          {%- assign card_url = feeling_zodiac.url -%}
        {%- endif -%}
      {%- endif -%}
    {%- elsif slug == 'mood' or slug == 'lifestyle' -%}
      {%- assign mood_lifestyle = collections['mood-lifestyle'] -%}
      {%- if mood_lifestyle != blank -%}
        {%- assign card_url = mood_lifestyle.url -%}
      {%- endif -%}
    {%- elsif slug == 'gift' -%}
      {%- assign gift_collection = collections['gift-ready'] -%}
      {%- if gift_collection != blank -%}
        {%- assign card_url = gift_collection.url -%}
      {%- else -%}
        {%- assign card_url = '/pages/gifts-hub' -%}
      {%- endif -%}
    {%- endif -%}
    <li class="home-feeling-pastel-grid__item" role="listitem">
      <a
        href="{{ card_url }}"
        class="home-feeling-pastel-tile"
        style="background-color: {{ surface_color }};"
        aria-label="{{ label | escape }}"
        data-horo-home-event="category_card_click"
        data-horo-home-props='{"category":{{ slug | json }}}'
      >
        {% render 'feeling-tile-icon', slug: slug %}
        <span class="home-feeling-pastel-tile__label">{{ label | escape }}</span>
        {%- if subtitle != blank -%}
          <span class="home-feeling-pastel-tile__subtitle">{{ subtitle | escape }}</span>
        {%- endif -%}
      </a>
    </li>
  {%- endfor -%}
</ul>
