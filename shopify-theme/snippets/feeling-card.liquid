<!-- HORO: Feeling card for metaobject entries -->
{%- liquid
  assign feeling = card
  assign feeling_handle = feeling.handle | default: feeling.slug | default: ''
  assign card_url = '/collections/feeling-' | append: feeling_handle
  assign image_width = 1100
-%}

<li class="home-feeling-grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" role="listitem">
  <a href="{{ card_url }}" class="home-feeling-grid__card" aria-label="{{ feeling.title | default: feeling.name | default: feeling.display_name | escape }}">
    <div class="home-feeling-grid__media media media--transparent">
      {%- if feeling.card_image != blank -%}
        {{
          feeling.card_image
          | image_url: width: image_width
          | image_tag:
            loading: 'lazy',
            widths: '275, 550, 750, 1100',
            sizes: '(min-width: 990px) calc((100vw - 10rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)',
            class: 'home-feeling-grid__image'
        }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="home-feeling-grid__content">
      <h3 class="home-feeling-grid__name h4">{{ feeling.title | default: feeling.name | default: feeling.display_name }}</h3>
      {%- if feeling.description != blank or feeling.blurb != blank -%}
        <p class="home-feeling-grid__blurb">{{ feeling.description | default: feeling.blurb }}</p>
      {%- endif -%}
    </div>
  </a>
</li>
