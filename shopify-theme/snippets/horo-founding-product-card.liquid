{%- comment -%}
  HORO founding drop card — parity with web-next HomeFoundingProductCard.
  Accepts: card_product, card_variant (optional; parent should pass resolved variant), lazy_load, section_id, choose_size_label
  Variant pick (when card_variant omitted): prefer available M, else first available, else selected_or_first_available — keep in sync with home-founding-drop.liquid.
{%- endcomment -%}
{%- liquid
  assign cta_choose_size = choose_size_label | default: 'Choose size'
  if request.locale.iso_code == 'ar'
    assign cta_choose_size = 'اختر المقاس'
  endif

  if lazy_load == nil
    assign lazy_load = true
  endif

  assign loading_value = 'lazy'
  if lazy_load == false
    assign loading_value = 'eager'
  endif

  if card_variant != blank
    assign selected_variant = card_variant
  else
    assign selected_variant = nil
    assign first_available = nil

    for variant in card_product.variants
      if variant.available
        if first_available == nil
          assign first_available = variant
        endif
        if variant.option1 == 'M' or variant.option2 == 'M' or variant.option3 == 'M'
          assign selected_variant = variant
          break
        endif
      endif
    endfor

    if selected_variant == nil
      assign selected_variant = first_available | default: card_product.selected_or_first_available_variant
    endif
  endif

  assign price_cents = selected_variant.price | default: card_product.price | default: 0
  if price_cents <= 0
    assign skip_card = true
  else
    assign skip_card = false
  endif

  assign needs_size_choice = true
  if card_product.has_only_default_variant
    assign needs_size_choice = false
  endif

  assign can_add = false
  if selected_variant and selected_variant.available and needs_size_choice == false
    assign can_add = true
  endif

  assign price_display = price_cents
  assign price_egp = price_display | money_with_currency

  assign product_form_id = 'founding-' | append: section_id | append: '-' | append: card_product.id

  assign launch_group = card_product.metafields.custom.launch_group.value | default: ''
  assign launch_audience = card_product.metafields.custom.launch_audience.value | default: ''
  assign launch_design = card_product.metafields.custom.launch_design.value | default: ''
  assign zodiac_sign = card_product.metafields.custom.zodiac_sign.value | default: ''

  for tag in card_product.tags
    assign tag_lower = tag | downcase
    if tag_lower contains 'launch:'
      assign launch_group = tag_lower | remove: 'launch:' | strip
    elsif tag_lower contains 'audience:'
      assign launch_audience = tag_lower | remove: 'audience:' | strip
    elsif tag_lower contains 'design:'
      assign launch_design = tag_lower | remove: 'design:' | strip
    elsif tag_lower contains 'zodiac:'
      assign zodiac_sign = tag_lower | remove: 'zodiac:' | strip
    endif
  endfor

  assign eyebrow_parts = ''
  assign design_label = launch_design
  if zodiac_sign != blank
    assign design_label = zodiac_sign
  endif
  if design_label == 'gemini'
    assign design_label = 'Gemini'
  elsif design_label == 'cancer'
    assign design_label = 'Cancer'
  elsif design_label == 'leo'
    assign design_label = 'Leo'
  elsif design_label == 'virgo'
    assign design_label = 'Virgo'
  elsif design_label == 'i-care'
    assign design_label = 'I Care'
  elsif design_label == 'i-dont-care'
    assign design_label = "I Don't Care"
  elsif design_label == 'walk-alone'
    assign design_label = 'Walk Alone'
  endif

  assign group_label = ''
  if launch_group == 'zodiac_capsule'
    assign group_label = 'Zodiac Signs'
  elsif launch_group == 'mood'
    assign group_label = 'Mood'
  elsif launch_group == 'lifestyle'
    assign group_label = 'Lifestyle'
  endif

  assign audience_label = ''
  if launch_audience == 'women'
    assign audience_label = 'Women'
  elsif launch_audience == 'men'
    assign audience_label = 'Men'
  elsif launch_audience == 'unisex'
    assign audience_label = 'Unisex'
  endif

  if design_label != blank
    assign eyebrow_parts = design_label
  endif
  if group_label != blank
    if eyebrow_parts != blank
      assign eyebrow_parts = eyebrow_parts | append: ' · ' | append: group_label
    else
      assign eyebrow_parts = group_label
    endif
  endif
  if audience_label != blank
    if eyebrow_parts != blank
      assign eyebrow_parts = eyebrow_parts | append: ' · ' | append: audience_label
    else
      assign eyebrow_parts = audience_label
    endif
  endif

  assign card_image = nil
  for image in card_product.images
    assign alt_lower = image.alt | default: '' | downcase
    if alt_lower contains 'front' or alt_lower contains 'design' or alt_lower contains 'graphic' or alt_lower contains 'print'
      assign card_image = image
      break
    endif
  endfor
  if card_image == nil
    for image in card_product.images
      assign alt_lower = image.alt | default: '' | downcase
      unless alt_lower contains 'back' or alt_lower contains 'rear'
        assign card_image = image
        break
      endunless
    endfor
  endif

  if card_image == nil and card_product.featured_media
    if card_product.featured_media.media_type == 'image'
      assign card_image = card_product.featured_media
    elsif card_product.featured_media.preview_image
      assign card_image = card_product.featured_media.preview_image
    endif
  endif
  if card_image == nil and card_product.featured_image
    assign card_image = card_product.featured_image
  endif
  if card_image == nil and card_product.images.size > 0
    assign card_image = card_product.images.first
  endif
-%}

{%- unless skip_card -%}
<article class="home-founding-card">
  <a
    href="{{ card_product.url }}"
    class="home-founding-card__media"
    aria-label="{{ card_product.title | escape }}"
    data-horo-home-event="product_card_click"
    data-horo-home-props='{"product_handle":{{ card_product.handle | json }}}'
  >
    {%- if card_image -%}
      {{
        card_image
        | image_url: width: 1200
        | image_tag:
          loading: loading_value,
          widths: '200, 400, 600, 800, 1200',
          sizes: '(max-width: 640px) 46vw, (max-width: 1100px) 30vw, 240px',
          alt: card_image.alt | default: card_product.title,
          class: 'home-founding-card__image'
      }}
    {%- else -%}
      {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg home-founding-card__placeholder' }}
    {%- endif -%}
  </a>
  <div class="home-founding-card__body">
    {%- if eyebrow_parts != blank -%}
      <p class="home-founding-card__eyebrow">{{ eyebrow_parts | escape }}</p>
    {%- endif -%}
    <a
      href="{{ card_product.url }}"
      class="home-founding-card__title"
      data-horo-home-event="product_card_click"
      data-horo-home-props='{"product_handle":{{ card_product.handle | json }}}'
    >
      {{ card_product.title | escape }}
    </a>
    <p class="home-founding-card__price">{{ price_egp }}</p>
    <div class="home-founding-card__actions">
      {%- if needs_size_choice -%}
        <a
          href="{{ card_product.url }}"
          class="home-founding-card__cta home-founding-card__cta--link"
          data-horo-home-event="choose_size_click"
          data-horo-home-props='{"product_handle":{{ card_product.handle | json }}}'
        >
          <span class="home-founding-card__cta-label">{{ cta_choose_size | escape }}</span>
          <span class="home-founding-card__cta-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </span>
        </a>
      {%- elsif can_add -%}
        <product-form data-section-id="{{ section_id }}" data-hide-errors="true">
          {%- form 'product',
            card_product,
            id: product_form_id,
            class: 'home-founding-card__form',
            novalidate: 'novalidate',
            data-type: 'add-to-cart-form'
          -%}
            <input type="hidden" name="id" value="{{ selected_variant.id }}" class="product-variant-id">
            <button
              type="submit"
              name="add"
              class="home-founding-card__cta"
              aria-haspopup="dialog"
              aria-label="{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}: {{ card_product.title | escape }}"
              data-horo-home-event="add_to_cart_click"
              data-horo-home-props='{"product_handle":{{ card_product.handle | json }}}'
            >
              <span class="home-founding-card__cta-label">{{ 'products.product.add_to_cart' | t | default: 'Add to cart' }}</span>
              <span class="home-founding-card__cta-icon" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
              </span>
              {%- render 'loading-spinner' -%}
            </button>
          {%- endform -%}
        </product-form>
      {%- else -%}
        <a
          href="{{ card_product.url }}"
          class="home-founding-card__cta home-founding-card__cta--link"
          data-horo-home-event="product_card_click"
          data-horo-home-props='{"product_handle":{{ card_product.handle | json }}}'
        >
          <span class="home-founding-card__cta-label">{{ 'products.product.view_full_details' | t | default: 'View piece' }}</span>
          <span class="home-founding-card__cta-icon" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 01-8 0"/></svg>
          </span>
        </a>
      {%- endif -%}
    </div>
  </div>
</article>
{%- endunless -%}
