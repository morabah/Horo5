{%- comment -%}
  Single launch nav link — shared by fallback nav and backfill after menu sanitization.
  Params: route_key, nav_active_path, link_style ('primary' | 'drawer')
{%- endcomment -%}
{%- liquid
  assign about_url = routes.root_url | append: 'pages/about-horo'
  assign founding_drop_url = routes.collections_url | append: '/founding-drop'
  assign link_style = link_style | default: 'primary'

  case route_key
    when 'home'
      assign label = 'horo.shell.home' | t | default: 'Home'
      assign href = routes.root_url
    when 'founding_drop'
      assign label = 'horo.nav.founding_drop' | t | default: 'Shop All'
      assign href = founding_drop_url
    when 'shop_by_meaning'
      assign label = 'horo.nav.shop_by_feeling' | t | default: 'Shop by Feeling'
      assign href = routes.root_url | append: '#shop-by-meaning'
    when 'gifts'
      assign label = 'horo.nav.gifts' | t | default: 'Gifts'
      assign href = routes.root_url | append: 'pages/gifts-hub'
    when 'zodiac'
      assign label = 'horo.nav.zodiac_signs' | t | default: 'Zodiac'
      assign zodiac_collection = collections['zodiac']
      if zodiac_collection != blank
        assign href = zodiac_collection.url
      else
        assign href = routes.collections_url | append: '/zodiac'
      endif
    when 'career'
      assign label = 'horo.nav.career' | t | default: 'Career & Work'
      assign career_collection = collections['career']
      if career_collection != blank
        assign href = career_collection.url
      else
        assign href = routes.collections_url | append: '/career'
      endif
    when 'about'
      assign label = 'horo.nav.our_story' | t | default: 'Our Story'
      assign href = about_url
    when 'size_guide'
      assign label = 'horo.nav.size_help' | t | default: 'Size Guide'
      assign href = routes.root_url | append: 'pages/size-guide'
    when 'faq'
      assign label = 'horo.nav.faq' | t | default: 'FAQ'
      assign href = routes.root_url | append: 'pages/faq-horo'
    when 'exchange'
      assign label = 'horo.nav.exchange' | t | default: 'Exchange Policy'
      assign href = routes.root_url | append: 'pages/exchange-policy-horo'
    when 'search'
      assign label = 'horo.shell.search' | t | default: 'Search'
      assign href = routes.search_url
  endcase

  assign is_active = false
  if nav_active_path == href
    assign is_active = true
  elsif route_key == 'home' and nav_active_path == routes.root_url
    assign is_active = true
  elsif route_key != 'home' and href != routes.root_url and nav_active_path contains href
    assign is_active = true
  endif

  if link_style == 'drawer'
    if is_active
      assign link_class = 'horo-nav__drawer-link horo-nav__drawer-link--active'
    else
      assign link_class = 'horo-nav__drawer-link'
    endif
  else
    if is_active
      assign link_class = 'horo-nav__link horo-nav__link--active'
    else
      assign link_class = 'horo-nav__link'
    endif
  endif

  assign label_decoded = label | replace: '&amp;', '&' | replace: '&lt;', '<' | replace: '&gt;', '>' | replace: '&quot;', '"' | replace: '&#39;', "'"
-%}
{%- if href != blank and label != blank -%}
<li{% if link_style == 'primary' and route_key == 'founding_drop' %} class="horo-nav__item horo-nav__item--shop-preview"{% endif %}>
  <a
    href="{{ href }}"
    class="{{ link_class }}"
    {% if is_active %}aria-current="page"{% endif %}
  >
    {{ label_decoded | escape }}
  </a>
  {%- if link_style == 'primary' and route_key == 'founding_drop' -%}
    <div class="horo-nav-preview" aria-label="{{ 'horo.nav.shop_preview_title' | t | default: 'Shop the Drop' }}">
      <div class="horo-nav-preview__inner">
        <div class="horo-nav-preview__header">
          <p>{{ 'horo.nav.shop_preview_title' | t | default: 'Shop the Drop' }}</p>
          <a href="{{ founding_drop_url }}">{{ 'horo.nav.shop_preview_browse_all' | t | default: 'Shop All' }}</a>
        </div>
        <div class="horo-nav-preview__grid">
          {%- liquid
            assign preview_collection = collections['founding-drop']
            if preview_collection == blank
              assign preview_collection = collections.all
            endif
            assign rendered_count = 0
          -%}
          {%- if preview_collection != blank and preview_collection.products_count > 0 -%}
            {%- for product in preview_collection.products limit: 3 -%}
              {%- assign rendered_count = rendered_count | plus: 1 -%}
              {%- assign preview_image = product.featured_media.preview_image | default: product.featured_image -%}
              <a href="{{ product.url }}" class="horo-nav-preview__card">
                <span class="horo-nav-preview__image">
                  {%- if preview_image != blank -%}
                    {{
                      preview_image
                      | image_url: width: 360
                      | image_tag:
                        loading: 'lazy',
                        widths: '180, 240, 360',
                        sizes: '120px',
                        alt: product.title
                    }}
                  {%- else -%}
                    <span class="horo-nav-preview__placeholder">{{ 'horo.nav.product_image_placeholder' | t | default: 'Product image' }}</span>
                  {%- endif -%}
                </span>
                <span class="horo-nav-preview__title">{{ product.title | escape }}</span>
              </a>
            {%- endfor -%}
          {%- endif -%}
          {%- if rendered_count == 0 -%}
            <a href="{{ founding_drop_url }}" class="horo-nav-preview__card">
              <span class="horo-nav-preview__image">
                <span class="horo-nav-preview__placeholder">{{ 'horo.nav.product_image_placeholder' | t | default: 'Product image' }}</span>
              </span>
              <span class="horo-nav-preview__title">{{ 'horo.nav.shop_preview_browse_all' | t | default: 'Shop All' }}</span>
            </a>
            <a href="{{ routes.root_url }}#shop-by-meaning" class="horo-nav-preview__card">
              <span class="horo-nav-preview__image">
                <span class="horo-nav-preview__placeholder">{{ 'horo.nav.product_image_placeholder' | t | default: 'Product image' }}</span>
              </span>
              <span class="horo-nav-preview__title">{{ 'horo.nav.shop_by_feeling' | t | default: 'Shop by Feeling' }}</span>
            </a>
            <a href="{{ routes.root_url }}pages/gifts-hub" class="horo-nav-preview__card">
              <span class="horo-nav-preview__image">
                <span class="horo-nav-preview__placeholder">{{ 'horo.nav.product_image_placeholder' | t | default: 'Product image' }}</span>
              </span>
              <span class="horo-nav-preview__title">{{ 'horo.nav.gifts' | t | default: 'Gifts' }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</li>
{%- endif -%}
