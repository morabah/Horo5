{{ 'component-horo-sticky-mobile-atc.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  HORO Sticky Mobile Add-to-Cart.
  Renders a sticky bar at the bottom of product pages on mobile.

  Accepts:
  - product: {Object} Product Liquid object (required)
  - section_id: {String} Section ID (optional)

  Include in product template or main-product section.
{%- endcomment -%}

{%- if product and product != empty -%}
  {%- liquid
    assign sticky_whatsapp_base_url = product.metafields.custom.whatsapp_help_url.value | default: settings.horo_whatsapp_support_url
    assign sticky_whatsapp_url = blank
    if sticky_whatsapp_base_url != blank
      assign sticky_whatsapp_message = 'Hi HORO team, I need help choosing a size for ' | append: product.title
      assign sticky_whatsapp_message_encoded = sticky_whatsapp_message | url_encode
      if sticky_whatsapp_base_url contains 'text='
        assign sticky_whatsapp_url = sticky_whatsapp_base_url
      elsif sticky_whatsapp_base_url contains '?'
        assign sticky_whatsapp_url = sticky_whatsapp_base_url | append: '&text=' | append: sticky_whatsapp_message_encoded
      else
        assign sticky_whatsapp_url = sticky_whatsapp_base_url | append: '?text=' | append: sticky_whatsapp_message_encoded
      endif
    endif
  -%}
  <div
    class="horo-sticky-mobile-atc"
    data-horo-sticky-mobile-atc
    data-product-id="{{ product.id }}"
    hidden
  >
    <div class="horo-sticky-mobile-atc__info">
      <p class="horo-sticky-mobile-atc__title">{{ product.title | escape }}</p>
      <p class="horo-sticky-mobile-atc__variant-price" aria-live="polite">
        {%- if product.selected_or_first_available_variant -%}
          {{ product.selected_or_first_available_variant.price | money }}
        {%- endif -%}
      </p>
    </div>
    {%- if sticky_whatsapp_url != blank -%}
      <a
        href="{{- sticky_whatsapp_url -}}"
        class="horo-sticky-mobile-atc__wa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Get size help on WhatsApp"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
          <path fill="currentColor" d="M17.5 14.4c-.3-.1-1.8-.9-2-.9-.3-.1-.5-.1-.7.1-.2.3-.8.9-.9 1.1-.2.2-.3.2-.6.1-1.8-.9-3-1.9-3.8-3.8-.1-.3-.1-.4.1-.6.1-.1.3-.3.4-.5.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5-.1-.1-.7-1.6-.9-2.2-.2-.5-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.2-.3-.3-.6-.4ZM12 2a10 10 0 0 0-8.5 15.3L2 22l4.8-1.5A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-2.9.9 1-2.8-.2-.3A8.2 8.2 0 1 1 12 20.2Z"/>
        </svg>
      </a>
    {%- endif -%}
    <button
      type="button"
      class="horo-sticky-mobile-atc__btn button"
      data-horo-sticky-atc-btn
      {%- if product.selected_or_first_available_variant.available == false %} disabled{% endif -%}
    >
      {%- if product.selected_or_first_available_variant.available -%}
        {{ 'products.product.add_to_cart' | t }}
      {%- else -%}
        {{ 'products.product.sold_out' | t }}
      {%- endif -%}
    </button>
  </div>

  {%- comment -%} Embed product variant data for JS sync {%- endcomment -%}
  <script type="application/json" data-horo-sticky-atc-variants>
    [{%- for variant in product.variants -%}
      { "id": {{ variant.id }}, "available": {{ variant.available }}, "price": {{ variant.price }}, "title": {{ variant.title | json }} }{%- unless forloop.last %},{% endunless -%}
    {%- endfor -%}]
  </script>

  <script src="{{ 'horo-sticky-mobile-atc.js' | asset_url }}" defer></script>
{%- endif -%}
