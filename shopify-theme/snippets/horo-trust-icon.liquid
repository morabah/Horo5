{%- comment -%} Trust bar icons — parity with web-next HomeTrustRibbon (48 viewBox, 34px display). {%- endcomment -%}
{%- liquid
  assign icon_key = icon | default: 'artist'
  case icon_key
    when 'artist', 'artistMade'
      assign icon_key = 'artistMade'
    when 'print', 'printedEgypt'
      assign icon_key = 'printedEgypt'
    when 'cash', 'paymentAtCheckout', 'codAvailable'
      assign icon_key = 'paymentAtCheckout'
    when 'exchange', 'exchange14d'
      assign icon_key = 'exchange14d'
    when 'whatsapp', 'whatsappSupport'
      assign icon_key = 'whatsappSupport'
    when 'fit', 'clearFitDetails'
      assign icon_key = 'clearFitDetails'
  endcase
-%}
<svg class="horo-trust-icon" width="34" height="34" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {%- case icon_key -%}
    {%- when 'artistMade' -%}
      <path d="M20.5 7.5c3.5 3.5 7.3 4.5 12 3.5-.5 5.3 1.6 8.8 6.2 11.4-4.6 2.2-6.3 5.6-5.3 10.6-5.2-.6-8.6 1.2-10.8 5.7-2.3-4.4-5.8-6.1-10.8-5.2.7-5 1-8.4-5.5-10.8 4.6-2.4 6.4-5.9 5.5-11 4.9.8 8.1-.7 8.7-4.2z"/><circle cx="19" cy="19" r="1.7"/><circle cx="29.5" cy="18" r="1.5"/><circle cx="25" cy="29" r="1.8"/>
    {%- when 'printedEgypt' -%}
      <path d="M6 39h36"/><path d="M10 38l10-28 10 28H10z"/><path d="M21 38l9-22 10 22H21z"/><path d="M20 10l8 28"/><path d="M30 16l10 22"/><path d="M15 24h10"/><path d="M28 29h8"/>
    {%- when 'clearFitDetails' -%}
      <path d="M17 12l7-4 7 4 7 2-4 9-5-2v19H19V21l-5 2-4-9 7-2z"/><path d="M20 11c1 2.5 2.3 3.8 4 3.8s3-1.3 4-3.8"/>
    {%- when 'paymentAtCheckout' -%}
      <rect x="8" y="14" width="32" height="22" rx="3"/><path d="M8 21h32"/><path d="M14 30h6"/><path d="M30 30h4"/>
    {%- when 'exchange14d' -%}
      <polyline points="38 12 38 24 26 24"/><path d="M34 31a15 15 0 1 1-3.5-15.6L38 24"/>
    {%- when 'whatsappSupport' -%}
      <path d="M39 23.5a14.5 14.5 0 01-21 13L9 39l2.5-8.4A14.5 14.5 0 1139 23.5z"/><path d="M18.5 17.5c.7-1.1 1.4-1.1 2.2-.2l1.4 2.8c.3.6.2 1.1-.2 1.6l-.7.8c1 1.9 2.5 3.3 4.5 4.3l.8-.8c.5-.5 1-.6 1.6-.3l2.8 1.3c.8.4 1 .9.5 1.7-.7 1.2-1.8 1.8-3.1 1.8-2.2 0-5.2-1.5-7.5-3.8-2.4-2.4-3.9-5.2-3.9-7.4 0-.7.2-1.3.6-1.8z"/>
  {%- endcase -%}
</svg>
