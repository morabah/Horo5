{%- comment -%}
  Launch feeling tiles — Sign Capsule / Mood / Lifestyle (max 3).
  Prioritizes launch slugs; enriches from metaobjects when available.
  Accepts: feeling_limit (number)
{%- endcomment -%}
{%- liquid
  assign limit = feeling_limit | default: 3
  assign launch_slugs = 'zodiac,mood,lifestyle' | split: ','
  assign launch_labels = 'Sign Capsule,Mood,Lifestyle' | split: ','
  assign surfaces = '#f8eaea,#f4ede5,#edf1ea' | split: ','
  assign sorted_feelings = shop.metaobjects.feeling.values | sort: 'sort_order'
  assign tiles_shown = 0
-%}

<ul class="home-feeling-pastel-grid" role="list">
  {%- for slug in launch_slugs -%}
    {%- if tiles_shown >= limit -%}
      {%- break -%}
    {%- endif -%}

    {%- liquid
      assign label = launch_labels[forloop.index0]
      assign surface_index = tiles_shown | modulo: 3
      assign surface_color = surfaces[surface_index]
      assign card_url = '/collections/founding-drop'
      assign feeling = nil
      assign use_metaobject = false

      for candidate in sorted_feelings
        assign candidate_handle = candidate.handle | default: candidate.slug | default: '' | downcase
        if candidate_handle == slug and candidate.active != false
          assign feeling = candidate
          break
        endif
      endfor

      if feeling != blank
        assign feeling_collection = feeling.collection.value
        if feeling_collection == blank
          assign coll_handle = 'feeling-' | append: slug
          assign feeling_collection = collections[coll_handle]
        endif
        assign product_count = 0
        if feeling_collection != blank
          assign product_count = feeling_collection.products_count
        endif
        if product_count > 0
          assign use_metaobject = true
        endif
      endif

      if slug == 'zodiac'
        assign zodiac_collection = collections['zodiac']
        if zodiac_collection != blank
          assign card_url = zodiac_collection.url
        else
          assign feeling_zodiac = collections['feeling-zodiac']
          if feeling_zodiac != blank
            assign card_url = feeling_zodiac.url
          endif
        endif
      elsif slug == 'mood' or slug == 'lifestyle'
        assign mood_lifestyle = collections['mood-lifestyle']
        if mood_lifestyle != blank
          assign card_url = mood_lifestyle.url
        endif
      endif
    -%}

    {%- if use_metaobject -%}
      {%- render 'feeling-card-pastel',
        card: feeling,
        tile_index: tiles_shown,
        override_label: label,
        override_url: card_url,
        override_icon_slug: slug
      -%}
    {%- else -%}
      <li class="home-feeling-pastel-grid__item" role="listitem">
        <a
          href="{{ card_url }}"
          class="home-feeling-pastel-tile"
          style="background-color: {{ surface_color }};"
          aria-label="{{ label | escape }}"
        >
          {% render 'feeling-tile-icon', slug: slug %}
          <span class="home-feeling-pastel-tile__label">{{ label | escape }}</span>
        </a>
      </li>
    {%- endif -%}

    {%- assign tiles_shown = tiles_shown | plus: 1 -%}
  {%- endfor -%}
</ul>
