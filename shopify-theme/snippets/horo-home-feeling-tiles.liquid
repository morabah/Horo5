{%- comment -%}
  Pastel feeling tiles — max 5, sort_order, only feelings with products in collection.
  Fills any missing slots with the same default tiles used by web-next fixtures.
  Accepts: feeling_limit (number)
{%- endcomment -%}
{%- liquid
  assign limit = feeling_limit | default: 5
  assign sorted_feelings = shop.metaobjects.feeling.values | sort: 'sort_order'
  assign tiles_shown = 0
  assign shown_handles = '|'
  assign require_products = true
  assign fallback_slugs = 'mood,zodiac,trends,career,fiction' | split: ','
  assign fallback_labels = 'Mood,Zodiac,Trends,Career,Fiction' | split: ','
  assign surfaces = '#f4ede5,#f8eaea,#edf1ea,#eeebf5,#f7ebe4' | split: ','
-%}

<ul class="home-feeling-pastel-grid" role="list">
  {%- for feeling in sorted_feelings -%}
    {%- if tiles_shown >= limit -%}
      {%- break -%}
    {%- endif -%}
    {%- if feeling.active != false -%}
      {%- liquid
        assign feeling_handle = feeling.handle | default: feeling.slug | default: '' | downcase
        assign feeling_collection = feeling.collection.value
        if feeling_collection == blank and feeling_handle != blank
          assign coll_handle = 'feeling-' | append: feeling_handle
          assign feeling_collection = collections[coll_handle]
        endif
        assign product_count = 0
        if feeling_collection != blank
          assign product_count = feeling_collection.products_count
        endif
      -%}
      {%- if require_products == false or product_count > 0 -%}
        {%- render 'feeling-card-pastel', card: feeling, tile_index: tiles_shown -%}
        {%- assign shown_handles = shown_handles | append: feeling_handle | append: '|' -%}
        {%- assign tiles_shown = tiles_shown | plus: 1 -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}

  {%- if tiles_shown < limit -%}
    {%- for slug in fallback_slugs -%}
      {%- if tiles_shown >= limit -%}
        {%- break -%}
      {%- endif -%}
      {%- assign shown_marker = slug | prepend: '|' | append: '|' -%}
      {%- unless shown_handles contains shown_marker -%}
        {%- assign label = fallback_labels[forloop.index0] -%}
        {%- assign surface_index = tiles_shown | modulo: 5 -%}
        {%- assign surface_color = surfaces[surface_index] -%}
        {%- assign card_url = '/pages/feelings' -%}
        {%- assign coll_handle = 'feeling-' | append: slug -%}
        {%- assign feeling_collection = collections[coll_handle] -%}
        {%- if feeling_collection != blank -%}
          {%- assign card_url = feeling_collection.url -%}
        {%- endif -%}
        <li class="home-feeling-pastel-grid__item" role="listitem">
          <a
            href="{{ card_url }}"
            class="home-feeling-pastel-tile"
            style="background-color: {{ surface_color }};"
            aria-label="{{ label | escape }}"
          >
            {% render 'feeling-tile-icon', slug: slug %}
            <span class="home-feeling-pastel-tile__label">{{ label | escape }}</span>
          </a>
        </li>
        {%- assign tiles_shown = tiles_shown | plus: 1 -%}
      {%- endunless -%}
    {%- endfor -%}
  {%- endif -%}
</ul>
