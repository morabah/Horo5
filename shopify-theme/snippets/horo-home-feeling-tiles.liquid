{%- comment -%}
  Launch feeling tiles — Mood / Lifestyle / Career / Zodiac.
  Accepts: feeling_limit (number)
{%- endcomment -%}
{%- liquid
  assign limit = feeling_limit | default: 4
  assign launch_slugs = 'mood,lifestyle,career,zodiac' | split: ','
  assign launch_labels = 'Mood,Lifestyle,Career,Zodiac Signs' | split: ','
  assign launch_subtitles = 'Feelings you wear,Daily pieces,Work identity,Personality-inspired designs' | split: ','
  assign launch_image_assets = 'horo-editorial-calm-inside.png,horo-editorial-artwork-detail.png,horo-founding-drop-campaign.png,horo-our-story.png' | split: ','
  assign surfaces = '#f8eaea,#f4ede5,#edf1ea,#f5eef3' | split: ','
  assign sorted_feelings = shop.metaobjects.feeling.values | sort: 'sort_order'
  assign tiles_shown = 0
-%}

<ul class="home-feeling-pastel-grid home-feeling-pastel-grid--meaning" role="list">
  {%- for slug in launch_slugs -%}
    {%- if tiles_shown >= limit -%}
      {%- break -%}
    {%- endif -%}

    {%- liquid
      assign label = launch_labels[forloop.index0]
      assign subtitle = launch_subtitles[forloop.index0]
      assign image_asset = launch_image_assets[forloop.index0]
      assign surface_index = tiles_shown | modulo: 4
      assign surface_color = surfaces[surface_index]
      assign card_url = routes.all_products_collection_url
      assign feeling = nil
      assign use_metaobject = false

      for candidate in sorted_feelings
        assign candidate_handle = candidate.handle | default: candidate.slug | default: '' | downcase
        if candidate_handle == slug and candidate.active != false
          assign feeling = candidate
          break
        endif
      endfor

      if feeling != blank
        assign feeling_collection = feeling.collection.value
        if feeling_collection == blank
          assign coll_handle = 'feeling-' | append: slug
          assign feeling_collection = collections[coll_handle]
        endif
        assign product_count = 0
        if feeling_collection != blank
          assign product_count = feeling_collection.products_count
        endif
        if product_count > 0
          assign use_metaobject = true
        endif
      endif

      if slug == 'zodiac'
        assign zodiac_collection = collections['zodiac']
        if zodiac_collection != blank
          assign card_url = zodiac_collection.url
        else
          assign feeling_zodiac = collections['feeling-zodiac']
          if feeling_zodiac != blank
            assign card_url = feeling_zodiac.url
          endif
        endif
      elsif slug == 'mood' or slug == 'lifestyle'
        assign mood_lifestyle = collections['mood-lifestyle']
        if mood_lifestyle != blank
          assign card_url = mood_lifestyle.url
        endif
      elsif slug == 'career'
        assign career_collection = collections['career']
        if career_collection != blank
          assign card_url = career_collection.url
        else
          assign feeling_career = collections['feeling-career']
          if feeling_career != blank
            assign card_url = feeling_career.url
          endif
        endif
      endif
    -%}

    {%- if use_metaobject -%}
      {%- render 'feeling-card-pastel',
        card: feeling,
        tile_index: tiles_shown,
        override_label: label,
        override_subtitle: subtitle,
        override_url: card_url,
        override_icon_slug: slug,
        override_image_asset: image_asset
      -%}
    {%- else -%}
      <li class="home-feeling-pastel-grid__item" role="listitem">
        <a
          href="{{ card_url }}"
          class="home-feeling-pastel-tile home-feeling-tile--editorial"
          style="background-image: url({{ image_asset | asset_url }});"
          aria-label="{{ label | escape }}"
          data-horo-home-event="category_card_click"
          data-horo-home-props='{"category":{{ slug | json }}}'
        >
          <span class="home-feeling-pastel-tile__label">{{ label | escape }}</span>
          {%- if subtitle != blank -%}
            <span class="home-feeling-pastel-tile__subtitle">{{ subtitle | escape }}</span>
          {%- endif -%}
        </a>
      </li>
    {%- endif -%}

    {%- assign tiles_shown = tiles_shown | plus: 1 -%}
  {%- endfor -%}
</ul>
