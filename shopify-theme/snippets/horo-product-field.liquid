{%- comment -%}
  Scalar product field resolver (HORO data contract).
  Accepts: product (required), field (required string key).
  Outputs plain text only — no HTML. Blank when unset.

  Allowed keys only (see docs/HORO_DATA_CONTRACT.md §2.8).
  Do NOT use for rich text, lists, metaobject refs, product lists, or JSON.
{%- endcomment -%}
{%- liquid
  assign field_key = field | default: '' | strip
  assign output = ''

  case field_key
    when 'fit_label'
      assign output = product.metafields.custom.fit_note.value | default: product.metafields.custom.fit_label.value | default: product.metafields.custom.size_fit_note.value
    when 'buyer_route'
      assign output = product.metafields.custom.buyer_route.value
    when 'primary_audience'
      assign output = product.metafields.custom.primary_audience.value
    when 'promo_label'
      assign output = product.metafields.custom.promo_label.value
    when 'low_stock_message'
      assign output = product.metafields.custom.low_stock_message.value
    when 'feeling_title'
      assign feeling_obj = product.metafields.custom.feeling.value
      if feeling_obj != blank
        assign output = feeling_obj.title | default: feeling_obj.name | default: feeling_obj.display_name
      endif
    when 'feeling_slug'
      assign feeling_obj = product.metafields.custom.feeling.value
      if feeling_obj != blank
        assign output = feeling_obj.slug | default: feeling_obj.handle
      endif
    when 'subfeeling_title'
      assign sub_obj = product.metafields.custom.subfeeling.value
      if sub_obj != blank
        assign output = sub_obj.title | default: sub_obj.name | default: sub_obj.display_name
      endif
    when 'subfeeling_slug'
      assign sub_obj = product.metafields.custom.subfeeling.value
      if sub_obj != blank
        assign output = sub_obj.slug | default: sub_obj.handle
      endif
    when 'artist_name'
      assign artist_obj = product.metafields.custom.artist.value
      if artist_obj != blank
        assign output = artist_obj.name | default: artist_obj.display_name
      endif
  endcase
-%}{{- output -}}
