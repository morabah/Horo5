{%- comment -%}
  HORO Nav Links — single source of truth for primary + drawer navigation.
  Mirrors web-next NAV_PRIMARY_ROUTE_KEYS / NAV_DRAWER_ROUTE_KEYS.
{%- endcomment -%}

{%- liquid
  assign nav_active_path = active_path | default: request.path

  if context == 'primary'
    if menu != blank and menu.links.size > 0
      assign nav_items = menu.links
    else
      assign nav_items = 'fallback'
    endif
  else
    if drawer_menu != blank and drawer_menu.links.size > 0
      assign nav_items = drawer_menu.links
    else
      assign nav_items = 'fallback'
    endif
  endif
-%}

{%- if context == 'primary' -%}
  <nav class="horo-nav__primary" aria-label="{{ 'horo.shell.primary_navigation' | t | default: 'Primary navigation' }}">
    <ul class="horo-nav__list" role="list">
      {%- if nav_items == 'fallback' -%}
        {%- assign primary_route_keys = 'founding_drop,shop_by_meaning,gifts,about,size_guide' | split: ',' -%}
        {%- for route_key in primary_route_keys -%}
          {% render 'horo-nav-route-link', route_key: route_key, nav_active_path: nav_active_path, link_style: 'primary' %}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown_keys = '|' -%}
        {%- for link in nav_items -%}
          {%- liquid
            assign link_url_lower = link.url | downcase
            assign link_route_key = ''

            if link_url_lower contains 'founding-drop' or link_url_lower contains '/products'
              assign link_route_key = 'founding_drop'
            elsif link_url_lower contains 'gifts-hub' or link_url_lower contains '/pages/gifts'
              assign link_route_key = 'gifts'
            elsif link_url_lower contains 'feelings-hub' or link_url_lower contains '#shop-by-meaning'
              assign link_route_key = 'shop_by_meaning'
            elsif link_url_lower contains 'about-horo' or link_url_lower contains '/pages/about'
              assign link_route_key = 'about'
            elsif link_url_lower contains 'size-guide'
              assign link_route_key = 'size_guide'
            endif
          -%}
          {%- if link_route_key != blank -%}
            {%- assign shown_keys = shown_keys | append: link_route_key | append: '|' -%}
          {%- endif -%}
          {%- assign is_active = false -%}
          {%- if nav_active_path == link.url or link.child_active or nav_active_path contains link.url and link.url != '/' -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ link.url }}"
              class="horo-nav__link{% if is_active %} horo-nav__link--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
        {%- assign primary_route_keys = 'founding_drop,shop_by_meaning,gifts,about,size_guide' | split: ',' -%}
        {%- for route_key in primary_route_keys -%}
          {%- assign route_marker = route_key | prepend: '|' | append: '|' -%}
          {%- unless shown_keys contains route_marker -%}
            {% render 'horo-nav-route-link', route_key: route_key, nav_active_path: nav_active_path, link_style: 'primary' %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
{%- elsif context == 'drawer' -%}
  <nav class="horo-nav__drawer-nav" aria-label="{{ 'horo.shell.drawer_navigation' | t | default: 'Menu' }}">
    <ul class="horo-nav__drawer-list" role="list">
      {%- if nav_items == 'fallback' -%}
        {%- assign drawer_route_keys = 'home,founding_drop,shop_by_meaning,gifts,zodiac,career,about,size_guide,faq,exchange,search' | split: ',' -%}
        {%- for route_key in drawer_route_keys -%}
          {% render 'horo-nav-route-link', route_key: route_key, nav_active_path: nav_active_path, link_style: 'drawer' %}
        {%- endfor -%}
      {%- else -%}
        {%- assign shown_keys = '|' -%}
        {%- for link in nav_items -%}
          {%- liquid
            assign link_url_lower = link.url | downcase
            assign link_route_key = ''

            if link.url == routes.root_url or link_url_lower == routes.root_url or link_url_lower == '/'
              assign link_route_key = 'home'
            elsif link_url_lower contains 'founding-drop' or link_url_lower contains '/products'
              assign link_route_key = 'founding_drop'
            elsif link_url_lower contains 'gifts-hub' or link_url_lower contains '/pages/gifts'
              assign link_route_key = 'gifts'
            elsif link_url_lower contains 'feelings-hub' or link_url_lower contains '#shop-by-meaning'
              assign link_route_key = 'shop_by_meaning'
            elsif link_url_lower contains '/collections/zodiac' or link_url_lower contains 'zodiac'
              assign link_route_key = 'zodiac'
            elsif link_url_lower contains '/collections/career' or link_url_lower contains 'career'
              assign link_route_key = 'career'
            elsif link_url_lower contains 'about-horo' or link_url_lower contains '/pages/about'
              assign link_route_key = 'about'
            elsif link_url_lower contains 'size-guide'
              assign link_route_key = 'size_guide'
            elsif link_url_lower contains 'faq-horo' or link_url_lower contains '/pages/faq'
              assign link_route_key = 'faq'
            elsif link_url_lower contains 'exchange-policy'
              assign link_route_key = 'exchange'
            elsif link_url_lower contains '/search' or link.url == routes.search_url
              assign link_route_key = 'search'
            endif
          -%}
          {%- if link_route_key != blank -%}
            {%- assign shown_keys = shown_keys | append: link_route_key | append: '|' -%}
          {%- endif -%}
          {%- assign is_active = false -%}
          {%- if nav_active_path == link.url or link.child_active or nav_active_path contains link.url and link.url != '/' -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ link.url }}"
              class="horo-nav__drawer-link{% if is_active %} horo-nav__drawer-link--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{ link.title | escape }}
            </a>
          </li>
        {%- endfor -%}
        {%- assign drawer_route_keys = 'home,founding_drop,shop_by_meaning,gifts,zodiac,career,about,size_guide,faq,exchange,search' | split: ',' -%}
        {%- for route_key in drawer_route_keys -%}
          {%- assign route_marker = route_key | prepend: '|' | append: '|' -%}
          {%- unless shown_keys contains route_marker -%}
            {% render 'horo-nav-route-link', route_key: route_key, nav_active_path: nav_active_path, link_style: 'drawer' %}
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
