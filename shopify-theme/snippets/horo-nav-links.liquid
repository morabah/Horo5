{%- comment -%}
  HORO Nav Links — single source of truth for primary + drawer navigation.

  Reads from a Shopify navigation link list when present; otherwise falls back
  to a hard-coded HORO route map that mirrors NAV_ROUTE from web-next.

  Usage:
    {% render 'horo-nav-links', context: 'primary', active_path: request.path %}
    {% render 'horo-nav-links', context: 'drawer', active_path: request.path %}

  Params:
    - context  : 'primary' | 'drawer'
    - menu     : link_list (optional — Shopify nav for primary)
    - drawer_menu : link_list (optional — Shopify nav for drawer)
    - active_path : string (request.path)
{%- endcomment -%}

{%- liquid
  assign nav_active_path = active_path | default: request.path
  assign about_url = routes.root_url | append: 'pages/about-horo'

  if context == 'primary'
    if menu != blank and menu.links.size > 0
      assign nav_items = menu.links
    else
      assign nav_items = 'fallback'
    endif
  else
    if drawer_menu != blank and drawer_menu.links.size > 0
      assign nav_items = drawer_menu.links
    else
      assign nav_items = 'fallback'
    endif
  endif
-%}

{%- if context == 'primary' -%}
  <nav class="horo-nav__primary" aria-label="{{ 'horo.shell.primary_navigation' | t | default: 'Primary navigation' }}">
    <ul class="horo-nav__list" role="list">
      {%- if nav_items == 'fallback' -%}
        {%- assign primary_route_keys = 'founding_drop,about,size_guide' | split: ',' -%}
        {%- for route_key in primary_route_keys -%}
          {%- case route_key -%}
            {%- when 'founding_drop' -%}
              {%- assign label = 'horo.nav.founding_drop' | t | default: 'Founding Drop' -%}
              {%- assign href = '/collections/founding-drop' -%}
            {%- when 'about' -%}
              {%- assign label = 'horo.nav.our_story' | t | default: 'Our Story' -%}
              {%- assign href = about_url -%}
            {%- when 'size_guide' -%}
              {%- assign label = 'horo.nav.size_help' | t | default: 'Size & Help' -%}
              {%- assign href = routes.root_url | append: 'pages/size-guide' -%}
          {%- endcase -%}
          {%- assign is_active = false -%}
          {%- if nav_active_path == href or nav_active_path contains href and href != routes.root_url -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ href }}"
              class="horo-nav__link{% if is_active %} horo-nav__link--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{ label | escape }}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for link in nav_items -%}
          {%- liquid
            assign skip_link = false
            assign link_url_lower = link.url | downcase
            assign link_title_lower = link.title | downcase
            if link_url_lower contains '/pages/gifts-hub' or link_url_lower contains '/pages/occasions'
              assign skip_link = true
            endif
            if link_url_lower contains '/pages/feelings'
              assign skip_link = true
            endif
            if link_url_lower contains '/feelings/zodiac' or link_url_lower contains '/collections/zodiac'
              assign skip_link = true
            endif
            if link_title_lower == 'zodiac' or link_title_lower == 'shop by feeling'
              assign skip_link = true
            endif
          -%}
          {%- unless skip_link -%}
            {%- assign is_active = false -%}
            {%- if nav_active_path == link.url or link.child_active or nav_active_path contains link.url and link.url != '/' -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            <li>
              <a
                href="{{ link.url }}"
                class="horo-nav__link{% if is_active %} horo-nav__link--active{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
{%- elsif context == 'drawer' -%}
  <nav class="horo-nav__drawer-nav" aria-label="{{ 'horo.shell.drawer_navigation' | t | default: 'Menu' }}">
    <ul class="horo-nav__drawer-list" role="list">
      {%- if nav_items == 'fallback' -%}
        {%- assign drawer_route_keys = 'home,founding_drop,about,size_guide,search' | split: ',' -%}
        {%- for route_key in drawer_route_keys -%}
          {%- case route_key -%}
            {%- when 'home' -%}
              {%- assign label = 'horo.shell.home' | t | default: 'Home' -%}
              {%- assign href = routes.root_url -%}
            {%- when 'founding_drop' -%}
              {%- assign label = 'horo.nav.founding_drop' | t | default: 'Founding Drop' -%}
              {%- assign href = '/collections/founding-drop' -%}
            {%- when 'about' -%}
              {%- assign label = 'horo.nav.our_story' | t | default: 'Our Story' -%}
              {%- assign href = about_url -%}
            {%- when 'size_guide' -%}
              {%- assign label = 'horo.nav.size_help' | t | default: 'Size & Help' -%}
              {%- assign href = routes.root_url | append: 'pages/size-guide' -%}
            {%- when 'search' -%}
              {%- assign label = 'horo.shell.search' | t | default: 'Search' -%}
              {%- assign href = routes.search_url -%}
          {%- endcase -%}
          {%- assign is_active = false -%}
          {%- if nav_active_path == href or route_key != 'home' and nav_active_path contains href and href != routes.root_url -%}
            {%- assign is_active = true -%}
          {%- endif -%}
          <li>
            <a
              href="{{ href }}"
              class="horo-nav__drawer-link{% if is_active %} horo-nav__drawer-link--active{% endif %}"
              {% if is_active %}aria-current="page"{% endif %}
            >
              {{ label | escape }}
            </a>
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for link in nav_items -%}
          {%- liquid
            assign skip_link = false
            assign link_url_lower = link.url | downcase
            assign link_title_lower = link.title | downcase
            if link_url_lower contains '/pages/gifts-hub' or link_url_lower contains '/pages/occasions'
              assign skip_link = true
            endif
            if link_url_lower contains '/pages/feelings'
              assign skip_link = true
            endif
            if link_url_lower contains '/feelings/zodiac' or link_url_lower contains '/collections/zodiac'
              assign skip_link = true
            endif
            if link_title_lower == 'zodiac' or link_title_lower == 'shop by feeling'
              assign skip_link = true
            endif
          -%}
          {%- unless skip_link -%}
            {%- assign is_active = false -%}
            {%- if nav_active_path == link.url or link.child_active or nav_active_path contains link.url and link.url != '/' -%}
              {%- assign is_active = true -%}
            {%- endif -%}
            <li>
              <a
                href="{{ link.url }}"
                class="horo-nav__drawer-link{% if is_active %} horo-nav__drawer-link--active{% endif %}"
                {% if is_active %}aria-current="page"{% endif %}
              >
                {{ link.title | escape }}
              </a>
            </li>
          {%- endunless -%}
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}
