{%- liquid
  assign gift_product = gift_wrap_product
  assign gift_variant = gift_wrap_variant
  assign gift_in_cart = in_cart | default: false
  assign gift_label = label | default: 'Add gift wrap'
  assign gift_price_hint = price_hint | default: ''
  assign gift_section_id = section_id
  assign gift_context = context | default: 'product'
  assign gift_show_preview = show_preview | default: true
-%}

{%- if gift_product != blank and gift_variant != blank -%}
  <div class="gift-wrap__card">
    {%- if gift_show_preview and gift_product.featured_image -%}
      <div class="gift-wrap__preview">
        <img
          src="{{ gift_product.featured_image | image_url: width: 120 }}"
          alt="{{ gift_product.featured_image.alt | escape }}"
          loading="lazy"
          width="60"
          height="60"
        >
      </div>
    {%- else -%}
      <div class="gift-wrap__icon" aria-hidden="true">
        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12v10H4V12"/><path d="M2 7h20v5H2z"/><path d="M12 22V7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
      </div>
    {%- endif -%}
    <div class="gift-wrap__content">
      <p class="gift-wrap__title">{{ gift_label | escape }}</p>
      {%- if gift_price_hint != blank -%}
        <p class="gift-wrap__hint">{{ gift_price_hint | escape }}</p>
      {%- elsif gift_variant.price != blank -%}
        <p class="gift-wrap__hint">{{ gift_variant.price | money }}</p>
      {%- endif -%}
      {%- if gift_context == 'product' -%}
        <p class="gift-wrap__copy">{{ 'horo.gift_wrap.description' | t | escape }}</p>
      {%- endif -%}
    </div>
    <div class="gift-wrap__actions">
      {%- if gift_context == 'cart' and gift_in_cart -%}
        <label class="gift-wrap__toggle">
          <input
            type="checkbox"
            class="gift-wrap__checkbox"
            data-gift-wrap-remove
            data-variant-id="{{ gift_variant.id }}"
            data-section-id="{{ gift_section_id }}"
            checked
            aria-label="{{ 'horo.gift_wrap.remove' | t | escape }}"
          >
          <span class="gift-wrap__toggle-label">{{ 'horo.gift_wrap.already_added' | t | escape }}</span>
        </label>
      {%- elsif gift_context == 'cart' -%}
        <label class="gift-wrap__toggle">
          <input
            type="checkbox"
            class="gift-wrap__checkbox"
            data-gift-wrap-add
            data-variant-id="{{ gift_variant.id }}"
            data-section-id="{{ gift_section_id }}"
            aria-label="{{ gift_label | escape }}"
          >
          <span class="gift-wrap__toggle-label">{{ gift_label | escape }}</span>
        </label>
      {%- elsif gift_in_cart -%}
        <div class="gift-wrap__done">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
          {{ 'horo.gift_wrap.already_added' | t | escape }}
        </div>
      {%- else -%}
        <button
          type="button"
          class="gift-wrap__btn"
          data-gift-wrap-add
          data-variant-id="{{ gift_variant.id }}"
          data-section-id="{{ gift_section_id }}"
          aria-label="{{ gift_label | escape }}"
        >
          {{ gift_label | escape }}
        </button>
      {%- endif -%}
      <p
        class="gift-wrap__status"
        data-gift-wrap-status="{{ gift_section_id }}"
        aria-live="polite"
        aria-atomic="true"
      ></p>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="gift-wrap__placeholder">
    <p>Select a gift wrap product in theme settings to enable this upsell.</p>
  </div>
{%- endif -%}
