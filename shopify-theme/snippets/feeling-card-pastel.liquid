{%- liquid
  assign feeling = card
  assign feeling_handle = feeling.handle | default: feeling.slug | default: '' | downcase
  assign feeling_label = override_label | default: feeling.title | default: feeling.name | default: feeling.display_name | default: 'Feeling'
  assign feeling_subtitle = override_subtitle | default: ''
  assign feeling_subtitle = override_subtitle | default: ''
  assign card_url = override_url | default: feeling.collection_url | default: feeling.collection.value.url
  if card_url == blank and feeling_handle != blank
    assign card_url = routes.collections_url | append: '/feeling-' | append: feeling_handle
  endif
  assign icon_slug = override_icon_slug | default: feeling_handle
  assign surfaces = '#f4ede5,#f8eaea,#edf1ea,#eeebf5,#f7ebe4' | split: ','
  assign surface_index = tile_index | modulo: 5
  assign surface_color = surfaces[surface_index]
  assign image_asset = override_image_asset | default: ''
-%}

<li class="home-feeling-pastel-grid__item" role="listitem">
  <a
    href="{{ card_url }}"
    class="home-feeling-pastel-tile{% if image_asset != blank %} home-feeling-tile--editorial{% endif %}"
    style="{% if image_asset != blank %}background-image: url({{ image_asset | asset_url }});{% else %}background-color: {{ surface_color }};{% endif %}"
    aria-label="{{ feeling_label | escape }}"
    data-horo-home-event="category_card_click"
    data-horo-home-props='{"category":{{ icon_slug | json }}}'
  >
    {%- if image_asset == blank -%}
      {% render 'feeling-tile-icon', slug: icon_slug %}
    {%- endif -%}
    <span class="home-feeling-pastel-tile__label">{{ feeling_label | escape }}</span>
    {%- if feeling_subtitle != blank -%}
      <span class="home-feeling-pastel-tile__subtitle">{{ feeling_subtitle | escape }}</span>
    {%- endif -%}
  </a>
</li>
