{%- comment -%}
  Emits window.HoroCurrentProductData assignment body (valid JSON via | json filter).
  Accepts: product (required)
{%- endcomment -%}
{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign feeling_obj = product.metafields.custom.feeling.value
  assign subfeeling_obj = product.metafields.custom.subfeeling.value
  assign artist_obj = product.metafields.custom.artist.value
  assign occasions_raw = product.metafields.custom.occasions.value
  assign trust_raw = product.metafields.custom.trust_chips.value
  assign works_raw = product.metafields.custom.works_for.value
  assign feels_raw = product.metafields.custom.feels_like.value
  assign pdp_tags_raw = product.metafields.custom.pdp_tag_labels.value
  assign fbt_raw = product.metafields.custom.frequently_bought_with_products.value
  assign complementary_raw = product.metafields.custom.complementary_products.value
  assign cab_raw = product.metafields.custom.customers_also_bought_products.value
  assign pair_raw = product.metafields.custom.pair_with_products.value

  assign feeling_title = ''
  assign feeling_slug = ''
  if feeling_obj != blank
    assign feeling_title = feeling_obj.title | default: feeling_obj.name | default: feeling_obj.display_name
    assign feeling_slug = feeling_obj.slug | default: feeling_obj.handle
  endif

  assign subfeeling_title = ''
  assign subfeeling_slug = ''
  if subfeeling_obj != blank
    assign subfeeling_title = subfeeling_obj.title | default: subfeeling_obj.name | default: subfeeling_obj.display_name
    assign subfeeling_slug = subfeeling_obj.slug | default: subfeeling_obj.handle
  endif

  assign line_slug = subfeeling_slug

  assign artist_name = ''
  if artist_obj != blank
    assign artist_name = artist_obj.name | default: artist_obj.display_name
  endif

  assign fit_label = product.metafields.custom.fit_note.value | default: product.metafields.custom.fit_label.value | default: product.metafields.custom.size_fit_note.value

  assign giftable_val = product.metafields.custom.giftable.value
  assign giftable_bool = false
  if giftable_val == true or giftable_val == 'true'
    assign giftable_bool = true
  endif

  assign occasion_slugs_csv = ''
  assign occasion_labels_csv = ''
  if occasions_raw != blank
    for occasion in occasions_raw
      assign occ_slug = occasion.slug | default: occasion.handle | default: ''
      assign occ_label = occasion.title | default: occasion.name | default: occasion.display_name | default: ''
      if occ_slug != blank
        assign slug_token = '||' | append: occ_slug | append: '||'
        unless occasion_slugs_csv contains slug_token
          if occasion_slugs_csv == blank
            assign occasion_slugs_csv = occ_slug
          else
            assign occasion_slugs_csv = occasion_slugs_csv | append: '||' | append: occ_slug
          endif
        endunless
      endif
      if occ_label != blank
        assign label_token = '||' | append: occ_label | append: '||'
        unless occasion_labels_csv contains label_token
          if occasion_labels_csv == blank
            assign occasion_labels_csv = occ_label
          else
            assign occasion_labels_csv = occasion_labels_csv | append: '||' | append: occ_label
          endif
        endunless
      endif
    endfor
  endif
  assign occasion_slugs = occasion_slugs_csv | split: '||'
  assign occasion_labels = occasion_labels_csv | split: '||'

  assign pdp_tag_labels = '' | split: ','
  if pdp_tags_raw != blank
    assign pdp_tag_labels = pdp_tags_raw
  endif

  assign trust_list = '' | split: ','
  if trust_raw != blank
    assign trust_list = trust_raw
  endif

  assign works_list = '' | split: ','
  if works_raw != blank
    assign works_list = works_raw
  endif

  assign feels_list = '' | split: ','
  if feels_raw != blank
    assign feels_list = feels_raw
  endif

  assign pair_handles = '' | split: ','
  if pair_raw != blank
    assign pair_handles = pair_raw | map: 'handle'
  endif

  assign fbt_handles = '' | split: ','
  if fbt_raw != blank
    assign fbt_handles = fbt_raw | map: 'handle'
  endif

  assign complementary_handles = '' | split: ','
  if complementary_raw != blank
    assign complementary_handles = complementary_raw | map: 'handle'
  endif

  assign cab_handles = '' | split: ','
  if cab_raw != blank
    assign cab_handles = cab_raw | map: 'handle'
  endif

  assign stock_note = product.metafields.custom.stock_note.value | default: product.metafields.custom.low_stock_message.value

  assign promo_show_countdown = product.metafields.custom.promo_show_countdown.value
  if promo_show_countdown == blank
    assign promo_show_countdown_bool = true
  elsif promo_show_countdown == false or promo_show_countdown == 'false'
    assign promo_show_countdown_bool = false
  else
    assign promo_show_countdown_bool = true
  endif

  assign available_sizes = '' | split: '|'
  assign available_sizes_meta = product.metafields.custom.available_sizes.value
  if available_sizes_meta != blank
    assign available_sizes = available_sizes_meta
  else
    assign size_option_position = 0
    for option in product.options
      assign option_name_down = option | downcase
      if option_name_down == 'size'
        assign size_option_position = forloop.index
        break
      endif
    endfor
    if size_option_position > 0
      assign available_sizes_csv = ''
      for variant in product.variants
        unless variant.available
          continue
        endunless
        assign size_val = ''
        if size_option_position == 1
          assign size_val = variant.option1
        elsif size_option_position == 2
          assign size_val = variant.option2
        else
          assign size_val = variant.option3
        endif
        if size_val != blank
          assign size_token = '||' | append: size_val | append: '||'
          unless available_sizes_csv contains size_token
            if available_sizes_csv == blank
              assign available_sizes_csv = size_val
            else
              assign available_sizes_csv = available_sizes_csv | append: '||' | append: size_val
            endif
          endunless
        endif
      endfor
      if available_sizes_csv != blank
        assign available_sizes = available_sizes_csv | split: '||'
      endif
    endif
  endif

  assign garment_colors = '' | split: '|'
  assign garment_colors_meta = product.metafields.custom.garment_colors.value
  if garment_colors_meta != blank
    assign garment_colors = garment_colors_meta
  else
    for option in product.options_with_values
      assign option_name_down = option.name | downcase
      if option_name_down == 'color'
        assign garment_colors = option.values
        break
      endif
    endfor
  endif

  assign inventory_tracked = false
  if variant.inventory_management == 'shopify'
    assign inventory_tracked = true
  endif

  assign inventory_qty = nil
  if inventory_tracked
    assign inventory_qty = variant.inventory_quantity
  endif
-%}
window.HoroCurrentProductHandle = {{ product.handle | json }};
window.HoroCurrencySymbol = {{ cart.currency.symbol | default: '' | json }};
window.HoroCurrentProductData = {
  "id": {{ product.id | json }},
  "title": {{ product.title | json }},
  "handle": {{ product.handle | json }},
  "vendor": {{ product.vendor | json }},
  "price": {{ variant.price | divided_by: 100.0 | json }},
  "compare_at_price": {{ variant.compare_at_price | divided_by: 100.0 | json }},
  "variant_title": {{ variant.title | json }},
  "currency": {{ cart.currency.iso_code | json }},
  "url": {{ product.url | json }},
  "feeling": {{ feeling_title | json }},
  "feelingSlug": {{ feeling_slug | json }},
  "subfeeling": {{ subfeeling_title | json }},
  "subfeelingSlug": {{ subfeeling_slug | json }},
  "lineSlug": {{ line_slug | json }},
  "occasionSlugs": {{ occasion_slugs | json }},
  "occasionLabels": {{ occasion_labels | json }},
  "occasions": {{ occasion_labels | json }},
  "pdpTagLabels": {{ pdp_tag_labels | json }},
  "artist": {{ artist_name | json }},
  "giftable": {{ giftable_bool | json }},
  "fitLabel": {{ fit_label | json }},
  "trustChips": {{ trust_list | json }},
  "worksFor": {{ works_list | json }},
  "feelsLike": {{ feels_list | json }},
  "buyerRoute": {{ product.metafields.custom.buyer_route.value | json }},
  "primaryAudience": {{ product.metafields.custom.primary_audience.value | json }},
  "promoLabel": {{ product.metafields.custom.promo_label.value | json }},
  "promoStartsAt": {{ product.metafields.custom.promo_starts_at.value | json }},
  "promoEndsAt": {{ product.metafields.custom.promo_ends_at.value | json }},
  "promoShowCountdown": {{ promo_show_countdown_bool | json }},
  "merchandisingBadge": {{ product.metafields.custom.merchandising_badge.value | json }},
  "stockNote": {{ stock_note | json }},
  "garmentColors": {{ garment_colors | json }},
  "availableSizes": {{ available_sizes | json }},
  "pairWithProductHandles": {{ pair_handles | json }},
  "frequentlyBoughtWithProductHandles": {{ fbt_handles | json }},
  "complementaryProductHandles": {{ complementary_handles | json }},
  "customersAlsoBoughtProductHandles": {{ cab_handles | json }},
  "selectedVariantId": {{ variant.id | json }},
  "available": {{ variant.available | json }},
  "inventoryTracked": {{ inventory_tracked | json }},
  "inventoryQuantity": {{ inventory_qty | json }},
  "category": {{ feeling_title | json }}
};
