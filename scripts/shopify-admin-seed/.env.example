# HORO Shopify Admin Seeder — Environment Variables
#
# 1. Create a Shopify custom app in your store:
#    Settings → Apps and sales channels → Develop apps → Create an app
# 2. Configure Admin API access scopes:
#    - read_metaobject_definitions
#    - write_metaobject_definitions
#    - read_metafield_definitions
#    - write_metafield_definitions
#    - read_products (optional, for validation)
# 3. Install the app on your store and reveal the Admin API access token.
# 4. Copy this file to .env and paste the token.

SHOPIFY_STORE_DOMAIN=horo-9109.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_API_VERSION=2025-04
