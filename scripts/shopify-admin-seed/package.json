{
  "name": "@horo/shopify-admin-seed",
  "version": "1.0.0",
  "description": "HORO Shopify Admin definitions seeder — metaobjects and metafields",
  "private": true,
  "type": "module",
  "scripts": {
    "seed:definitions": "tsx src/index.ts --apply",
    "seed:definitions:dry": "tsx src/index.ts",
    "seed:definitions:all": "tsx src/index.ts --apply --include-drops",
    "check": "tsx src/index.ts --check",
    "sync:metaobject-fields": "tsx src/sync-metaobject-fields.ts",
    "sync:metaobject-storefront-access": "tsx src/sync-metaobject-storefront-access.ts",
    "verify:launch": "tsx src/verify-launch-custom-data.ts",
    "verify:full": "tsx src/verify-full-admin-checklist.ts",
    "seed:launch-content": "tsx src/seed-launch-content.ts",
    "seed:launch-content:dry": "tsx src/seed-launch-content.ts --dry-run",
    "seed:launch-catalog": "tsx src/seed-launch-catalog.ts",
    "seed:launch-catalog:dry": "tsx src/seed-launch-catalog.ts --dry-run",
    "seed:launch-all": "tsx src/seed-launch-all.ts",
    "seed:launch-all:dry": "tsx src/seed-launch-all.ts --dry-run",
    "patch:theme-local": "tsx src/patch-theme-settings-local.ts",
    "automate:launch": "tsx src/seed-launch-all.ts && npm run patch:theme-local",
    "verify:full-checklist": "tsx src/verify-full-admin-checklist.ts",
    "verify:product-list": "tsx src/verify-user-product-definitions.ts",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "dotenv": "^16.4.5",
    "tsx": "^4.7.1",
    "typescript": "^5.4.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
