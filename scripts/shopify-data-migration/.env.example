# HORO Shopify Data Migration — Environment Variables
#
# Required for all operations:
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2025-04
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional Medusa source:
# MEDUSA_BACKEND_URL=https://your-medusa-backend.com
# MEDUSA_ADMIN_API_TOKEN=medusa-token-here
# MEDUSA_DATABASE_URL=postgres://user:pass@host:5432/medusa

# Optional local JSON input directory (default: ./input):
# MIGRATION_INPUT_DIR=./input

# Optional: allow missing references during migration (not recommended)
# ALLOW_MISSING_REFERENCES=false

# Optional: allow missing images during migration
# ALLOW_MISSING_IMAGES=false
